    "6366.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Buried sessions appear under Session > Buried Sessions. When this setting is enabled, window sizes are restored when attaching to an existing tmux session.\"; ObjectID = \"6366\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Buried sessions appear under Session > Buried Sessions. When this setting is enabled, window sizes are restored when attaching to an existing tmux session."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões ocultas aparecem em Sessão > Sessões ocultas. Quando este ajuste está ativado, os tamanhos das janelas são restaurados ao anexar a uma sessão tmux existente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏的会话显示在“会话 > 隐藏的会话”下。启用此设置后，附加到现有 tmux 会话时会恢复窗口大小。"
          }
        }
      }
    },
