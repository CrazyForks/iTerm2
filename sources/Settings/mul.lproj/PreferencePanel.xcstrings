    "KWy-PJ-O0E.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Brightens text for \\\"normal\\\" ANSI colors. Does not affect \\\"bright\\\" ANSI colors, 8-bit colors, 24-bit colors, or the default foreground color.\"; ObjectID = \"KWy-PJ-O0E\";",
