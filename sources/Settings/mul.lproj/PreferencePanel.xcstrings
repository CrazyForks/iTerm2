    "GVg-ue-xgc.ibShadowedToolTip" : {
      "comment" : "Class = \"NSView\"; ibShadowedToolTip = \"This visualization shows the hue and chroma of the ANSI colors, excluding black and white. Hue is given by the angle and Chroma by the distance from center.\"; ObjectID = \"GVg-ue-xgc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This visualization shows the hue and chroma of the ANSI colors, excluding black and white. Hue is given by the angle and Chroma by the distance from center."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta visualização mostra o matiz e a croma das cores ANSI, excluindo preto e branco. O matiz é dado pelo ângulo e a croma pela distância do centro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此可视化显示 ANSI 颜色的色相和色度（不包括黑色和白色）。色相由角度表示，色度由与中心的距离表示。"
          }
        }
      }
    },
