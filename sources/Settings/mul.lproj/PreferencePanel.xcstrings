    "vhk-ek-NHd.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile.\"; ObjectID = \"vhk-ek-NHd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o tamanho e a localização das janelas de terminal são registrados ao fechar as janelas. Depois, ao criar uma nova janela, a geometria registrada é usada em vez do tamanho especificado no perfil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，关闭窗口时会记录终端窗口的大小和位置。之后创建新窗口时，使用记录的几何信息而不是配置文件中指定的大小。"
          }
        }
      }
    },
