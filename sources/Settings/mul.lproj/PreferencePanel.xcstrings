            "value" : "Desativar transparência para janelas em tela cheia não nativas por padrão"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认停用非原生全屏幕窗口的透明度"
          }
        }
      }
    },
