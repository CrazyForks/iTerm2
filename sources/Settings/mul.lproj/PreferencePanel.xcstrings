    "iWk-HJ-EKg.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Available for bash, fish, tcsh, xonsh and zsh. This is an alternative to installing shell integration via other methods (such as the iTerm2 > Install Shell Integration menu item).\"; ObjectID = \"iWk-HJ-EKg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Available for bash, fish, tcsh, xonsh and zsh. This is an alternative to installing shell integration via other methods (such as the iTerm2 > Install Shell Integration menu item)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponível para bash, fish, tcsh, xonsh e zsh. Esta é uma alternativa à instalação da Shell Integration por outros métodos (como o item de menu iTerm2 > Instalar Shell Integration)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 bash、fish、tcsh、xonsh 和 zsh。这是通过其他方式（如“iTerm2 > 安装 Shell 集成”菜单项）安装 Shell 集成的替代方法。"
          }
        }
