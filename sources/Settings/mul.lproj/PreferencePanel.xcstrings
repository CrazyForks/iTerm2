    "zI8-aW-nUw.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, and when the current display can use HDR (High Dynamic Range), the cursor is drawn at maximum brightness white, brighter than any white that normally appears in an application.\"; ObjectID = \"zI8-aW-nUw\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, and when the current display can use HDR (High Dynamic Range), the cursor is drawn at maximum brightness white, brighter than any white that normally appears in an application."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, e quando o monitor atual pode usar HDR (High Dynamic Range), o cursor é desenhado em branco de brilho máximo, mais brilhante do que qualquer branco que normalmente aparece em um aplicativo."
          }
        }
      }
    },
