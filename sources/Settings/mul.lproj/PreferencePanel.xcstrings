          }
        }
      }
    },
    "5zv-42-e9U.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode).\"; ObjectID = \"5zv-42-e9U\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, grandes movimentos do cursor recebem uma animação para ajudar seu olhar a acompanhar o cursor. Eles são ativados apenas em aplicativos interativos (ou seja, no modo de tela alternativa)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，大幅光标移动会带有动画，帮助你的视线跟随光标。它们仅在交互式应用中启用（即备用屏幕模式）。"
          }
        }
      }
    },
    "6CL-kh-gKr.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Automatically enable alternate mouse scroll\"; ObjectID = \"6CL-kh-gKr\";",
      "extractionState" : "extracted_with_value",
