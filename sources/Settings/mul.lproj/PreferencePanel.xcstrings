          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, o Option-clique envia as teclas de seta para mover a posição do cursor. Se a Shell Integration estiver instalada, isto não terá efeito na linha de comando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
