        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applications in terminal may access clipboard"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicativos no terminal podem acessar a área de transferência"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端中的应用可以访问剪贴板"
          }
        }
      }
    },
    "6387.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"This may be a security risk in an untrusted environment, especially if the terminal can set the title.\"; ObjectID = \"6387\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This may be a security risk in an untrusted environment, especially if the terminal can set the title."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto pode representar um risco de segurança em um ambiente não confiável, especialmente se o terminal puder definir o título."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这在不受信任的环境中可能存在安全风险，尤其是终端可以设置标题时。"
          }
        }
      }
    },
