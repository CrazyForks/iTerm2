          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clareia o texto para as cores ANSI “normais”. Não afeta as cores ANSI “brilhantes”, cores de 8 bits, cores de 24 bits ou a cor de primeiro plano padrão."
