    "ehw-7A-A75.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing.\"; ObjectID = \"ehw-7A-A75\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use este botão para localizar manualmente o plugin do navegador. Se ele não puder ser encontrado automaticamente, ou se algo estiver errado com o plugin que impeça o funcionamento da identificação automática, use isto para corrigir o problema ou descobrir por que está falhando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此按钮手动定位浏览器插件。如果无法自动找到它，或插件出现问题导致无法自动识别，请使用此选项修复问题或了解失败原因。"
          }
        }
      }
    },
    "eid-kp-DfH.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth.\"; ObjectID = \"eid-kp-DfH\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursores de sublinhado e de barra vertical podem projetar uma sombra suave sobre o caractere abaixo do cursor, dando a ele uma sensação de profundidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下划线光标和竖线光标可以给光标下方的字符投射柔和的阴影，使其具有立体感。"
          }
        }
      }
    },
    "EkI-wa-K9H.ibShadowedToolTip" : {
      "comment" : "Class = \"NSTextField\"; ibShadowedToolTip = \"The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents.\"; ObjectID = \"EkI-wa-K9H\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra de progresso fica no topo da sessão. Ela não pode exceder a altura da margem superior para evitar sobreposição com o conteúdo do terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度条位于会话顶部。它不能超过上边距高度，以避免与终端内容重叠。"
          }
        }
      }
    },
