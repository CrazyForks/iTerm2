    "wgv-Ah-fFr.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When this option is off, double click selects a word as defined by “characters considered part of word for selection” in the General tab. When this option is on, double click uses smart selection to select file names, URLs, etc., using regular expressions defined in Profiles>Advanced>Smart Selection.\"; ObjectID = \"wgv-Ah-fFr\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When this option is off, double click selects a word as defined by “characters considered part of word for selection” in the General tab. When this option is on, double click uses smart selection to select file names, URLs, etc., using regular expressions defined in Profiles>Advanced>Smart Selection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando esta opção está desativada, o clique duplo seleciona uma palavra conforme definido por “caracteres considerados parte de uma palavra para seleção” na aba Geral. Quando esta opção está ativada, o clique duplo usa a seleção inteligente para selecionar nomes de arquivos, URLs etc., usando expressões regulares definidas em Perfis > Avançado > Seleção inteligente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此选项时，连按选择“通用”标签页中“视为选区单词一部分的字符”所定义的单词。开启时，连按使用智能选择，通过“配置文件 > 高级 > 智能选择”中定义的正则表达式选择文件名、URL 等。"
          }
        }
      }
    },
