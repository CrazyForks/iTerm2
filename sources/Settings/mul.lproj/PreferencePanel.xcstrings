    "nN3-pV-Hlq.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you always want it on in alternate screen mode.\"; ObjectID = \"nN3-pV-Hlq\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you always want it on in alternate screen mode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda de rolagem ou aos gestos de rolagem. Ative isto se quiser que fique sempre ativa no modo de tela alternativa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项响应滚轮/滚动手势发送方向键的功能。如果你希望在备用屏幕模式下始终开启，请启用此选项。"
          }
        }
      }
    },
    "NtK-Fc-1Kb.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When “Force keyboard” is on, iTerm2 continuously forces the selected layout while it is active, so you cannot switch to another layout within a session. Turn this on to force the layout only once, the first time a newly created terminal receives keyboard focus, leaving you free to change it afterward.\"; ObjectID = \"NtK-Fc-1Kb\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When “Force keyboard” is on, iTerm2 continuously forces the selected layout while it is active, so you cannot switch to another layout within a session. Turn this on to force the layout only once, the first time a newly created terminal receives keyboard focus, leaving you free to change it afterward."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Forçar teclado” está ativado, o iTerm2 força continuamente o layout selecionado enquanto está ativo, de modo que você não pode alternar para outro layout dentro de uma sessão. Ative isto para forçar o layout apenas uma vez, na primeira vez que um terminal recém-criado receber o foco do teclado, deixando você livre para alterá-lo depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“强制键盘”后，iTerm2 在其活动期间持续强制所选布局，因此你无法在会话内切换到其他布局。开启此项可仅在新建终端首次获得键盘焦点时强制一次布局，之后你可以自由更改。"
          }
        }
      }
    },
    "NtK-Fc-1Kc.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Only force once per session when it first receives keyboard focus\"; ObjectID = \"NtK-Fc-1Kc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only force once per session when it first receives keyboard focus"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forçar apenas uma vez por sessão, quando ela receber o foco do teclado pela primeira vez"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当会话首次获得键盘焦点时强制一次"
          }
        }
      }
    },
