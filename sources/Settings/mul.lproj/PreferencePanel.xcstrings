    "ZG1-dm-1gD.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu.\"; ObjectID = \"ZG1-dm-1gD\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicativos de terminal que usam relatório de mouse, ativar isto permite que o clique com o botão direito (ou o toque com dois dedos no trackpad) seja relatado em vez de abrir o menu de contexto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于使用鼠标报告的终端应用，开启此选项后，右键点按（或触控板双指轻点）会被报告给应用，而不是打开上下文菜单。"
          }
        }
      }
    },
