    "6111.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu.\"; ObjectID = \"6111\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicativos de terminal que usam relato de mouse, ativar isto permite que o clique com Control seja relatado em vez de abrir o menu de contexto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于使用鼠标报告的终端应用，开启此选项后，控制点按会被报告给应用，而不是打开上下文菜单。"
          }
        }
      }
    },
