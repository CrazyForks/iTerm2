    "iuq-9l-xMR.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled the 256-color mode colors (aside from the 16 ANSI colors) will be selected to visually match well with the 8 \\\"normal\\\" ANSI colors. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset.\"; ObjectID = \"iuq-9l-xMR\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled the 256-color mode colors (aside from the 16 ANSI colors) will be selected to visually match well with the 8 \"normal\" ANSI colors. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as cores do modo de 256 cores (além das 16 cores ANSI) serão selecionadas para combinar visualmente bem com as 8 cores ANSI “normais”. Caso contrário, é usado o cubo RGB padrão. As alterações neste ajuste entram em vigor quando novas sessões são criadas ou sessões existentes são redefinidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，256 色模式的颜色（16 种 ANSI 颜色之外）将被选择为与 8 种“标准”ANSI 颜色视觉上匹配。否则使用标准 RGB 立方体。此设置的更改在创建新会话或重置现有会话时生效。"
          }
        }
      }
    },
    "iUy-lI-rM5.title" : {
