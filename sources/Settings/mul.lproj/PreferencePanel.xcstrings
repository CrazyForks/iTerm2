    "6383.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Clipboard access via an escape code poses a security risk if running untrusted applications.\"; ObjectID = \"6383\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Clipboard access via an escape code poses a security risk if running untrusted applications."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à área de transferência por um código de escape representa um risco de segurança ao executar aplicativos não confiáveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果运行不受信任的应用，通过转义码访问剪贴板会带来安全风险。"
          }
        }
      }
    },
    "6384.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Applications in terminal may access clipboard\"; ObjectID = \"6384\";",
