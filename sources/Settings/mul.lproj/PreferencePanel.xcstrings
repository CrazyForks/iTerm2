    "X0w-pC-g9j.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Enables the specified color for bold text. Also has the side-effect of using the bright version of ANSI colors for bold text in a ”normal“ ANSI color.\"; ObjectID = \"X0w-pC-g9j\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enables the specified color for bold text. Also has the side-effect of using the bright version of ANSI colors for bold text in a ”normal“ ANSI color."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa a cor especificada para texto em negrito. Também tem o efeito colateral de usar a versão brilhante das cores ANSI para texto em negrito em uma cor ANSI “normal”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为粗体文本启用指定颜色。还有一个副作用：在“标准”ANSI 颜色中使用亮色版 ANSI 颜色显示粗体文本。"
          }
        }
      }
    },
