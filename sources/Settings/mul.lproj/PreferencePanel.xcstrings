    "wjs-vG-qf2.ibExternalAccessibilityDescription" : {
      "comment" : "Class = \"NSButton\"; ibExternalAccessibilityDescription = \"Exclude from Dock only if all windows are hotkey windows\"; ObjectID = \"wjs-vG-qf2\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exclude from Dock only if all windows are hotkey windows"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir do Dock apenas se todas as janelas forem janelas de hotkey"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当所有窗口都是热键窗口时才从 Dock 中排除"
          }
        }
      }
    },
    "wjs-vG-qf2.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"This is useful if you only use iTerm2 with a hotkey window. The preference is disabled if no dedicated hotkey window is defined since it would be impossible to get to iTerm2 when it has no windows and no hotkey is defined.\"; ObjectID = \"wjs-vG-qf2\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is useful if you only use iTerm2 with a hotkey window. The preference is disabled if no dedicated hotkey window is defined since it would be impossible to get to iTerm2 when it has no windows and no hotkey is defined."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é útil se você usa o iTerm2 apenas com uma janela de hotkey. A preferência fica desativada se nenhuma janela de hotkey dedicada estiver definida, já que seria impossível acessar o iTerm2 quando ele não tem janelas e nenhum hotkey está definido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你只通过热键窗口使用 iTerm2，这会很有用。如果未定义专用的热键窗口，此设置将被停用，因为当 iTerm2 没有窗口且未定义热键时无法访问它。"
          }
        }
      }
    },
