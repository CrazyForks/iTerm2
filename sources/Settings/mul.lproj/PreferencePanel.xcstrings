        }
      }
    },
    "rcS-Ls-100.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal.\"; ObjectID = \"rcS-Ls-100\";",
