    "ttF-JA-0vc.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped.\"; ObjectID = \"ttF-JA-0vc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os apps podem fazer esta tecla option enviar Esc+ usando DECSET 1036. Observe que em alguns teclados externos as teclas option esquerda e direita ficam invertidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，应用可以通过 DECSET 1036 让此 Option 键发送 Esc+。请注意，在某些外接键盘上左右 Option 键是互换的。"
          }
        }
      }
    },
    "TV9-TP-w7T.title" : {
