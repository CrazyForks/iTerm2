    "8jj-nE-deG.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"For this setting to take effect you must disable \\\"Native full screen windows\\\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems.\"; ObjectID = \"8jj-nE-deG\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For this setting to take effect you must disable \"Native full screen windows\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que este ajuste tenha efeito, você deve desativar “Janelas em tela cheia nativas” em Ajustes > Geral. Se este ajuste estiver ativado, a barra de menus permanecerá visível. Isto é útil para sistemas com vários monitores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使此设置生效，你必须停用“设置 > 通用”中的“原生全屏幕窗口”。启用此设置后，菜单栏将保持可见。这对多显示器系统很有用。"
          }
        }
      }
