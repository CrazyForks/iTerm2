    "mlk-a6-xcL.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm.\"; ObjectID = \"mlk-a6-xcL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você ativar isto, as ligaduras opcionais desta fonte serão ativadas. Isto força o iTerm2 a usar um algoritmo de renderização de texto mais lento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，将启用此字体的可选连字。它会强制 iTerm2 使用较慢的文本渲染算法。"
          }
        }
      }
    },
