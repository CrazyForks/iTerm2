    "U4H-3c-nZg.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Some programs (such as vim and emacs) want to put the numeric keypad in \\\"application\\\" mode. Turn this off if you always want it to act as a numeric keypad.\"; ObjectID = \"U4H-3c-nZg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some programs (such as vim and emacs) want to put the numeric keypad in \"application\" mode. Turn this off if you always want it to act as a numeric keypad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns programas (como vim e emacs) querem colocar o teclado numérico no modo “aplicativo”. Desative isto se você quiser que ele sempre funcione como um teclado numérico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些程序（如 vim 和 emacs）希望将数字小键盘置于“应用”模式。如果你希望它始终作为数字小键盘使用，请关闭此选项。"
          }
        }
      }
    },
    "U5a-PY-hD8.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, ANSI red, yellow, and blue colors are used by mark indicators. Otherwise, the hardcoded default colors are used.\"; ObjectID = \"U5a-PY-hD8\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, ANSI red, yellow, and blue colors are used by mark indicators. Otherwise, the hardcoded default colors are used."
