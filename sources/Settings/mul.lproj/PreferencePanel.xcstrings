    "5126.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment.\"; ObjectID = \"5126\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você trabalha principalmente com idiomas do Leste Asiático, isto pode ser útil. Para a maioria dos usuários, causa desalinhamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你主要使用东亚语言，这可能有所帮助。对大多数用户而言，它会导致错位。"
          }
        }
      }
    },
    "5127.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Ambiguous characters are double-width\"; ObjectID = \"5127\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ambiguous characters are double-width"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres ambíguos têm largura dupla"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊字符按双宽度处理"
          }
        }
      }
    },
    "5144.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Draws a border around the window when the OS otherwise would not. This is effective in light mode or when the window contains a transparent pane.\"; ObjectID = \"5144\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Draws a border around the window when the OS otherwise would not. This is effective in light mode or when the window contains a transparent pane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha uma borda ao redor da janela quando o sistema operacional não o faria. Isto é eficaz no modo claro ou quando a janela contém um painel transparente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在操作系统不绘制边框时为窗口绘制边框。在浅色模式或窗口包含透明窗格时有效。"
          }
        }
      }
    },
