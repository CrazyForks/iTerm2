    "4896.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"This boosts the contrast of text when its color is close to that of the background color by moving the text color towards black or white.\"; ObjectID = \"4896\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This boosts the contrast of text when its color is close to that of the background color by moving the text color towards black or white."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto aumenta o contraste do texto quando a cor dele está próxima da cor do plano de fundo, movendo a cor do texto em direção ao preto ou ao branco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当文本颜色接近背景颜色时，通过将文本颜色移向黑色或白色来提高对比度。"
          }
        }
      }
    },
