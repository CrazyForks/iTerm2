    },
    "tVY-OD-hsd.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"The OSC 0 and OSC 2 control sequences set the window title. This setting controls whether such a control sequence changes the window title associated with all sessions in the window, or only with the one in which it was received. The window title is derived from the window title associated with the currently active session in that window.\"; ObjectID = \"tVY-OD-hsd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The OSC 0 and OSC 2 control sequences set the window title. This setting controls whether such a control sequence changes the window title associated with all sessions in the window, or only with the one in which it was received. The window title is derived from the window title associated with the currently active session in that window."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sequências de controle OSC 0 e OSC 2 definem o título da janela. Este ajuste controla se tal sequência de controle altera o título da janela associado a todas as sessões da janela ou apenas àquela em que foi recebida. O título da janela deriva do título de janela associado à sessão atualmente ativa nessa janela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 0 和 OSC 2 控制序列设置窗口标题。此设置控制此类控制序列是更改窗口内所有会话关联的窗口标题，还是仅更改收到该序列的会话。窗口标题源自该窗口当前活动会话关联的窗口标题。"
          }
        }
      }
    },
    "twu-ZL-q1e.title" : {
