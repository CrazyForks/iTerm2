    "9Ds-KM-wpJ.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence.\"; ObjectID = \"9Ds-KM-wpJ\";",
