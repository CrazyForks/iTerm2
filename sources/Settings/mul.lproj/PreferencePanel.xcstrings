    "mOt-Fp-WpW.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"Controls the opacity of faint (dim) text produced by SGR 2. Lower values make faint text fade further toward the background; at 1, it has no effect.\"; ObjectID = \"mOt-Fp-WpW\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Controls the opacity of faint (dim) text produced by SGR 2. Lower values make faint text fade further toward the background; at 1, it has no effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla a opacidade do texto tênue (esmaecido) produzido por SGR 2. Valores mais baixos fazem o texto tênue esmaecer mais em direção ao plano de fundo; em 1, não tem efeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制 SGR 2 产生的暗淡文本的不透明度。值越低，暗淡文本越向背景淡出；为 1 时无效果。"
          }
        }
      }
    },
