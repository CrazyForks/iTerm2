    "Nhj-1F-dbm.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect.\"; ObjectID = \"Nhj-1F-dbm\";",
