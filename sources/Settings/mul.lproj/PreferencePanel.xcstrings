            "value" : "Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envolve o comando no seu shell de login para que os dotfiles sejam executados primeiro e seu comando veja o mesmo $PATH e as mesmas variáveis exportadas que você teria em um terminal interativo."
