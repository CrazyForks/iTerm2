    "5154.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When using a program like tmux, which shows a status bar at the bottom of the screen, history is not normally saved. This allows such history to be saved but with a performance penalty.\"; ObjectID = \"5154\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using a program like tmux, which shows a status bar at the bottom of the screen, history is not normally saved. This allows such history to be saved but with a performance penalty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar um programa como o tmux, que mostra uma barra de status na parte inferior da tela, o histórico normalmente não é salvo. Isto permite salvar esse histórico, mas com perda de desempenho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 tmux 等屏幕底部显示状态栏的程序时，通常不保存历史。此选项允许保存此类历史，但会有性能损失。"
          }
        }
      }
    },
    "5155.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Save lines to scrollback when an app status bar is present\"; ObjectID = \"5155\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save lines to scrollback when an app status bar is present"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar linhas no histórico de rolagem com barra de status de app"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在应用状态栏时将行存储到回滚缓冲区"
          }
        }
      }
    },
    "5319.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Native full screen windows animate into their own desktop. Non-native full screen windows quickly expand to fill the window's screen.\"; ObjectID = \"5319\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native full screen windows animate into their own desktop. Non-native full screen windows quickly expand to fill the window's screen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas em tela cheia nativas são animadas para a própria mesa. Janelas em tela cheia não nativas expandem rapidamente para preencher a tela da janela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生全屏幕窗口会动画进入自己的桌面。非原生全屏幕窗口会快速扩展以填满窗口所在的屏幕。"
          }
        }
      }
    },
