    "LsQ-19-iaj.ibShadowedToolTip" : {
      "comment" : "Class = \"NSImageView\"; ibShadowedToolTip = \"The prompt must contain the substring \\\\(ai.prompt). The query you enter will replace it when speaking to the AI. For example: “Write a unix command to \\\\(ai.prompt).\"; ObjectID = \"LsQ-19-iaj\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The prompt must contain the substring \\(ai.prompt). The query you enter will replace it when speaking to the AI. For example: “Write a unix command to \\(ai.prompt)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O prompt deve conter a substring \\(ai.prompt). A consulta que você digitar irá substituí-la ao falar com a IA. Por exemplo: “Escreva um comando unix para \\(ai.prompt)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示符必须包含子字符串 \\(ai.prompt)。你输入的查询将在与 AI 对话时替换它。例如：“写一条 unix 命令 \\(ai.prompt)。"
          }
        }
      }
    },
