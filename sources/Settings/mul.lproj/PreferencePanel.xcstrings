    "3PU-hM-DSB.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence.\"; ObjectID = \"3PU-hM-DSB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda de rolagem/gestos de rolagem. É alternada por uma sequência de controle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项响应滚轮/滚动手势发送方向键的功能，由控制序列切换。"
          }
        }
      }
    },
