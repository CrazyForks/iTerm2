    "7dn-rM-ht2.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This will force iTerm2 to use the specified keyboard locale\\ninstead of the system keyboard.\"; ObjectID = \"7dn-rM-ht2\";",
