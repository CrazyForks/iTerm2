    "OWt-qh-bb4.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When you have selected “Use System Window Restoration Policy”, iTerm2 will not open a new window on launch if there are auto-launch scripts, a hotkey window is defined, or there are any buried sessions. Enable this to force a new window to be opened regardless.\"; ObjectID = \"OWt-qh-bb4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you have selected “Use System Window Restoration Policy”, iTerm2 will not open a new window on launch if there are auto-launch scripts, a hotkey window is defined, or there are any buried sessions. Enable this to force a new window to be opened regardless."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você tiver selecionado “Usar a política de restauração de janelas do sistema”, o iTerm2 não abrirá uma nova janela ao iniciar se houver scripts de início automático, uma janela de hotkey definida ou sessões ocultas. Ative isto para forçar a abertura de uma nova janela mesmo assim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“使用系统窗口恢复策略”后，如果存在自动启动脚本、定义了热键窗口或存在隐藏的会话，iTerm2 将不会在启动时打开新窗口。启用此项可强制无论如何都打开新窗口。"
          }
        }
      }
    },
