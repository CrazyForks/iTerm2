    "RBx-qn-HNB.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated.\"; ObjectID = \"RBx-qn-HNB\";",
