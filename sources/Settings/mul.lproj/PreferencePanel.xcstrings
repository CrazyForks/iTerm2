    "QcY-Dm-Vmc.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"When set, the Open Quickly window can be opened even when another app is active.\"; ObjectID = \"QcY-Dm-Vmc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
