      }
    },
    "QeQ-es-j2p.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, the locations of terminal windows are recorded when windows are closed. Later, when creating a new window, the window is placed in the same location (using the top left coordinate). The size is not saved; whatever rows and columns are specified in the window's originating profile are used to compute the size.\"; ObjectID = \"QeQ-es-j2p\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, the locations of terminal windows are recorded when windows are closed. Later, when creating a new window, the window is placed in the same location (using the top left coordinate). The size is not saved; whatever rows and columns are specified in the window's originating profile are used to compute the size."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as localizações das janelas de terminal são registradas quando as janelas são fechadas. Depois, ao criar uma nova janela, ela é posicionada no mesmo local (usando a coordenada superior esquerda). O tamanho não é salvo; as linhas e colunas especificadas no perfil de origem da janela são usadas para calcular o tamanho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，关闭窗口时会记录终端窗口的位置。之后创建新窗口时，窗口会放置在相同的位置（使用左上角坐标）。大小不会保存；窗口来源配置文件中指定的行列数将用于计算大小。"
          }
        }
      }
    },
    "Qhl-XG-H9e.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Use custom window title for new windows using this profile\"; ObjectID = \"Qhl-XG-H9e\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use custom window title for new windows using this profile"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar título de janela personalizado para novas janelas que usam este perfil"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为此配置文件的新窗口使用自定义窗口标题"
          }
        }
      }
    },
