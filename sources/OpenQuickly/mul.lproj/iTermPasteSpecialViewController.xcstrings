    "C2O-DY-y76.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Converts various forms of quotation marks and dashes to their ASCII equivalents.\"; ObjectID = \"C2O-DY-y76\";",
