    "FKu-pE-gGN.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Both DOS and UNIX newlines are generally not used as input. CR is standard.\"; ObjectID = \"FKu-pE-gGN\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Both DOS and UNIX newlines are generally not used as input. CR is standard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As quebras de linha DOS e UNIX geralmente não são usadas como entrada. CR é o padrão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS 和 UNIX 换行符通常不用于输入。CR 是标准。"
          }
        }
      }
    },
