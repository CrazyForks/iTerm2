    "ILq-w8-PQn.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Tab, line feed, form feed, and carriage return are the only “safe” control codes.\"; ObjectID = \"ILq-w8-PQn\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tab, line feed, form feed, and carriage return are the only “safe” control codes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulação, avanço de linha, avanço de página e retorno de carro são os únicos códigos de controle “seguros”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制表符、换行符、换页符和回车符是仅有的“安全”控制码。"
