    "a2B-NS-5LJ.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"A new AI chat mode, Orchestration, lets AI run the show for you. It can create windows, wait for tasks to complete (even in interactive apps), and the new automatic safety checker relieves you of having to respond to almost all permission prompts. <a href=\\\"iterm2whatsnew:orchestration\\\">Try it now!</a>\"; ObjectID = \"a2B-NS-5LJ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A new AI chat mode, Orchestration, lets AI run the show for you. It can create windows, wait for tasks to complete (even in interactive apps), and the new automatic safety checker relieves you of having to respond to almost all permission prompts. <a href=\"iterm2whatsnew:orchestration\">Try it now!</a>"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo modo de chat de IA, Orchestration, deixa a IA no comando por você. Ele pode criar janelas, esperar a conclusão de tarefas (mesmo em apps interativos) e o novo verificador de segurança automático livra você de ter que responder a quase todas as solicitações de permissão. <a href=\"iterm2whatsnew:orchestration\">Experimente agora!</a>"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的 AI 聊天模式 Orchestration 让 AI 为你掌控全局。它可以创建窗口、等待任务完成（即使在交互式应用中），新的自动安全检查器让你几乎无需响应权限提示。<a href=\"iterm2whatsnew:orchestration\">立即试用！</a>"
          }
        }
      }
    },
    "a3u-gh-khi.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"●\"; ObjectID = \"a3u-gh-khi\";",
