    "Tip.0073.Body" : {
      "comment" : "Tip of the day body, id 0073",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can add a configurable status bar to your terminal windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
