      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Claude Code integration relies on iTerm2’s Python API to find sessions running Claude and track their status.\n\nThe Python API is currently disabled. Setup can’t continue until it is enabled. Click Enable to turn it on."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A integração do Claude Code depende da API Python do iTerm2 para encontrar sessões executando o Claude e acompanhar seu status.\n\nA API Python está desativada no momento. A configuração não pode continuar até que ela seja ativada. Clique em Ativar para ligá-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 集成依赖 iTerm2 的 Python API 来查找运行 Claude 的会话并跟踪其状态。\n\nPython API 当前已停用。在启用之前，设置无法继续。点按“启用”将其打开。"
