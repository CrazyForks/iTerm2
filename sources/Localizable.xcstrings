    "EditSnippet.EscapingHelp" : {
      "comment" : "Explanation of snippet escaping modes shown in a help alert",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "C-Style Backslash Escaping supports: \\a (bell), \\b (backspace), \\e (escape), \\n (newline), \\r (carriage return), \\t (tab), \\\\ (backslash), and \\x followed by two hex digits giving a single byte of UTF-8.\n\nUnescaped Literal Text does not have any special characters.\n\nBackward Compatibility Escaping, which is not recommended for new snippets, supports: \\n (newline), \\e (escape), \\a (bell), and \\t (tab).\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escape de barra invertida estilo C suporta: \\a (campainha), \\b (backspace), \\e (escape), \\n (nova linha), \\r (retorno de carro), \\t (tabulação), \\\\ (barra invertida) e \\x seguido de dois dígitos hexadecimais, representando um único byte de UTF-8.\n\nO texto literal sem escape não tem nenhum caractere especial.\n\nO escape de compatibilidade retroativa, que não é recomendado para novos fragmentos, suporta: \\n (nova linha), \\e (escape), \\a (campainha) e \\t (tabulação).\n\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C 风格反斜杠转义支持：\\a（提示音）、\\b（退格）、\\e（转义）、\\n（换行）、\\r（回车）、\\t（制表符）、\\\\（反斜杠），以及 \\x 后跟两位十六进制数字以表示单个 UTF-8 字节。\n\n未转义的文本没有任何特殊字符。\n\n不推荐新片段使用的向后兼容转义支持：\\n（换行）、\\e（转义）、\\a（提示音）和 \\t（制表符）。\n\n"
          }
        }
      }
    },
    "EditSnippet.EscapingTitle" : {
      "comment" : "Title of the snippet escaping help alert",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
