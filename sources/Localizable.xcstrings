    "Tip.0117.Body" : {
      "comment" : "Tip of the day body, id 0117",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 now has an AI Chat feature! Use “Window > AI Chats” or “Edit > Explain Output with AI”. The assistant can interact with your terminal (with your permission) and explain command output, adding annotations right in the terminal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 agora tem um recurso de AI Chat! Use “Window > AI Chats” ou “Edit > Explain Output with AI”. O assistente pode interagir com o seu terminal (com sua permissão) e explicar a saída de comandos, adicionando anotações diretamente no terminal."
          }
        }
      }
    },
    "Tip.0117.Title" : {
      "comment" : "Tip of the day title, id 0117",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI Chat"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Chat"
          }
        }
      }
    },
    "Tip.0118.Body" : {
      "comment" : "Tip of the day body, id 0118",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can configure a profile to be a web browser! In “Settings > Profiles > General”, set “Profile Type” to “Web Browser”. Key bindings, smart selection, and the password manager all work in browser sessions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar um perfil para ser um navegador da web! Em “Settings > Profiles > General”, defina “Profile Type” como “Web Browser”. Atalhos de teclado, seleção inteligente e o cofre de senhas funcionam todos em sessões de navegador."
          }
        }
      }
    },
    "Tip.0118.Title" : {
      "comment" : "Tip of the day title, id 0118",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Web Browser Profiles"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfis de navegador da web"
          }
        }
      }
    },
    "Tip.0119.Body" : {
      "comment" : "Tip of the day body, id 0119",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timestamps can now be shown next to terminal content instead of overlapping. Configure it in “Settings > Profiles > Session > Timestamps”. Right-click on any line and select “Set Baseline for Relative Timestamps” to see time elapsed between lines."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As marcações de tempo agora podem ser exibidas ao lado do conteúdo do terminal em vez de sobrepostas. Configure isso em “Settings > Profiles > Session > Timestamps”. Clique com o botão direito em qualquer linha e selecione “Set Baseline for Relative Timestamps” para ver o tempo decorrido entre as linhas."
          }
        }
      }
    },
    "Tip.0119.Title" : {
      "comment" : "Tip of the day title, id 0119",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjacent Timestamps"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcações de tempo adjacentes"
          }
        }
      }
    },
    "Tip.0120.Body" : {
      "comment" : "Tip of the day body, id 0120",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a block of JSON text and choose “Edit > Replace Selection > Replace with Pretty-Printed JSON” to make it readable. Perfect for debugging API responses and log files."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um bloco de texto JSON e escolha “Edit > Replace Selection > Replace with Pretty-Printed JSON” para torná-lo legível. Perfeito para depurar respostas de API e arquivos de log."
          }
        }
      }
    },
    "Tip.0120.Title" : {
