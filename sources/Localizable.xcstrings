            "state" : "translated",
            "value" : "Avisar antes de colar quando não estiver no prompt do shell?"
          }
        }
      }
    },
    "AdvancedSetting.proportionalScrollWheelReporting" : {
      "comment" : "Advanced setting: proportionalScrollWheelReporting",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
