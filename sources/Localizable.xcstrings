    "Tip.0072.Body" : {
      "comment" : "Tip of the day body, id 0072",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can add custom behavior to iTerm2 using the Python API."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode adicionar comportamentos personalizados ao iTerm2 usando a API Python."
