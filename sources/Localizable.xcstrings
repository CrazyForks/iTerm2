    "AIManualModels.ToggleEconomyModel" : {
      "comment" : "Tooltip for the toggle economy model button",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toggle Economy Model. A cheaper model used for frequent background jobs like command-safety checks and screen-idle detection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar modelo econômico. Um modelo mais barato usado em tarefas frequentes em segundo plano, como verificações de segurança de comandos e detecção de tela ociosa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换经济模型。一种更便宜的模型，用于频繁的后台任务，例如命令安全检查与屏幕空闲检测。"
          }
        }
      }
    },
