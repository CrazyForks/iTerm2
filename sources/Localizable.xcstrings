    "AdvancedSetting.autocompleteMaxOptions" : {
      "comment" : "Advanced setting: autocompleteMaxOptions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Number of autocomplete options to present.\nA value less than 100 is recommended."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de opções de autocompletar a apresentar.\nRecomenda-se um valor menor que 100."
          }
        }
      }
    },
    "AdvancedSetting.autodetectMouseReportingStuck" : {
      "comment" : "Advanced setting: autodetectMouseReportingStuck",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatically detect when mouse reporting got stuck on?\nThis watches for parts of mouse reporting control sequences being printed to the screen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar automaticamente quando o relatório de mouse ficou travado ativado?\nIsso observa partes de sequências de controle de relatório de mouse sendo impressas na tela"
          }
        }
      }
    },
    "AdvancedSetting.autologAppends" : {
      "comment" : "Advanced setting: autologAppends",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatic session logging appends to existing files.\nWhen set to No, the file will be overwritten instead."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro automático de sessão acrescenta a arquivos existentes.\nQuando definido como Não, o arquivo será substituído."
          }
        }
      }
    },
    "AdvancedSetting.badgeFont" : {
      "comment" : "Advanced setting: badgeFont",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Font to use for the badge."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonte a usar para o selo."
          }
        }
      }
    },
    "AdvancedSetting.badgeFontIsBold" : {
      "comment" : "Advanced setting: badgeFontIsBold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should the badge render in bold type?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O selo deve ser renderizado em negrito?"
          }
        }
      }
    },
    "AdvancedSetting.badgeMaxHeightFraction" : {
      "comment" : "Advanced setting: badgeMaxHeightFraction",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum height of the badge\nAs a fraction of the height of the terminal, between 0 and 1.0. This is the default value if a profile does not have a setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima do selo\nComo uma fração da altura do terminal, entre 0 e 1.0. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        }
      }
    },
    "AdvancedSetting.badgeMaxWidthFraction" : {
      "comment" : "Advanced setting: badgeMaxWidthFraction",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum width of the badge\nAs a fraction of the width of the terminal, between 0 and 1.0. This is the default value if a profile does not have a setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura máxima do selo\nComo uma fração da largura do terminal, entre 0 e 1.0. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        }
      }
    },
    "AdvancedSetting.badgeRightMargin" : {
      "comment" : "Advanced setting: badgeRightMargin",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default value for right margin for the badge\nHow much space to leave between the right edge of the badge and the right edge of the terminal. Can be overridden by a profile setting. This is the default value if a profile does not have a setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor padrão para a margem direita do selo\nQuanto espaço deixar entre a borda direita do selo e a borda direita do terminal. Pode ser substituído por um ajuste de perfil. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        }
      }
    },
    "AdvancedSetting.badgeTopMargin" : {
      "comment" : "Advanced setting: badgeTopMargin",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default value for the top margin for the badge\nHow much space to leave between the top edge of the badge and the top edge of the terminal. Can be overridden by a profile setting. This is the default value if a profile does not have a setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor padrão para a margem superior do selo\nQuanto espaço deixar entre a borda superior do selo e a borda superior do terminal. Pode ser substituído por um ajuste de perfil. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        }
      }
    },
    "AdvancedSetting.bellRateLimit" : {
      "comment" : "Advanced setting: bellRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum time between beeping or flashing screen on bell, in seconds.\nIf the time interval between bells is less than this amount of time, it will be ignored."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo mínimo entre bipes ou piscadas da tela na campainha, em segundos.\nSe o intervalo de tempo entre campainhas for menor que este período, ela será ignorada."
          }
        }
      }
    },
    "AdvancedSetting.bootstrapDaemon" : {
      "comment" : "Advanced setting: bootstrapDaemon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow sessions to survive logging out and back in.\nThis breaks the “auth sufficient pam_tid.so” hack some people use to allow sudo to authenticate with Touch ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que sessões sobrevivam ao logout e login novamente.\nIsso quebra o truque “auth sufficient pam_tid.so” que algumas pessoas usam para permitir que o sudo autentique com Touch ID."
          }
        }
      }
    },
    "AdvancedSetting.bordersOnlyInLightMode" : {
      "comment" : "Advanced setting: bordersOnlyInLightMode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opaque windows have a border only in light mode.\nThis setting modifies “Show border around windows”. Borders in opaque windows in dark mode are ugly and the OS draws one that is pretty serviceable. Enable this if you have trouble seeing them."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas opacas têm borda apenas no modo claro.\nEste ajuste modifica “Mostrar borda ao redor das janelas”. Bordas em janelas opacas no modo escuro são feias e o sistema desenha uma que é bastante útil. Ative isto se tiver dificuldade em vê-las."
          }
        }
      }
    },
    "AdvancedSetting.bounceOnInactiveBell" : {
      "comment" : "Advanced setting: bounceOnInactiveBell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bounce dock icon when the bell rings while another app is active?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balançar o ícone no dock quando a campainha tocar enquanto outro app está ativo?"
          }
        }
      }
    },
    "AdvancedSetting.browserBundleID" : {
      "comment" : "Advanced setting: browserBundleID",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bundle ID of browser to open URLs with.\nLeave empty to use system default."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundle ID do navegador com que abrir URLs.\nDeixe vazio para usar o padrão do sistema."
          }
        }
      }
    },
    "AdvancedSetting.browserPluginPathHint" : {
      "comment" : "Advanced setting: browserPluginPathHint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location of browser plugin if it cannot be auto-detected"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localização do plugin do navegador se não puder ser detectada automaticamente"
          }
        }
      }
    },
    "AdvancedSetting.browserProfiles" : {
      "comment" : "Advanced setting: browserProfiles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable browser-style profiles?\nYou must restart iTerm2 for this to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar perfis no estilo de navegador?\nVocê deve reiniciar o iTerm2 para que isto tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.browserProxyEnabled" : {
      "comment" : "Advanced setting: browserProxyEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable HTTP proxy for web browser?\nWhen enabled, routes all browser traffic through the configured proxy server."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar proxy HTTP para o navegador web?\nQuando ativado, roteia todo o tráfego do navegador pelo servidor proxy configurado."
          }
        }
      }
    },
    "AdvancedSetting.browserProxyHost" : {
      "comment" : "Advanced setting: browserProxyHost",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HTTP proxy hostname or IP address\nThe address of the proxy server to use for browser connections."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome do host ou endereço IP do proxy HTTP\nO endereço do servidor proxy a usar para conexões do navegador."
          }
        }
      }
    },
    "AdvancedSetting.browserProxyPort" : {
      "comment" : "Advanced setting: browserProxyPort",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HTTP proxy port\nThe port number of the proxy server."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta do proxy HTTP\nO número da porta do servidor proxy."
          }
        }
      }
    },
    "AdvancedSetting.bufferDepth" : {
      "comment" : "Advanced setting: bufferDepth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of chunks to buffer.\nIn general, these chunks are 1024 bytes. A larger value increases buffer bloat but—up to a limit—can improve performance in the fast path of ASCII text."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de blocos a armazenar em buffer.\nEm geral, esses blocos têm 1024 bytes. Um valor maior aumenta o inchaço do buffer mas, até um limite, pode melhorar o desempenho no caminho rápido de texto ASCII."
          }
        }
      }
    },
    "AdvancedSetting.channelsEnabled" : {
      "comment" : "Advanced setting: channelsEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable Channels feature?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar o recurso Channels?"
          }
        }
      }
    },
    "AdvancedSetting.chaseAnchoredScreen" : {
      "comment" : "Advanced setting: chaseAnchoredScreen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Aggressively keep windows on the screen they were configured to be on"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter janelas agressivamente na tela em que foram configuradas para ficar"
          }
        }
      }
    },
    "AdvancedSetting.clearBellIconAggressively" : {
      "comment" : "Advanced setting: clearBellIconAggressively",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Clear bell icon when a session becomes active.\nWhen off, you must type in the session to clear the bell icon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar o ícone de campainha quando uma sessão se tornar ativa.\nQuando desativado, você deve digitar na sessão para limpar o ícone de campainha."
          }
        }
      }
    },
    "AdvancedSetting.clippingSeparator" : {
      "comment" : "Advanced setting: clippingSeparator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Separator inserted between multiple clippings when sending or copying them.\nThe value should use Vim syntax, such as \\n for newline and \\e for escape."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separador inserido entre múltiplos recortes ao enviá-los ou copiá-los.\nO valor deve usar a sintaxe do Vim, como \\n para nova linha e \\e para escape."
          }
        }
      }
    },
    "AdvancedSetting.closingTmuxTabKillsTmuxWindows" : {
      "comment" : "Advanced setting: closingTmuxTabKillsTmuxWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress kill/hide dialog when closing a tmux tab."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o diálogo de encerrar/ocultar ao fechar uma aba do tmux."
          }
        }
      }
    },
    "AdvancedSetting.closingTmuxWindowKillsTmuxWindows" : {
      "comment" : "Advanced setting: closingTmuxWindowKillsTmuxWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress kill/hide dialog when closing a tmux window."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o diálogo de encerrar/ocultar ao fechar uma janela do tmux."
          }
        }
      }
    },
    "AdvancedSetting.cmdClickWhenInactiveInvokesSemanticHistory" : {
      "comment" : "Advanced setting: cmdClickWhenInactiveInvokesSemanticHistory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌘-click in an active pane while iTerm2 isn't the active app invokes Semantic History.\nBy default, iTerm2 respects the OS standard that ⌘-click in an app that doesn't have keyboard focus behaves like a non-⌘ click that does not raise the window."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clique em um painel ativo enquanto o iTerm2 não é o app ativo invoca o Semantic History.\nPor padrão, o iTerm2 respeita o padrão do sistema de que ⌘-clique em um app que não tem o foco do teclado se comporta como um clique sem ⌘ que não traz a janela à frente."
          }
        }
      }
    },
    "AdvancedSetting.codeciergeCommandWarningCount" : {
      "comment" : "Advanced setting: codeciergeCommandWarningCount",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After this many commands, make codecierge confirm that you intend to keep it enabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após esta quantidade de comandos, fazer o codecierge confirmar que você pretende mantê-lo ativado."
          }
        }
      }
    },
    "AdvancedSetting.codeciergeGhostRidingPrompt" : {
      "comment" : "Advanced setting: codeciergeGhostRidingPrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prompt to send to LLM for Codecierge when it is able to execute commands automatically.\n$GOAL and $CONTEXT are replaced with the user-specified goal and info about the running environment, respectively."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prompt a enviar ao LLM para o Concierge de código quando ele pode executar comandos automaticamente.\n$GOAL e $CONTEXT são substituídos pela meta especificada pelo usuário e por informações sobre o ambiente em execução, respectivamente."
          }
        }
      }
    },
    "AdvancedSetting.codeciergeRegularPrompt" : {
      "comment" : "Advanced setting: codeciergeRegularPrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prompt to send to LLM for Codecierge when it is NOT able to execute commands automatically.\n$GOAL and $CONTEXT are replaced with the user-specified goal and info about the running environment, respectively."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prompt a enviar ao LLM para o Concierge de código quando ele NÃO pode executar comandos automaticamente.\n$GOAL e $CONTEXT são substituídos pela meta especificada pelo usuário e por informações sobre o ambiente em execução, respectivamente."
          }
        }
      }
    },
    "AdvancedSetting.coloredSelectedTabOutlineStrength" : {
      "comment" : "Advanced setting: coloredSelectedTabOutlineStrength",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How prominent should the outline around the selected tab be drawn when there are colored tabs in a window?\nTakes a value in 0 to 3, where 0 means no outline and 3 means a very prominent outline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quão proeminente deve ser desenhado o contorno ao redor da aba selecionada quando há abas coloridas em uma janela?\nRecebe um valor de 0 a 3, onde 0 significa nenhum contorno e 3 significa um contorno muito proeminente."
          }
        }
      }
    },
    "AdvancedSetting.coloredUnselectedTabTextProminence" : {
      "comment" : "Advanced setting: coloredUnselectedTabTextProminence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How prominent should the text in a non-selected tab be when there are colored tabs in a window?\nTakes a value in 0 to 1, the alpha value."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quão proeminente deve ser o texto em uma aba não selecionada quando há abas coloridas em uma janela?\nRecebe um valor de 0 a 1, o valor alfa."
          }
        }
      }
    },
    "AdvancedSetting.commandHistoryAgePower" : {
      "comment" : "Advanced setting: commandHistoryAgePower",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When sorting command history for auto command completion: how much should the time-since-last-use of a command contribute to its score? A higher score moves the command closer to the top of the list.\nUse 0 to ignore time since last use."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao ordenar o histórico de comandos para autocompletar de comandos: quanto o tempo desde o último uso de um comando deve contribuir para sua pontuação? Uma pontuação maior move o comando para mais perto do topo da lista.\nUse 0 para ignorar o tempo desde o último uso."
          }
        }
      }
    },
    "AdvancedSetting.commandHistoryUsePower" : {
      "comment" : "Advanced setting: commandHistoryUsePower",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When sorting command history for auto command completion: how much should number of uses of a command contribute to its score? A higher score moves the command closer to the top of the list.\nUse 0 to ignore number of uses."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao ordenar o histórico de comandos para autocompletar de comandos: quanto o número de usos de um comando deve contribuir para sua pontuação? Uma pontuação maior move o comando para mais perto do topo da lista.\nUse 0 para ignorar o número de usos."
          }
        }
      }
    },
    "AdvancedSetting.compactEdgeDragSize" : {
      "comment" : "Advanced setting: compactEdgeDragSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Compact theme, you can move the window by dragging starting in a region on the edge near the window border. This gives the size of that region."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Compact, você pode mover a janela arrastando a partir de uma região na borda perto da moldura da janela. Isto define o tamanho dessa região."
          }
        }
      }
    },
    "AdvancedSetting.compactMinimalTabBarHeight" : {
      "comment" : "Advanced setting: compactMinimalTabBarHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tab bar height (points) for the Minimal theme.\nThe default is 38. Use 22 to match the compact theme's height."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura da barra de abas (em pontos) para o tema Minimal.\nO padrão é 38. Use 22 para corresponder à altura do tema compact."
          }
        }
      }
    },
    "AdvancedSetting.compactTabBarStoplightButtonsWidth" : {
      "comment" : "Advanced setting: compactTabBarStoplightButtonsWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Width (in points) reserved for the window buttons (close/minimize/zoom) before the inline tab bar.\nThe default is 75. Reduce it to move tab content closer to the buttons, or increase it for more breathing room. This only takes effect for the Compact and Minimal themes when the tab bar is visible and located at the top of the window. Setting it smaller than the buttons themselves will let tabs overlap them."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura (em pontos) reservada para os botões da janela (fechar/minimizar/zoom) antes da barra de abas em linha.\nO padrão é 75. Reduza-a para mover o conteúdo das abas para mais perto dos botões, ou aumente-a para mais espaço. Isto só tem efeito para os temas Compact e Minimal quando a barra de abas está visível e localizada no topo da janela. Defini-la menor que os próprios botões fará com que as abas os sobreponham."
          }
        }
      }
    },
    "AdvancedSetting.companionPairingAllowed" : {
      "comment" : "Advanced setting: companionPairingAllowed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow pairing a companion iOS device?\nOff by default while this feature is in development. When off, the Companion Device Settings menu item is hidden. Managed environments can also use this to disable the feature. The user defaults key is `CompanionPairingAllowed`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir emparelhar um dispositivo iOS companheiro?\nDesativado por padrão enquanto este recurso está em desenvolvimento. Quando desativado, o item de menu Ajustes do dispositivo companheiro fica oculto. Ambientes gerenciados também podem usar isto para desativar o recurso. A chave de user defaults é `CompanionPairingAllowed`."
          }
        }
      }
    },
    "AdvancedSetting.companionRelayOrigin" : {
      "comment" : "Advanced setting: companionRelayOrigin",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Relay origin for companion iOS device pairing.\nMust be a bare https origin (scheme and host, no path), such as https://companion-relay.iterm2.com. The relay is the only transport, so this must be set for pairing to work; forks can point it at their own Worker. Leave empty to disable the relay entirely. The user defaults key is `CompanionRelayOrigin`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origem de retransmissão para emparelhamento de dispositivo iOS companheiro.\nDeve ser uma origem https simples (esquema e host, sem caminho), como https://companion-relay.iterm2.com. A retransmissão é o único transporte, portanto isto deve estar definido para que o emparelhamento funcione; forks podem apontá-la para seu próprio Worker. Deixe vazio para desativar a retransmissão por completo. A chave de user defaults é `CompanionRelayOrigin`."
          }
        }
      }
    },
    "AdvancedSetting.companionResolverURL" : {
      "comment" : "Advanced setting: companionResolverURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shard-map URL for companion iOS device pairing.\nAn https URL pointing directly at the static shard-map JSON, used to find the relay shard that serves the phone-to-mac connection. It is fetched verbatim (nothing is appended). Leave empty to use direct connections (such as if you run your own relay)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL do mapa de shards para emparelhamento de dispositivo iOS companheiro.\nUma URL https apontando diretamente para o JSON estático do mapa de shards, usada para encontrar o shard de retransmissão que serve a conexão telefone-para-mac. É buscada na íntegra (nada é acrescentado). Deixe vazio para usar conexões diretas (por exemplo, se você executa sua própria retransmissão)."
          }
        }
      }
    },
    "AdvancedSetting.companionStreamBitrateMultiplier" : {
      "comment" : "Advanced setting: companionStreamBitrateMultiplier",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 Buddy live stream: video bitrate multiplier.\nScales the resolution-derived encoder bitrate. Values above 1 make streamed text sharper at the cost of bandwidth; values below 1 save bandwidth at the cost of sharpness. The result is still clamped to the stream’s minimum and ceiling bitrates."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmissão ao vivo do iTerm2 Buddy: multiplicador de bitrate do vídeo.\nEscala o bitrate do codificador derivado da resolução. Valores acima de 1 tornam o texto transmitido mais nítido ao custo de largura de banda; valores abaixo de 1 economizam largura de banda ao custo de nitidez. O resultado ainda é limitado aos bitrates mínimo e máximo da transmissão."
          }
        }
      }
    },
    "AdvancedSetting.companionStreamFrameNumbers" : {
      "comment" : "Advanced setting: companionStreamFrameNumbers",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stamp frame numbers into the iTerm2 Buddy live stream?\nDraws a monotonic counter onto each streamed video frame, for debugging the phone’s live session view."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estampar números de quadro na transmissão ao vivo do iTerm2 Buddy?\nDesenha um contador monotônico em cada quadro de vídeo transmitido, para depurar a visualização de sessão ao vivo do telefone."
          }
        }
      }
    },
    "AdvancedSetting.companionStreamMaxLeadMilliseconds" : {
      "comment" : "Advanced setting: companionStreamMaxLeadMilliseconds",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 Buddy live stream: maximum capture-time lead, in milliseconds.\nThe host stops sending new frames once it is more than this far ahead of the last frame the phone acknowledged, then resumes when the phone catches up. Larger values tolerate more link latency at the cost of a live view that can lag further behind. Only the frame rate is affected; per-frame quality is unchanged."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmissão ao vivo do iTerm2 Buddy: avanço máximo do tempo de captura, em milissegundos.\nO host para de enviar novos quadros quando está mais que esta distância à frente do último quadro que o telefone confirmou, e então retoma quando o telefone se atualiza. Valores maiores toleram mais latência de conexão ao custo de uma visualização ao vivo que pode ficar mais atrasada. Apenas a taxa de quadros é afetada; a qualidade por quadro não muda."
          }
        }
      }
    },
    "AdvancedSetting.companionStreamMaxQueueDepth" : {
      "comment" : "Advanced setting: companionStreamMaxQueueDepth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 Buddy live stream: maximum phone decode-queue depth.\nThe host stops sending new frames once the phone reports more than this many frames queued for decode/display, then resumes as the queue drains. Larger values let more frames pile up on the phone before backing off. Only the frame rate is affected; per-frame quality is unchanged."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmissão ao vivo do iTerm2 Buddy: profundidade máxima da fila de decodificação do telefone.\nO host para de enviar novos quadros quando o telefone relata mais que esta quantidade de quadros na fila para decodificação/exibição, e então retoma à medida que a fila esvazia. Valores maiores deixam mais quadros se acumularem no telefone antes de recuar. Apenas a taxa de quadros é afetada; a qualidade por quadro não muda."
          }
        }
      }
    },
    "AdvancedSetting.companionWakeupCoalesceInterval" : {
      "comment" : "Advanced setting: companionWakeupCoalesceInterval",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 Buddy push notifications: minimum seconds between wakeup pushes.\nA wakeup push tells the paired phone to fetch every new message and alert at once, so several in quick succession are wasteful and can leave a later one with nothing to show (the generic “Your agent has an update.” placeholder). The host sends the first wakeup immediately, then coalesces any that follow within this interval into a single trailing wakeup. Lower values notify sooner but coalesce less; higher values coalesce bursts more aggressively."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificações push do iTerm2 Buddy: mínimo de segundos entre pushes de despertar.\nUm push de despertar diz ao telefone emparelhado para buscar todas as novas mensagens e alertas de uma vez, então vários em rápida sucessão são desperdício e podem deixar um posterior sem nada a mostrar (o marcador genérico “Seu agente tem uma atualização.”). O host envia o primeiro despertar imediatamente, então agrupa quaisquer que se sigam dentro deste intervalo em um único despertar final. Valores menores notificam mais cedo mas agrupam menos; valores maiores agrupam rajadas de forma mais agressiva."
          }
        }
      }
    },
    "AdvancedSetting.composerClearSequence" : {
      "comment" : "Advanced setting: composerClearSequence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hex codes to send to clear the command line when entering the composer.\n0x15 is ^U, 0x0b is ^K."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Códigos hexadecimais a enviar para limpar a linha de comando ao entrar no compositor.\n0x15 é ^U, 0x0b é ^K."
          }
        }
      }
    },
    "AdvancedSetting.conservativeURLGuessing" : {
      "comment" : "Advanced setting: conservativeURLGuessing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URLs must contain a scheme?\nEnable this to reduce the number of false positives that semantic history thinks are a URL"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLs devem conter um esquema?\nAtive isto para reduzir o número de falsos positivos que o Semantic History considera ser uma URL"
          }
        }
      }
    },
    "AdvancedSetting.convertItalicsToReverseVideoForTmux" : {
      "comment" : "Advanced setting: convertItalicsToReverseVideoForTmux",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Convert italics to reverse video in tmux integration?\nThis is effective when the default TERM reported by tmux matches *screen*."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converter itálicos em vídeo reverso na integração do tmux?\nIsto tem efeito quando o TERM padrão relatado pelo tmux corresponde a *screen*."
          }
        }
      }
    },
    "AdvancedSetting.convertItalicsToReverseVideoForTmuxBugwardsCompatible" : {
      "comment" : "Advanced setting: convertItalicsToReverseVideoForTmuxBugwardsCompatible",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Convert italics to reverse video in tmux integration, even when TERM matches *tmux*?\nThis was the default behavior for a long time, but it was incorrect. The conversion should only be done when TERM matches *screen*."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converter itálicos em vídeo reverso na integração do tmux, mesmo quando o TERM corresponde a *tmux*?\nEste foi o comportamento padrão por muito tempo, mas estava incorreto. A conversão só deve ser feita quando o TERM corresponde a *screen*."
          }
        }
      }
    },
    "AdvancedSetting.convertTabDragToWindowDragForSolitaryTabInCompactOrMinimalTheme" : {
      "comment" : "Advanced setting: convertTabDragToWindowDragForSolitaryTabInCompactOrMinimalTheme",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal and Compact themes when there is a single tab and the tab bar is visible, should dragging the tab bar move the window?\nThis also affects windows without titlebars in any theme."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos temas Minimal e Compact, quando há uma única aba e a barra de abas está visível, arrastar a barra de abas deve mover a janela?\nIsto também afeta janelas sem barras de título em qualquer tema."
          }
        }
      }
    },
    "AdvancedSetting.copyBackgroundColor" : {
      "comment" : "Advanced setting: copyBackgroundColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exclude the default background color when text is copied with color and font style?\nWhen off, the default background color will be left unset. Non-default background colors will remain."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir a cor de plano de fundo padrão quando o texto é copiado com cor e estilo de fonte?\nQuando desativado, a cor de plano de fundo padrão ficará sem definição. Cores de plano de fundo não padrão permanecerão."
          }
        }
      }
    },
    "AdvancedSetting.copyWithStylesByDefault" : {
      "comment" : "Advanced setting: copyWithStylesByDefault",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copy to pasteboard on selection includes color and font style."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia para a área de transferência na seleção inclui cor e estilo de fonte."
          }
        }
      }
    },
    "AdvancedSetting.cursorAnimationMinDistance" : {
      "comment" : "Advanced setting: cursorAnimationMinDistance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When animated cursor movement is enabled, only perform animation if the cursor moves at least this distance in points."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o movimento animado do cursor está ativado, só realizar a animação se o cursor mover pelo menos esta distância em pontos."
          }
        }
      }
    },
    "AdvancedSetting.cursorSlideAnimationDuration" : {
      "comment" : "Advanced setting: cursorSlideAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Duration in seconds for smooth cursor slide animation.\nThis affects the \"Smooth slide\" cursor movement option."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração em segundos para a animação suave de deslize do cursor.\nIsto afeta a opção de movimento de cursor “Deslize suave”."
          }
        }
      }
    },
    "AdvancedSetting.cursorSlideAnimationMaxCells" : {
      "comment" : "Advanced setting: cursorSlideAnimationMaxCells",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum horizontal distance in cells for smooth cursor slide animation.\nCursor movements larger than this will not animate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distância horizontal máxima em células para a animação suave de deslize do cursor.\nMovimentos do cursor maiores que isto não serão animados."
          }
        }
      }
    },
    "AdvancedSetting.cursorSmearAnimationDuration" : {
      "comment" : "Advanced setting: cursorSmearAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Duration in seconds for the “Animate large movements” cursor animation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração em segundos para a animação de cursor “Animar movimentos grandes”."
          }
        }
      }
    },
    "AdvancedSetting.customTabBarFontSize" : {
      "comment" : "Advanced setting: customTabBarFontSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom tab label font size\nFor this to take effect, turn on “Use custom font size for tab labels?”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho de fonte personalizado do rótulo da aba\nPara que isto tenha efeito, ative “Usar tamanho de fonte personalizado para rótulos de abas?”."
          }
        }
      }
    },
    "AdvancedSetting.darkModeInactiveTabDarkness" : {
      "comment" : "Advanced setting: darkModeInactiveTabDarkness",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Darkness (in [0…1]) for non-selected tabs in non-Minimal theme in dark mode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escuridão (em [0…1]) para abas não selecionadas em tema não Minimal no modo escuro."
          }
        }
      }
    },
    "AdvancedSetting.darkThemeHasBlackTitlebar" : {
      "comment" : "Advanced setting: darkThemeHasBlackTitlebar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dark themes give terminal windows black title bars by default."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temas escuros dão às janelas do terminal barras de título pretas por padrão."
          }
        }
      }
    },
    "AdvancedSetting.debugShowPromptMarkRangesInLegacyRenderer" : {
      "comment" : "Advanced setting: debugShowPromptMarkRangesInLegacyRenderer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Debug: highlight prompt mark prompt/command/excluded ranges in the legacy (non-GPU) renderer.\nWhen enabled, the legacy renderer overlays a blue outline around each visible prompt mark’s prompt range (OSC 133 A to B), a green outline around its command range (B to C), and a red outline around each excluded subrange (PS2 prefixes and right-prompt regions recorded via OSC 133 k=). Disable the Metal renderer (Settings → General → Magic) to see this. Intended for development and bug reports; leave off in normal use."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuração: destacar os intervalos de prompt/comando/excluídos das marcas de prompt no renderizador legado (não-GPU).\nQuando ativado, o renderizador legado sobrepõe um contorno azul ao redor do intervalo de prompt de cada marca de prompt visível (OSC 133 A a B), um contorno verde ao redor de seu intervalo de comando (B a C) e um contorno vermelho ao redor de cada subintervalo excluído (prefixos PS2 e regiões de prompt à direita registradas via OSC 133 k=). Desative o renderizador Metal (Ajustes → Geral → Magic) para ver isto. Destinado a desenvolvimento e relatórios de bug; deixe desativado no uso normal."
          }
        }
      }
    },
    "AdvancedSetting.defaultIconsUsingLetters" : {
      "comment" : "Advanced setting: defaultIconsUsingLetters",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use the running command's first letter as the tab's default icon if there isn't a built in one.\nThis takes effect when tabs are configured to use built-in icons."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar a primeira letra do comando em execução como o ícone padrão da aba se não houver um integrado.\nIsto tem efeito quando as abas estão configuradas para usar ícones integrados."
          }
        }
      }
    },
    "AdvancedSetting.defaultTabBarHeight" : {
      "comment" : "Advanced setting: defaultTabBarHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default tab bar height\nThis does not affect the minimal or compact themes. On macOS 26 Tahoe-style tabs, the top (horizontal) tab bar uses the system height and ignores this setting; left/right (vertical) tabs use max(26, this value) for each tab’s height."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura padrão da barra de abas\nIsto não afeta os temas minimal ou compact. Em abas no estilo Tahoe do macOS 26, a barra de abas superior (horizontal) usa a altura do sistema e ignora este ajuste; abas à esquerda/direita (verticais) usam max(26, este valor) para a altura de cada aba."
          }
        }
      }
    },
    "AdvancedSetting.defaultTabStopWidth" : {
      "comment" : "Advanced setting: defaultTabStopWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default tab stop width for new sessions.\nNote: this will break drawing in emacs and other apps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura padrão da parada de tabulação para novas sessões.\nObservação: isto quebrará o desenho no emacs e em outros apps."
          }
        }
      }
    },
    "AdvancedSetting.defaultURLScheme" : {
      "comment" : "Advanced setting: defaultURLScheme",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default URL scheme.\nThis is applied to hostnames that are not a single word."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquema de URL padrão.\nIsto é aplicado a nomes de host que não são uma única palavra."
          }
        }
      }
    },
    "AdvancedSetting.defaultWideMode" : {
      "comment" : "Advanced setting: defaultWideMode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When rendering natively, use wide mode by default?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao renderizar nativamente, usar o modo largo por padrão?"
          }
        }
      }
    },
    "AdvancedSetting.detectParagraphDirection" : {
      "comment" : "Advanced setting: detectParagraphDirection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-detect paragraph writing direction based on the first strong directional character?\nRequires right-to-left text support to be enabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar automaticamente a direção de escrita do parágrafo com base no primeiro caractere direcional forte?\nRequer que o suporte a texto da direita para a esquerda esteja ativado."
          }
        }
      }
    },
    "AdvancedSetting.detectPasswordInput" : {
      "comment" : "Advanced setting: detectPasswordInput",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show key at cursor at password prompt?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar tecla no cursor no prompt de senha?"
          }
        }
      }
    },
    "AdvancedSetting.detectPasswordInputDebounce" : {
      "comment" : "Advanced setting: detectPasswordInputDebounce",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long (seconds) terminal echo must remain disabled before iTerm2 treats it as a password prompt.\nThis prevents shell scripts that briefly turn off echo (e.g. while reading the response to an OSC report request) from triggering the password manager. Set to 0 to disable debouncing."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por quanto tempo (segundos) o eco do terminal deve permanecer desativado antes de o iTerm2 tratá-lo como um prompt de senha.\nIsto impede que scripts de shell que desativam o eco brevemente (p. ex., ao ler a resposta a uma requisição de relatório OSC) acionem o cofre de senhas. Defina como 0 para desativar o debounce."
          }
        }
      }
    },
    "AdvancedSetting.disableAdaptiveFrameRateInInteractiveApps" : {
      "comment" : "Advanced setting: disableAdaptiveFrameRateInInteractiveApps",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable adaptive framerate in interactive apps.\nTurn off adaptive frame rate while in alternate screen mode for more consistent refresh rate. This works even if alternate screen mode is disabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar a taxa de quadros adaptativa em apps interativos.\nDesativa a taxa de quadros adaptativa no modo de tela alternada para uma taxa de atualização mais consistente. Isto funciona mesmo se o modo de tela alternada estiver desativado."
          }
        }
      }
    },
    "AdvancedSetting.disableAppNap" : {
      "comment" : "Advanced setting: disableAppNap",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable App Nap.\nChange effective after restarting iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar o App Nap.\nAlteração efetiva após reiniciar o iTerm2."
          }
        }
      }
    },
    "AdvancedSetting.disableBidiInAlternateScreen" : {
      "comment" : "Advanced setting: disableBidiInAlternateScreen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do not reorder right-to-left text in the alternate screen?\nFull-screen apps (editors and some CLIs) position their own text and may already order it for display, so reordering it again fights their layout. Turn this on to leave alternate-screen text unreordered. Requires right-to-left text support."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não reordenar texto da direita para a esquerda na tela alternada?\nApps de tela cheia (editores e alguns CLIs) posicionam seu próprio texto e podem já ordená-lo para exibição, então reordená-lo novamente atrapalha seu layout. Ative isto para deixar o texto da tela alternada sem reordenação. Requer suporte a texto da direita para a esquerda."
          }
        }
      }
    },
    "AdvancedSetting.disableCustomBoxDrawing" : {
      "comment" : "Advanced setting: disableCustomBoxDrawing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use your typeface’s box-drawing characters instead of iTerm2’s custom drawing code.\nYou must restart iTerm2 after changing this setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar os caracteres de desenho de caixa do seu tipo de letra em vez do código de desenho personalizado do iTerm2.\nVocê deve reiniciar o iTerm2 após alterar este ajuste."
          }
        }
      }
    },
    "AdvancedSetting.disableDECRQCRA" : {
      "comment" : "Advanced setting: disableDECRQCRA",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable DECRQCRA?\nThis control sequence allows an app running in the terminal to read its contents."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar DECRQCRA?\nEsta sequência de controle permite que um app em execução no terminal leia seu conteúdo."
          }
        }
      }
    },
    "AdvancedSetting.disableDocumentedEditedIndicator" : {
      "comment" : "Advanced setting: disableDocumentedEditedIndicator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable documented edited indicator (black dot in close button)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar o indicador de documento editado (ponto preto no botão de fechar)"
          }
        }
      }
    },
    "AdvancedSetting.disableMetalWhenIdle" : {
      "comment" : "Advanced setting: disableMetalWhenIdle",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable metal renderer when idle to save CPU utilization?\nRequires Metal renderer"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar o renderizador metal quando ocioso para economizar uso de CPU?\nRequer o renderizador Metal"
          }
        }
      }
    },
    "AdvancedSetting.disablePasswordManagerAnimations" : {
      "comment" : "Advanced setting: disablePasswordManagerAnimations",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable animations for showing/hiding password manager."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar animações para mostrar/ocultar o cofre de senhas."
          }
        }
      }
    },
    "AdvancedSetting.disablePotentiallyInsecureEscapeSequences" : {
      "comment" : "Advanced setting: disablePotentiallyInsecureEscapeSequences",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable potentially insecure escape sequences.\nSome features of iTerm2 expand the surface area for security issues. Consider turning this on when viewing untrusted content. The following custom escape sequences will be disabled: RemoteHost, StealFocus, CurrentDir, SetProfile, CopyToClipboard, EndCopy, File, SetBackgroundImageFile, OSC 6’s proxy icon-changing feature. The following DEC sequences are disabled: DECRQCRA. The following xterm extensions are disabled: Window Title Reporting, Icon Title Reporting. This will break displaying inline images, file download, some shell integration features, and other features."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar sequências de escape potencialmente inseguras.\nAlguns recursos do iTerm2 ampliam a superfície de ataque para problemas de segurança. Considere ativar isto ao visualizar conteúdo não confiável. As seguintes sequências de escape personalizadas serão desativadas: RemoteHost, StealFocus, CurrentDir, SetProfile, CopyToClipboard, EndCopy, File, SetBackgroundImageFile, o recurso de troca de ícone do OSC 6. As seguintes sequências DEC são desativadas: DECRQCRA. As seguintes extensões do xterm são desativadas: Relatório de título de janela, Relatório de título de ícone. Isto quebrará a exibição de imagens em linha, download de arquivos, alguns recursos de Shell Integration e outros recursos."
          }
        }
      }
    },
    "AdvancedSetting.disableSmartSelectionActionsOnClick" : {
      "comment" : "Advanced setting: disableSmartSelectionActionsOnClick",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable performing the first matching Smart Selection’s Action on cmd-click?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar a execução da Ação da primeira Seleção inteligente correspondente no cmd-clique?"
          }
        }
      }
    },
    "AdvancedSetting.disableTabBarTooltips" : {
      "comment" : "Advanced setting: disableTabBarTooltips",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable tab bar tooltips?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar dicas da barra de abas?"
          }
        }
      }
    },
    "AdvancedSetting.disableTmuxWindowPositionRestoration" : {
      "comment" : "Advanced setting: disableTmuxWindowPositionRestoration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable window position restoration in tmux integration."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar a restauração da posição da janela na integração do tmux."
          }
        }
      }
    },
    "AdvancedSetting.disableTmuxWindowResizing" : {
      "comment" : "Advanced setting: disableTmuxWindowResizing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't automatically resize tmux windows"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não redimensionar automaticamente as janelas do tmux"
          }
        }
      }
    },
    "AdvancedSetting.disableTopRightIndicators" : {
      "comment" : "Advanced setting: disableTopRightIndicators",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable indicator icons that appear in the top right of a session?\nThis includes the following indicators: maximized pane, broadcast input, coprocess running, alert on next mark, output suppression, zoom, copy mode, and debug logging."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar os ícones indicadores que aparecem no canto superior direito de uma sessão?\nIsto inclui os seguintes indicadores: painel maximizado, transmitir entrada, coprocess em execução, alerta na próxima marca, supressão de saída, zoom, modo de cópia e registro de depuração."
          }
        }
      }
    },
    "AdvancedSetting.disableWindowShadowWhenTransparencyOnMojave" : {
      "comment" : "Advanced setting: disableWindowShadowWhenTransparencyOnMojave",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable the window shadow on Mojave when the window has a transparent session to improve performance."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar a sombra da janela no Mojave quando a janela tem uma sessão transparente para melhorar o desempenho."
          }
        }
      }
    },
    "AdvancedSetting.disableWindowShadowWhenTransparencyPreMojave" : {
      "comment" : "Advanced setting: disableWindowShadowWhenTransparencyPreMojave",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable the window shadow on High Sierra and earlier when the window has a transparent session to prevent text shadows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar a sombra da janela no High Sierra e anteriores quando a janela tem uma sessão transparente para evitar sombras de texto."
          }
        }
      }
    },
    "AdvancedSetting.disableWindowSizeSnap" : {
      "comment" : "Advanced setting: disableWindowSizeSnap",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Terminal windows resize smoothly.\nDisables snapping to character grid. Holding Control will temporarily disable snap-to-grid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas do terminal redimensionam suavemente.\nDesativa o encaixe na grade de caracteres. Manter Control temporariamente desativará o encaixe na grade."
          }
        }
      }
    },
    "AdvancedSetting.disallowCopyEmptyString" : {
      "comment" : "Advanced setting: disallowCopyEmptyString",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disallow copying empty string to pasteboard.\nIf enabled, selecting an empty string (or all whitespace if trimming is enabled) will not erase the contents of the pasteboard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não permitir copiar string vazia para a área de transferência.\nSe ativado, selecionar uma string vazia (ou tudo espaço em branco, se o recorte estiver ativado) não apagará o conteúdo da área de transferência."
          }
        }
      }
    },
    "AdvancedSetting.disclaimChildren" : {
      "comment" : "Advanced setting: disclaimChildren",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disclaim ownership of children.\nBy enabling this, when launching a Cocoa app from a terminal window TCC should attribute ownership to the app, not iTerm2, for permissions. In order for changes to this setting to take effect, you must kill iTermServer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renunciar à propriedade dos filhos.\nAo ativar isto, ao iniciar um app Cocoa a partir de uma janela do terminal, o TCC deve atribuir a propriedade ao app, não ao iTerm2, para fins de permissões. Para que as alterações neste ajuste tenham efeito, você deve encerrar o iTermServer."
          }
        }
      }
    },
    "AdvancedSetting.dismemberScrollView" : {
      "comment" : "Advanced setting: dismemberScrollView",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dismember scroll view for better GPU performance?\nThis enables a dangerous hack that might improve drawing performance on macOS 10.14 only."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desmembrar a scroll view para melhor desempenho de GPU?\nIsto ativa um hack perigoso que pode melhorar o desempenho de desenho apenas no macOS 10.14."
          }
        }
      }
    },
    "AdvancedSetting.disregardDockSettingToOpenTabsInsteadOfWindows" : {
      "comment" : "Advanced setting: disregardDockSettingToOpenTabsInsteadOfWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ignore System Settings > Dock > Prefer tabs when opening documents?\nWhen set to No, asking to open a window will open a tab instead when system settings is configured to prefer tabs over windows. When set to Yes, asking to open a window may open a tab instead."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorar Ajustes do Sistema > Dock > Preferir abas ao abrir documentos?\nQuando definido como Não, pedir para abrir uma janela abrirá uma aba quando os ajustes do sistema estiverem configurados para preferir abas a janelas. Quando definido como Sim, pedir para abrir uma janela pode abrir uma aba."
          }
        }
      }
    },
    "AdvancedSetting.doNotSetCtype" : {
      "comment" : "Advanced setting: doNotSetCtype",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Never set the CTYPE environment variable."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca definir a variável de ambiente CTYPE."
          }
        }
      }
    },
    "AdvancedSetting.dockIconTogglesWindow" : {
      "comment" : "Advanced setting: dockIconTogglesWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If the only window is a hotkey window, then clicking the dock icon shows or hides it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a única janela for uma janela de hotkey, clicar no ícone do dock a mostra ou oculta."
          }
        }
      }
    },
    "AdvancedSetting.doubleClickTabToEdit" : {
      "comment" : "Advanced setting: doubleClickTabToEdit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should double-clicking a tab open a window to edit its title?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicar duas vezes em uma aba deve abrir uma janela para editar seu título?"
          }
        }
      }
    },
    "AdvancedSetting.doubleReportScrollWheel" : {
      "comment" : "Advanced setting: doubleReportScrollWheel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Double-report scroll wheel events to work around tmux scrolling bug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar em dobro os eventos da roda de rolagem para contornar um bug de rolagem do tmux."
          }
        }
      }
    },
    "AdvancedSetting.downloadsDirectory" : {
      "comment" : "Advanced setting: downloadsDirectory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Downloads folder.\nIf set, downloaded files go to this location instead of the user’s $HOME/Downloads folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta de downloads.\nSe definida, os arquivos baixados vão para este local em vez da pasta $HOME/Downloads do usuário."
          }
        }
      }
    },
    "AdvancedSetting.drawBottomLineForHorizontalTabBar" : {
      "comment" : "Advanced setting: drawBottomLineForHorizontalTabBar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Draw bottom line for horizontal tabbar in Regular, Dark and Light theme?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhar linha inferior para a barra de abas horizontal nos temas Regular, Dark e Light?"
          }
        }
      }
    },
    "AdvancedSetting.drawOutlineAroundCursor" : {
      "comment" : "Advanced setting: drawOutlineAroundCursor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Draw outline around underline and vertical bar cursors using background color."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhar contorno ao redor dos cursores de sublinhado e barra vertical usando a cor de plano de fundo."
          }
        }
      }
    },
    "AdvancedSetting.dryRunEraseAllSettingsAndData" : {
      "comment" : "Advanced setting: dryRunEraseAllSettingsAndData",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dry-run “Erase All Settings and Data”.\nWhen enabled, the Erase All Settings and Data button logs what it would delete (via NSLog) instead of actually deleting anything, and does not quit. Intended for testing the feature."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simular “Apagar todos os ajustes e dados”.\nQuando ativado, o botão Apagar todos os ajustes e dados registra o que apagaria (via NSLog) em vez de realmente apagar algo, e não encerra. Destinado a testar o recurso."
          }
        }
      }
    },
    "AdvancedSetting.dwcLineCache" : {
      "comment" : "Advanced setting: dwcLineCache",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable cache of double-width character locations?\nThis should improve performance. It is always on in nightly builds. You must restart iTerm2 for this setting to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar cache de localizações de caracteres de largura dupla?\nIsto deve melhorar o desempenho. Está sempre ativado em builds noturnos. Você deve reiniciar o iTerm2 para que este ajuste tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.dynamicProfilesNotificationLatency" : {
      "comment" : "Advanced setting: dynamicProfilesNotificationLatency",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay between detecting a change to dynamic profiles and acting on it.\nIf a lot of changes happen to the DynamicProfiles folder a longer delay will help coalesce filesystem events to reduce CPU usage."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso entre detectar uma alteração em perfis dinâmicos e agir sobre ela.\nSe muitas alterações acontecerem na pasta DynamicProfiles, um atraso maior ajudará a agrupar eventos do sistema de arquivos para reduzir o uso de CPU."
          }
        }
      }
    },
    "AdvancedSetting.dynamicProfilesPath" : {
      "comment" : "Advanced setting: dynamicProfilesPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Path to folder with dynamic profiles.\nWhen empty, ~/Library/Application Support/iTerm2/DynamicProfiles will be used. You must restart iTerm2 after modifying this setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminho para a pasta com perfis dinâmicos.\nQuando vazio, ~/Library/Application Support/iTerm2/DynamicProfiles será usado. Você deve reiniciar o iTerm2 após modificar este ajuste."
          }
        }
      }
    },
    "AdvancedSetting.echoProbeDuration" : {
      "comment" : "Advanced setting: echoProbeDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Amount of time to wait while testing if echo is on (seconds).\nThis is used by the password manager to ensure you're at a password prompt. Set to 0 to disable echo probe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo a aguardar ao testar se o eco está ativado (segundos).\nIsto é usado pelo cofre de senhas para garantir que você está em um prompt de senha. Defina como 0 para desativar a sondagem de eco."
          }
        }
      }
    },
    "AdvancedSetting.enableCharacterAccentMenu" : {
      "comment" : "Advanced setting: enableCharacterAccentMenu",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable character accent menu.\nThis disables the ordinary key repeat behavior for press-and-hold. You must restart iTerm2 for this change to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar o menu de acentos de caractere.\nIsto desativa o comportamento comum de repetição de tecla para pressionar e segurar. Você deve reiniciar o iTerm2 para que esta alteração tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.enableCmdClickPromptForShowCommandInfo" : {
      "comment" : "Advanced setting: enableCmdClickPromptForShowCommandInfo",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌘-click in the prompt shows the Command Info window"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clique no prompt mostra a janela Command Info"
          }
        }
      }
    },
    "AdvancedSetting.enableContextualAlternates" : {
      "comment" : "Advanced setting: enableContextualAlternates",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable contextual alternates (calt) for ligature-capable fonts.\nWhen enabled, uses ligature level 2 which activates calt in addition to standard ligatures. Many coding fonts such as Monaspace, Iosevka, and Cascadia Code require this for their ligatures to work."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar alternativas contextuais (calt) para fontes compatíveis com ligaduras.\nQuando ativado, usa o nível 2 de ligaduras, que ativa calt além das ligaduras padrão. Muitas fontes de programação como Monaspace, Iosevka e Cascadia Code exigem isto para que suas ligaduras funcionem."
          }
        }
      }
    },
    "AdvancedSetting.enableSecureKeyboardEntryAutomatically" : {
      "comment" : "Advanced setting: enableSecureKeyboardEntryAutomatically",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatically enable secure keyboard entry at password prompts?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar automaticamente a entrada de teclado segura em prompts de senha?"
          }
        }
      }
    },
    "AdvancedSetting.enableSemanticHistoryOnNetworkMounts" : {
      "comment" : "Advanced setting: enableSemanticHistoryOnNetworkMounts",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable semantic history for network-mounted filesystems?\nOnly enable this if you know your network-mounted filesystems are really fast and reliable. A slow filesystem may cause the entire iTerm2 app to hang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar o Semantic History para sistemas de arquivos montados via rede?\nSó ative isto se você souber que seus sistemas de arquivos montados via rede são realmente rápidos e confiáveis. Um sistema de arquivos lento pode fazer o app iTerm2 inteiro travar."
          }
        }
      }
    },
    "AdvancedSetting.enableUnderlineSemanticHistoryOnCmdHover" : {
      "comment" : "Advanced setting: enableUnderlineSemanticHistoryOnCmdHover",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Underline Semantic History-selectable items under the cursor while holding ⌘?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sublinhar itens selecionáveis por Semantic History sob o cursor enquanto mantém ⌘?"
          }
        }
      }
    },
    "AdvancedSetting.enableZoomMenu" : {
      "comment" : "Advanced setting: enableZoomMenu",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow the standard system menu on window Zoom buttons to open?\nmacOS has a bug that makes the app hang. Since this is a rarely used menu, it is disabled by default."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que o menu padrão do sistema nos botões de Zoom da janela abra?\nO macOS tem um bug que faz o app travar. Como este é um menu raramente usado, ele fica desativado por padrão."
          }
        }
      }
    },
    "AdvancedSetting.errorSound" : {
      "comment" : "Advanced setting: errorSound",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Alert on Next Mark is configured to play a sound, use a file with this name for erroneous completion of the previous command.\nYou can name a system sound or a file in ~/Library/Sounds."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando Alerta na próxima marca está configurado para tocar um som, usar um arquivo com este nome para a conclusão errônea do comando anterior.\nVocê pode nomear um som do sistema ou um arquivo em ~/Library/Sounds."
          }
        }
      }
    },
    "AdvancedSetting.escapeWithQuotes" : {
      "comment" : "Advanced setting: escapeWithQuotes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Escape file names with single quotes instead of backslashes.\nThis is intended for users of xonsh, which does not accept backslash escaping."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapar nomes de arquivo com aspas simples em vez de barras invertidas.\nIsto é destinado a usuários do xonsh, que não aceita escape com barra invertida."
          }
        }
      }
    },
    "AdvancedSetting.excludeBackgroundColorsFromCopiedStyle" : {
      "comment" : "Advanced setting: excludeBackgroundColorsFromCopiedStyle",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exclude all background colors when text is copied with color and font style?\nThis includes both the default background color and non-default background colors."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir todas as cores de plano de fundo quando o texto é copiado com cor e estilo de fonte?\nIsto inclui tanto a cor de plano de fundo padrão quanto as cores de plano de fundo não padrão."
          }
        }
      }
    },
    "AdvancedSetting.excludeUtunFromNetworkUtilization" : {
      "comment" : "Advanced setting: excludeUtunFromNetworkUtilization",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exclude utun interfaces from network utilization?\nThis is useful if you use a VPN and only want to see the traffic that goes over Wi-Fi or Ethernet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir interfaces utun da utilização de rede?\nIsto é útil se você usa uma VPN e só quer ver o tráfego que passa por Wi-Fi ou Ethernet."
          }
        }
      }
    },
    "AdvancedSetting.experimentalKeyHandling" : {
      "comment" : "Advanced setting: experimentalKeyHandling",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Improved support for input method editors like AquaSKK."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suporte melhorado para editores de método de entrada como o AquaSKK."
          }
        }
      }
    },
    "AdvancedSetting.extendBackgroundColorIntoMargins" : {
      "comment" : "Advanced setting: extendBackgroundColorIntoMargins",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Extend background color into margins in alternate screen mode?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estender a cor de plano de fundo para as margens no modo de tela alternada?"
          }
        }
      }
    },
    "AdvancedSetting.extraSpaceBeforeCompactTopTabBar" : {
      "comment" : "Advanced setting: extraSpaceBeforeCompactTopTabBar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Amount of extra space (in points) between stoplight buttons and inline tab bar.\nThis only takes effect for the Compact and Minimal themes when the tab bar is visible and located at the top of the window."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantidade de espaço extra (em pontos) entre os botões do semáforo e a barra de abas em linha.\nIsto só tem efeito para os temas Compact e Minimal quando a barra de abas está visível e localizada no topo da janela."
          }
        }
      }
    },
    "AdvancedSetting.fakeFullyQualifiedDomainName" : {
      "comment" : "Advanced setting: fakeFullyQualifiedDomainName",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Override the local hostname used for localhost detection.\nWhen non-empty, the app behaves as though [NSHost fullyQualifiedDomainName] returns this value. Lets you test how localhost detection reacts to a hostname change without actually renaming your computer. Affects hosts reported after you change it; leave empty to use the real hostname."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir o nome de host local usado para detecção de localhost.\nQuando não vazio, o app se comporta como se [NSHost fullyQualifiedDomainName] retornasse este valor. Permite testar como a detecção de localhost reage a uma alteração de nome de host sem realmente renomear seu computador. Afeta hosts relatados depois que você o altera; deixe vazio para usar o nome de host real."
          }
        }
      }
    },
    "AdvancedSetting.fakeNotchHeight" : {
      "comment" : "Advanced setting: fakeNotchHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Simulated notch height"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura simulada do notch"
          }
        }
      }
    },
    "AdvancedSetting.fallbackLCCType" : {
      "comment" : "Advanced setting: fallbackLCCType",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Value to set LC_CTYPE to if the machine‘s combination of country and language are not supported.\nIf unset, the encoding (e.g., UTF-8) will be used."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor para definir LC_CTYPE se a combinação de país e idioma da máquina não for suportada.\nSe não definido, a codificação (p. ex., UTF-8) será usada."
          }
        }
      }
    },
    "AdvancedSetting.fastForegroundJobUpdates" : {
      "comment" : "Advanced setting: fastForegroundJobUpdates",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable low-latency updates of the current foreground job"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar atualizações de baixa latência do processo em primeiro plano atual"
          }
        }
      }
    },
    "AdvancedSetting.fastTrackpad" : {
      "comment" : "Advanced setting: fastTrackpad",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trackpad scrolls fast?\nSet to No for legacy scrolling speed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trackpad rola rápido?\nDefina como Não para a velocidade de rolagem legada."
          }
        }
      }
    },
    "AdvancedSetting.fastTriggerRegexes" : {
      "comment" : "Advanced setting: fastTriggerRegexes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast regular expression evaluation for triggers.\nThis is experimental because it could potentially change how regular expressions are interpreted."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaliação rápida de expressões regulares para gatilhos.\nIsto é experimental porque poderia potencialmente alterar como as expressões regulares são interpretadas."
          }
        }
      }
    },
    "AdvancedSetting.fileDropCoprocess" : {
      "comment" : "Advanced setting: fileDropCoprocess",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When files are dropped into a terminal window, execute a silent coprocess.\nThis is an interpolated string. Use \\(filenames) to reference the shell-quoted, space-delimited full paths to the dropped files. If this preference is empty, the filenames get pasted instead."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando arquivos são soltos em uma janela do terminal, executar um coprocess silencioso.\nEsta é uma string interpolada. Use \\(filenames) para referenciar os caminhos completos, separados por espaço e com escape de shell, dos arquivos soltos. Se esta preferência estiver vazia, os nomes de arquivo são colados em vez disso."
          }
        }
      }
    },
    "AdvancedSetting.filenameCharacterSet" : {
      "comment" : "Advanced setting: filenameCharacterSet",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Non-alphanumeric characters considered part of a filename. Note that URL characters (a separate advanced setting) are also allowed.\nLetters and numbers are always considered part of the URL. These non-alphanumeric characters are used in addition for the purposes of figuring out where a file begins and ends. You must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres não alfanuméricos considerados parte de um nome de arquivo. Observe que caracteres de URL (um ajuste avançado separado) também são permitidos.\nLetras e números são sempre considerados parte da URL. Esses caracteres não alfanuméricos são usados adicionalmente para determinar onde um arquivo começa e termina. Você deve reiniciar o iTerm2 para que as alterações neste ajuste tenham efeito."
          }
        }
      }
    },
    "AdvancedSetting.findDelaySeconds" : {
      "comment" : "Advanced setting: findDelaySeconds",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Time to wait before performing Find action on 1- or 2- character queries."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo a aguardar antes de realizar a ação de Busca em consultas de 1 ou 2 caracteres."
          }
        }
      }
    },
    "AdvancedSetting.findURLsRespectsSoftBoundaries" : {
      "comment" : "Advanced setting: findURLsRespectsSoftBoundaries",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using “Find URLs”, extend results across soft boundaries like tmux pane dividers."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar “Buscar URLs”, estender os resultados através de fronteiras suaves como divisores de painel do tmux."
          }
        }
      }
    },
    "AdvancedSetting.findUrlsRegex" : {
      "comment" : "Advanced setting: findUrlsRegex",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Regular expression for “Find URLs” command."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expressão regular para o comando “Buscar URLs”."
          }
        }
      }
    },
    "AdvancedSetting.fixMouseWheel" : {
      "comment" : "Advanced setting: fixMouseWheel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mouse wheel always scrolls when scroll bars are visible"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roda do mouse sempre rola quando as barras de rolagem estão visíveis"
          }
        }
      }
    },
    "AdvancedSetting.focusNewSplitPaneWithFocusFollowsMouse" : {
      "comment" : "Advanced setting: focusNewSplitPaneWithFocusFollowsMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When focus follows mouse is enabled, should new split panes automatically be focused?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o foco segue o mouse está ativado, novos painéis divididos devem ser focados automaticamente?"
          }
        }
      }
    },
    "AdvancedSetting.focusReportingEnabled" : {
      "comment" : "Advanced setting: focusReportingEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps may turn on Focus Reporting.\nFocus reporting causes iTerm2 to send an escape sequence when a session gains or loses focus. It can cause problems when an ssh session dies unexpectedly because it gets left on, so some users prefer to disable it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps podem ativar o Relatório de foco.\nO relatório de foco faz o iTerm2 enviar uma sequência de escape quando uma sessão ganha ou perde o foco. Pode causar problemas quando uma sessão ssh morre inesperadamente porque fica ativado, então alguns usuários preferem desativá-lo."
          }
        }
      }
    },
    "AdvancedSetting.fontChangeAffectsBroadcastingSessions" : {
      "comment" : "Advanced setting: fontChangeAffectsBroadcastingSessions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should growing or shrinking the font in a session that's broadcasting input affect all session that broadcast input?\nThis only applies to changing the font size with Make Text Bigger, Make Text Normal Size, and Make Text Smaller"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar ou diminuir a fonte em uma sessão que está transmitindo entrada deve afetar todas as sessões que transmitem entrada?\nIsto só se aplica a alterar o tamanho da fonte com Aumentar o texto, Tamanho normal do texto e Diminuir o texto"
          }
        }
      }
    },
    "AdvancedSetting.fontsForGenerousRounding" : {
      "comment" : "Advanced setting: fontsForGenerousRounding",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List of fonts to use alternate rounding algorithm for line height calculation.\nThis fixes consolas and emulates Terminal.app’s behavior on macOS 10.15. This is a comma-delimited list of font family substrings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista de fontes para usar o algoritmo de arredondamento alternativo no cálculo da altura da linha.\nIsto corrige o consolas e emula o comportamento do Terminal.app no macOS 10.15. Esta é uma lista, separada por vírgulas, de substrings de família de fonte."
          }
        }
      }
    },
    "AdvancedSetting.forceAntialiasingOnRetina" : {
      "comment" : "Advanced setting: forceAntialiasingOnRetina",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Force text to be anti-aliased on Retina displays.\nEnable this to use non-AA text on non-retina displays, which sometimes looks better."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forçar o texto a ter anti-aliasing em telas Retina.\nAtive isto para usar texto sem AA em telas não retina, o que às vezes fica melhor."
          }
        }
      }
    },
    "AdvancedSetting.fractionOfCharacterSelectingNextNeighbor" : {
      "comment" : "Advanced setting: fractionOfCharacterSelectingNextNeighbor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fraction of character’s width on its right side that can be used to select the character to its right."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fração da largura do caractere no seu lado direito que pode ser usada para selecionar o caractere à sua direita."
          }
        }
      }
    },
    "AdvancedSetting.fullHeightCursor" : {
      "comment" : "Advanced setting: fullHeightCursor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cursor occupies line spacing area.\nIf lines have more than 100% vertical spacing and this setting is enabled the bottom of the cursor will be aligned to the bottom of the spacing area."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cursor ocupa a área de espaçamento entre linhas.\nSe as linhas tiverem mais de 100% de espaçamento vertical e este ajuste estiver ativado, a parte inferior do cursor será alinhada à parte inferior da área de espaçamento."
          }
        }
      }
    },
    "AdvancedSetting.fullWidthFlags" : {
      "comment" : "Advanced setting: fullWidthFlags",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Flag emoji render full-width"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emojis de bandeira renderizam em largura total"
          }
        }
      }
    },
    "AdvancedSetting.generativeAIAllowed" : {
      "comment" : "Advanced setting: generativeAIAllowed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow the use of large language model APIs?\nThe purpose of this setting is to make it easy for managed environments to disable the use of LLMs. The user defaults key is `GenerativeAIAllowed`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir o uso de APIs de grandes modelos de linguagem?\nO propósito deste ajuste é facilitar que ambientes gerenciados desativem o uso de LLMs. A chave de user defaults é `GenerativeAIAllowed`."
          }
        }
      }
    },
    "AdvancedSetting.gitSearchPath" : {
      "comment" : "Advanced setting: gitSearchPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "$PATH used when running git for the status bar component.\nChange this to use a custom install of git. You must restart iTerm2 for a change here to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH usado ao executar o git para o componente da barra de status.\nAltere isto para usar uma instalação personalizada do git. Você deve reiniciar o iTerm2 para que uma alteração aqui tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.gitTimeout" : {
      "comment" : "Advanced setting: gitTimeout",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeout in seconds when running git for the status bar component."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo limite em segundos ao executar o git para o componente da barra de status."
          }
        }
      }
    },
    "AdvancedSetting.hdrCursor" : {
      "comment" : "Advanced setting: hdrCursor",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HDR cursor\nExperimental. Half-baked. Probably don't use this."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor HDR\nExperimental. Meio pronto. Provavelmente não use isto."
          }
        }
      }
    },
    "AdvancedSetting.hideStuckTooltips" : {
      "comment" : "Advanced setting: hideStuckTooltips",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide stuck tooltips.\nWhen you hide iTerm2 using a hotkey while a tooltip is fading out it gets stuck because of an OS bug. Work around it with a nasty hack by enabling this feature."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar dicas travadas.\nQuando você oculta o iTerm2 usando uma hotkey enquanto uma dica está desaparecendo, ela fica travada por causa de um bug do sistema. Contorne isso com um hack desagradável ativando este recurso."
          }
        }
      }
    },
    "AdvancedSetting.highVisibility" : {
      "comment" : "Advanced setting: highVisibility",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High Contrast modes maximize visibility.\nWhen enabled, the dark high-contrast theme emphasizes visibility over beauty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modos de Alto Contraste maximizam a visibilidade.\nQuando ativado, o tema escuro de alto contraste enfatiza a visibilidade em vez da beleza."
          }
        }
      }
    },
    "AdvancedSetting.horizontalScrollingSensitivity" : {
      "comment" : "Advanced setting: horizontalScrollingSensitivity",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity of mouse wheel for horizontal scrolling.\nUse 0 to disable. Value should be between 0 and 1. Changes to this setting only affect new sessions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensibilidade da roda do mouse para rolagem horizontal.\nUse 0 para desativar. O valor deve estar entre 0 e 1. Alterações neste ajuste só afetam novas sessões."
          }
        }
      }
    },
    "AdvancedSetting.hotKeyDoubleTapMaxDelay" : {
      "comment" : "Advanced setting: hotKeyDoubleTapMaxDelay",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The maximum amount of time allowed between presses of a modifier key when performing a modifier double-tap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo máximo permitido entre pressionamentos de uma tecla modificadora ao realizar um toque duplo de modificador."
          }
        }
      }
    },
    "AdvancedSetting.hotKeyDoubleTapMinDelay" : {
      "comment" : "Advanced setting: hotKeyDoubleTapMinDelay",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The minimum amount of time required between presses of a modifier key when performing a modifier double-tap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo mínimo necessário entre pressionamentos de uma tecla modificadora ao realizar um toque duplo de modificador."
          }
        }
      }
    },
    "AdvancedSetting.hotkeyTermAnimationDuration" : {
      "comment" : "Advanced setting: hotkeyTermAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Duration in seconds of the hotkey window animation.\nWarning: reducing this value may cause problems if you have multiple displays."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração em segundos da animação da janela Hotkey.\nAviso: reduzir este valor pode causar problemas se você tiver várias telas."
          }
        }
      }
    },
    "AdvancedSetting.hotkeyWindowFloatsAboveOtherWindows" : {
      "comment" : "Advanced setting: hotkeyWindowFloatsAboveOtherWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The hotkey window floats above other windows even when another application is active.\nYou must disable “Settings > Keys > Hotkey window hides when focus is lost” for this setting to be effective."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela Hotkey fica acima das outras janelas mesmo quando outro aplicativo está ativo.\nVocê precisa desativar “Ajustes > Teclas > A janela Hotkey se oculta ao perder o foco” para que este ajuste tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.hotkeyWindowsExcludedFromCycling" : {
      "comment" : "Advanced setting: hotkeyWindowsExcludedFromCycling",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hotkey windows are excluded from Cycle Through Windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas Hotkey são excluídas de Alternar entre janelas."
          }
        }
      }
    },
    "AdvancedSetting.idempotentTriggerModeRateLimit" : {
      "comment" : "Advanced setting: idempotentTriggerModeRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When evaluating idempotent triggers in interactive apps, wait this long (in seconds) between updates.\nThis limits the performance impact of trigger evaluation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao avaliar gatilhos idempotentes em apps interativos, aguarde este tempo (em segundos) entre atualizações.\nIsto limita o impacto de desempenho da avaliação de gatilhos."
          }
        }
      }
    },
    "AdvancedSetting.idleTimeSeconds" : {
      "comment" : "Advanced setting: idleTimeSeconds",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Time in seconds before a session is considered idle.\nUsed for updating icons and activity indicator in tabs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo em segundos antes de uma sessão ser considerada ociosa.\nUsado para atualizar ícones e o indicador de atividade nas abas."
          }
        }
      }
    },
    "AdvancedSetting.ignoreHardNewlinesInURLs" : {
      "comment" : "Advanced setting: ignoreHardNewlinesInURLs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ignore hard newlines for the purposes of locating URLs and file names for Semantic History.\nIf a hard newline occurs at the end of a line then ⌘-click will not see it all unless this setting is turned on. This is useful for some interactive applications. Turning this on will remove newlines from the \\3 and \\4 substitutions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorar quebras de linha fixas para localizar URLs e nomes de arquivos no Semantic History.\nSe uma quebra de linha fixa ocorrer no fim de uma linha, o clique com ⌘ não a verá por completo a menos que este ajuste esteja ativado. Isto é útil para alguns aplicativos interativos. Ativar isto removerá quebras de linha das substituições \\3 e \\4."
          }
        }
      }
    },
    "AdvancedSetting.includePasteHistoryInAdvancedPaste" : {
      "comment" : "Advanced setting: includePasteHistoryInAdvancedPaste",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Include paste history in the advanced paste menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluir o histórico de colagem no menu de colagem avançada."
          }
        }
      }
    },
    "AdvancedSetting.includeShortcutInWindowsMenu" : {
      "comment" : "Advanced setting: includeShortcutInWindowsMenu",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Include keyboard shortcut for windows in Window menu?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluir atalho de teclado para janelas no menu Janela?"
          }
        }
      }
    },
    "AdvancedSetting.indicateBellsInDockBadgeLabel" : {
      "comment" : "Advanced setting: indicateBellsInDockBadgeLabel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Indicate the number of bells rung while the app is inactive in the dock icon’s badge label"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicar o número de campainhas tocadas enquanto o app está inativo no selo do ícone do dock"
          }
        }
      }
    },
    "AdvancedSetting.indicatorFlashInitialAlpha" : {
      "comment" : "Advanced setting: indicatorFlashInitialAlpha",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Initial alpha value when flashing the visual bell or search wraparound indicator"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor alfa inicial ao piscar a campainha visual ou o indicador de retorno da busca"
          }
        }
      }
    },
    "AdvancedSetting.jiggleTTYSizeOnClearBuffer" : {
      "comment" : "Advanced setting: jiggleTTYSizeOnClearBuffer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Redraw the screen after the Clear Buffer menu item is selected.\nWhen enabled, the TTY size is briefly changed after clearing the buffer to cause the shell or current app to redraw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redesenhar a tela após o item de menu Limpar buffer ser selecionado.\nQuando ativado, o tamanho do TTY é alterado brevemente após limpar o buffer para fazer o shell ou o app atual redesenhar."
          }
        }
      }
    },
    "AdvancedSetting.killJobsInServersOnQuit" : {
      "comment" : "Advanced setting: killJobsInServersOnQuit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "User-initiated Quit (⌘Q) of iTerm2 will kill all running jobs.\nApplies only when session restoration is on."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar o iTerm2 iniciado pelo usuário (⌘Q) encerrará todos os processos em execução.\nAplica-se somente quando a restauração de sessão está ativada."
          }
        }
      }
    },
    "AdvancedSetting.killSessionsOnLogout" : {
      "comment" : "Advanced setting: killSessionsOnLogout",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kill sessions on logout.\nA possible fix for issue 4147."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar sessões ao sair.\nUma possível correção para o problema 4147."
          }
        }
      }
    },
    "AdvancedSetting.lastpassGroups" : {
      "comment" : "Advanced setting: lastpassGroups",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Comma-separated list of LastPass groups for the password manager to look in for passwords."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista separada por vírgulas de grupos do LastPass onde o cofre de senhas deve buscar senhas."
          }
        }
      }
    },
    "AdvancedSetting.laxNilPolicyInInterpolatedStrings" : {
      "comment" : "Advanced setting: laxNilPolicyInInterpolatedStrings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should references to undefined variables in interpolated strings be converted to empty string?\nWhen enabled, an expression in an interpolated string that references an undefined variable will be treated as an empty string. For example, “\\(bogus)”. References to undefined variables as arguments to function calls, such as “\\(f(bogus))”, are still errors."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referências a variáveis indefinidas em strings interpoladas devem ser convertidas em string vazia?\nQuando ativado, uma expressão em uma string interpolada que referencia uma variável indefinida será tratada como uma string vazia. Por exemplo, “\\(bogus)”. Referências a variáveis indefinidas como argumentos de chamadas de função, como “\\(f(bogus))”, ainda são erros."
          }
        }
      }
    },
    "AdvancedSetting.leftAlignTitleBarMinimalTahoe" : {
      "comment" : "Advanced setting: leftAlignTitleBarMinimalTahoe",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Left-align title bar in Minimal and Compact themes in macOS 26 and later?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinhar a barra de título à esquerda nos temas Minimal e Compact no macOS 26 e posterior?"
          }
        }
      }
    },
    "AdvancedSetting.lightModeInactiveTabDarkness" : {
      "comment" : "Advanced setting: lightModeInactiveTabDarkness",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Darkness (in [0…1]) for non-selected tabs in non-Minimal theme in light mode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escurecimento (em [0…1]) para abas não selecionadas no tema não Minimal no modo claro."
          }
        }
      }
    },
    "AdvancedSetting.llmPlatform" : {
      "comment" : "Advanced setting: llmPlatform",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "LLM Platform.\nLegal values are: OpenAI, Azure, Gemini. This determines the format of requests and responses."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plataforma de LLM.\nValores válidos são: OpenAI, Azure, Gemini. Isto determina o formato de requisições e respostas."
          }
        }
      }
    },
    "AdvancedSetting.logAITabTitleCorpus" : {
      "comment" : "Advanced setting: logAITabTitleCorpus",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log AI tab-title generations to a corpus file.\nWhen the AI tab-title component runs the on-device model, append the inputs (foreground job, command line, directory, host, and visible screen), the system prompt used, the model, the generated title, and timing as one JSON line to ~/Library/Application Support/iTerm2/AITabTitleCorpus/corpus.jsonl. Builds a replayable corpus for grading prompts and models offline (see the corpus grader in the AI live harness). WARNING: captures full screen contents verbatim. Off by default; turn on only while collecting data and delete the file when finished."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar as gerações de títulos de aba por IA em um arquivo de corpus.\nQuando o componente de título de aba por IA executa o modelo no dispositivo, anexar as entradas (job em primeiro plano, linha de comando, diretório, host e tela visível), o prompt de sistema usado, o modelo, o título gerado e o tempo como uma única linha JSON em ~/Library/Application Support/iTerm2/AITabTitleCorpus/corpus.jsonl. Cria um corpus reproduzível para avaliar prompts e modelos offline (consulte o avaliador de corpus no harness de IA ao vivo). AVISO: captura todo o conteúdo da tela literalmente. Desativado por padrão; ative apenas ao coletar dados e apague o arquivo ao terminar."
          }
        }
      }
    },
    "AdvancedSetting.logDrawingPerformance" : {
      "comment" : "Advanced setting: logDrawingPerformance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log stats about text drawing performance to console.\nUsed for performance testing."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar estatísticas sobre o desempenho de desenho de texto no console.\nUsado para testes de desempenho."
          }
        }
      }
    },
    "AdvancedSetting.logForegroundJobAncestryDiagnostics" : {
      "comment" : "Advanced setting: logForegroundJobAncestryDiagnostics",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log a detailed trace when a session’s foreground-job ancestor list unexpectedly shrinks.\nWhen an intermediate ancestor (such as the claude CLI) drops out of a tracked session’s foreground-job ancestry for a single process-cache update, log via RLog which pid held the vanished ancestor, whether it is still in the process table, and the full upward walk from the deepest foreground job. Used to diagnose spurious job-ended events that can tear down a Claude Code workgroup. Off by default; turn on only while reproducing an issue."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar um rastreamento detalhado quando a lista de ancestrais do processo em primeiro plano de uma sessão diminui inesperadamente.\nQuando um ancestral intermediário (como a CLI do claude) sai da ancestralidade do processo em primeiro plano de uma sessão monitorada por uma única atualização do cache de processos, registrar via RLog qual pid continha o ancestral desaparecido, se ele ainda está na tabela de processos e o percurso ascendente completo a partir do processo em primeiro plano mais profundo. Usado para diagnosticar eventos espúrios de fim de processo que podem desfazer um workgroup do Claude Code. Desativado por padrão; ative somente ao reproduzir um problema."
          }
        }
      }
    },
    "AdvancedSetting.logNonASCIIStringLengthHistogram" : {
      "comment" : "Advanced setting: logNonASCIIStringLengthHistogram",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log a histogram of non-ASCII string lengths periodically.\nUseful for tuning the async pre-conversion minimum string length."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar periodicamente um histograma dos comprimentos de strings não ASCII.\nÚtil para ajustar o comprimento mínimo de string da pré-conversão assíncrona."
          }
        }
      }
    },
    "AdvancedSetting.logRestorableStateSize" : {
      "comment" : "Advanced setting: logRestorableStateSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log restorable state size info to /tmp/statesize.*.txt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar informações do tamanho do estado restaurável em /tmp/statesize.*.txt."
          }
        }
      }
    },
    "AdvancedSetting.logTimestampFormat" : {
      "comment" : "Advanced setting: logTimestampFormat",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Format for log timestamps. See Unicode TR 35-31 for syntax.\nYou must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato para marcações de data e hora do log. Consulte Unicode TR 35-31 para a sintaxe.\nVocê precisa reiniciar o iTerm2 para que as alterações neste ajuste tenham efeito."
          }
        }
      }
    },
    "AdvancedSetting.logTimestampsWithPlainText" : {
      "comment" : "Advanced setting: logTimestampsWithPlainText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When logging plain text, include timestamps for each line?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao registrar texto simples, incluir marcações de data e hora em cada linha?"
          }
        }
      }
    },
    "AdvancedSetting.logToSyslog" : {
      "comment" : "Advanced setting: logToSyslog",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Debug logs also write to the system log."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os logs de depuração também são gravados no log do sistema."
          }
        }
      }
    },
    "AdvancedSetting.lowFiCombiningMarks" : {
      "comment" : "Advanced setting: lowFiCombiningMarks",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prefer speed to accuracy for characters with combining marks?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferir velocidade à precisão para caracteres com marcas de combinação?"
          }
        }
      }
    },
    "AdvancedSetting.lowPowerModeFrameRate" : {
      "comment" : "Advanced setting: lowPowerModeFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum frame rate (FPS) when low power mode is enabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de quadros máxima (FPS) quando o modo de baixo consumo está ativado."
          }
        }
      }
    },
    "AdvancedSetting.makeSomePowerlineSymbolsWide" : {
      "comment" : "Advanced setting: makeSomePowerlineSymbolsWide",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Draw certain Powerline symbols double-width?\nThis matches how most “nerd” fonts render them, but your favorite one might not do this. An example code point that is affected is U+E0B8."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhar certos símbolos Powerline com largura dupla?\nIsto corresponde à forma como a maioria das fontes “nerd” os renderiza, mas a sua favorita pode não fazer isso. Um exemplo de ponto de código afetado é U+E0B8."
          }
        }
      }
    },
    "AdvancedSetting.maxHistoryLinesToRestore" : {
      "comment" : "Advanced setting: maxHistoryLinesToRestore",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of lines of history to restore.\nWhen the app is relaunched, only the last N lines of history are restored to avoid making launch too slow. If you reduce this number, existing sessions won't be affected until their history is cleared."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de linhas de histórico a restaurar.\nQuando o app é reiniciado, apenas as últimas N linhas de histórico são restauradas para evitar tornar a inicialização muito lenta. Se você reduzir este número, as sessões existentes não serão afetadas até que seu histórico seja limpo."
          }
        }
      }
    },
    "AdvancedSetting.maxSemanticHistoryPrefixOrSuffix" : {
      "comment" : "Advanced setting: maxSemanticHistoryPrefixOrSuffix",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of bytes of text before and after click location to take into account.\nThis also limits the size of the \\3 and \\4 substitutions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de bytes de texto antes e depois do local do clique a considerar.\nIsto também limita o tamanho das substituições \\3 e \\4."
          }
        }
      }
    },
    "AdvancedSetting.maxURLLength" : {
      "comment" : "Advanced setting: maxURLLength",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum length for OSC 8 URLs"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimento máximo para URLs OSC 8"
          }
        }
      }
    },
    "AdvancedSetting.maximumBytesToProvideToPythonAPI" : {
      "comment" : "Advanced setting: maximumBytesToProvideToPythonAPI",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of bytes of selection to provide to Python API.\nA large value here can cause performance issues when you have a big selection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de bytes da seleção a fornecer à API do Python.\nUm valor alto aqui pode causar problemas de desempenho quando você tem uma seleção grande."
          }
        }
      }
    },
    "AdvancedSetting.maximumBytesToProvideToServices" : {
      "comment" : "Advanced setting: maximumBytesToProvideToServices",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of bytes of selection to provide to Services.\nA large value here can cause performance issues when you have a big selection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de bytes da seleção a fornecer aos Serviços.\nUm valor alto aqui pode causar problemas de desempenho quando você tem uma seleção grande."
          }
        }
      }
    },
    "AdvancedSetting.maximumFrameRate" : {
      "comment" : "Advanced setting: maximumFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Frame rate (FPS) when adaptive framerate is enabled and throughput is low but not 0."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de quadros (FPS) quando a taxa de quadros adaptativa está ativada e a taxa de transferência é baixa, mas não 0."
          }
        }
      }
    },
    "AdvancedSetting.maximumNumberOfTriggerCommands" : {
      "comment" : "Advanced setting: maximumNumberOfTriggerCommands",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of trigger-launched commands that can run at once.\nIf too many “Run Command…” triggers fire their commands will be queued. You must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de comandos iniciados por gatilhos que podem ser executados ao mesmo tempo.\nSe muitos gatilhos “Executar comando…” dispararem, seus comandos serão enfileirados. Você precisa reiniciar o iTerm2 para que as alterações neste ajuste tenham efeito."
          }
        }
      }
    },
    "AdvancedSetting.menuTipDelay" : {
      "comment" : "Advanced setting: menuTipDelay",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Time to wait before showing tips in the main menu.\nSet this to a big number if you don’t like the tips."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo de espera antes de mostrar dicas no menu principal.\nDefina um número grande se você não gosta das dicas."
          }
        }
      }
    },
    "AdvancedSetting.metalRedrawPeriod" : {
      "comment" : "Advanced setting: metalRedrawPeriod",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "GPU renderer redraws at least this often, in seconds.\nThis is to work around a problem where the GPU renderer encounters a lot of latency when drawing for the first time after a short period of inactivity. Set this to a big number to render it ineffectual."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O renderizador de GPU redesenha pelo menos com esta frequência, em segundos.\nIsto serve para contornar um problema em que o renderizador de GPU encontra muita latência ao desenhar pela primeira vez após um curto período de inatividade. Defina um número grande para torná-lo ineficaz."
          }
        }
      }
    },
    "AdvancedSetting.metalRowOutputCacheEnabled" : {
      "comment" : "Advanced setting: metalRowOutputCacheEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cache per-row GPU build output?\nSkips rebuilding the glyph and color data for rows whose content and configuration have not changed since the last frame. Experimental."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenar em cache a saída de construção da GPU por linha?\nIgnora a reconstrução dos dados de glifos e cores para linhas cujo conteúdo e configuração não mudaram desde o último quadro. Experimental."
          }
        }
      }
    },
    "AdvancedSetting.metalSlowFrameRate" : {
      "comment" : "Advanced setting: metalSlowFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When adaptive framerate is enabled and using the Metal renderer, refresh at this rate during high throughput conditions (FPS)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a taxa de quadros adaptativa está ativada e usando o renderizador Metal, atualizar nesta taxa durante condições de alta taxa de transferência (FPS)."
          }
        }
      }
    },
    "AdvancedSetting.metalSynchronizedDrawing" : {
      "comment" : "Advanced setting: metalSynchronizedDrawing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use synchronized Metal drawable presentation?\nDefers drawable acquisition until rendering completes, presents synchronously with Core Animation, and acquires drawables on the private render queue. May improve frame rates."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar apresentação sincronizada de drawable do Metal?\nAdia a aquisição do drawable até a renderização terminar, apresenta de forma sincronizada com o Core Animation e adquire drawables na fila de renderização privada. Pode melhorar as taxas de quadros."
          }
        }
      }
    },
    "AdvancedSetting.middleClickClosesTab" : {
      "comment" : "Advanced setting: middleClickClosesTab",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should middle-click on a tab in the tab bar close the tab?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O clique com o botão do meio em uma aba na barra de abas deve fechar a aba?"
          }
        }
      }
    },
    "AdvancedSetting.minCompactTabWidth" : {
      "comment" : "Advanced setting: minCompactTabWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum tab width when using uneven tab widths for compact tabs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura mínima da aba ao usar larguras de abas desiguais para abas compactas."
          }
        }
      }
    },
    "AdvancedSetting.minRunningTime" : {
      "comment" : "Advanced setting: minRunningTime",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grace period for automatic quitting after the last window is closed.\nIf iTerm2 is configured to quit automatically when the last window is closed, this setting gives a grace period (in seconds) after startup where that feature is disabled. Set to 0 to have no grace period."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Período de carência para encerramento automático após a última janela ser fechada.\nSe o iTerm2 estiver configurado para encerrar automaticamente quando a última janela for fechada, este ajuste concede um período de carência (em segundos) após a inicialização durante o qual esse recurso fica desativado. Defina como 0 para não ter período de carência."
          }
        }
      }
    },
    "AdvancedSetting.minTabWidth" : {
      "comment" : "Advanced setting: minTabWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum tab width when using uneven tab widths."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura mínima da aba ao usar larguras de abas desiguais."
          }
        }
      }
    },
    "AdvancedSetting.minimalDeslectedColoredTabAlpha" : {
      "comment" : "Advanced setting: minimalDeslectedColoredTabAlpha",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alpha value for tab color for non-selected colored tabs in the Minimal theme.\nMust be between 0 and 1."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor alfa da cor da aba para abas coloridas não selecionadas no tema Minimal.\nDeve estar entre 0 e 1."
          }
        }
      }
    },
    "AdvancedSetting.minimalEdgeDragSize" : {
      "comment" : "Advanced setting: minimalEdgeDragSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal theme, you can move the window by dragging starting in a region on the edge near the window border. This gives the size of that region."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Minimal, você pode mover a janela arrastando a partir de uma região na borda próxima ao limite da janela. Isto define o tamanho dessa região."
          }
        }
      }
    },
    "AdvancedSetting.minimalSelectedTabUnderlineProminence" : {
      "comment" : "Advanced setting: minimalSelectedTabUnderlineProminence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prominence of selected tab underline indicator in the Minimal theme when there is at least one colored tab."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaque do indicador de sublinhado da aba selecionada no tema Minimal quando há pelo menos uma aba colorida."
          }
        }
      }
    },
    "AdvancedSetting.minimalSplitPaneDividerProminence" : {
      "comment" : "Advanced setting: minimalSplitPaneDividerProminence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal theme, how prominent should split pane dividers be?\nTakes a value in 0 to 1, where 0 is invisible and 1 is very prominent"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Minimal, quão destacados devem ser os divisores de painéis?\nAceita um valor de 0 a 1, onde 0 é invisível e 1 é muito destacado"
          }
        }
      }
    },
    "AdvancedSetting.minimalTabStyleBackgroundColorDifference" : {
      "comment" : "Advanced setting: minimalTabStyleBackgroundColorDifference",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal theme, how different should the background color of the selected tab be from the others?\nTakes a value in 0 to 1, where 0 is no difference and 1 very different."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Minimal, quão diferente deve ser a cor de fundo da aba selecionada em relação às outras?\nAceita um valor de 0 a 1, onde 0 é nenhuma diferença e 1 é muito diferente."
          }
        }
      }
    },
    "AdvancedSetting.minimalTabStyleOutlineStrength" : {
      "comment" : "Advanced setting: minimalTabStyleOutlineStrength",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal theme, how prominent should the tab outline be?\nTakes a value in 0 to 1, where 0 is invisible and 1 is very prominent"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Minimal, quão destacado deve ser o contorno da aba?\nAceita um valor de 0 a 1, onde 0 é invisível e 1 é muito destacado"
          }
        }
      }
    },
    "AdvancedSetting.minimalTabStyleTreatLeftInsetAsPartOfFirstTab" : {
      "comment" : "Advanced setting: minimalTabStyleTreatLeftInsetAsPartOfFirstTab",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal theme, should the area left of the tab bar be treated as part of the first tab?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Minimal, a área à esquerda da barra de abas deve ser tratada como parte da primeira aba?"
          }
        }
      }
    },
    "AdvancedSetting.minimalTextLegibilityAdjustment" : {
      "comment" : "Advanced setting: minimalTextLegibilityAdjustment",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How much should contrast be increased for text in tabs in the Minimal theme?\nChoose a value larger than 1 to increase contrast. Values between 0 and 1 have less contrast than the default."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o contraste deve ser aumentado para o texto nas abas no tema Minimal?\nEscolha um valor maior que 1 para aumentar o contraste. Valores entre 0 e 1 têm menos contraste que o padrão."
          }
        }
      }
    },
    "AdvancedSetting.minimumTabDragDistance" : {
      "comment" : "Advanced setting: minimumTabDragDistance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How far must the mouse move before a tab drag is initiated?\nYou must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o mouse precisa se mover antes que o arrasto de uma aba seja iniciado?\nVocê precisa reiniciar o iTerm2 após alterar este ajuste para que ele tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.minimumTabLabelWidth" : {
      "comment" : "Advanced setting: minimumTabLabelWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum width for tab labels.\nThe activity/bell icon will be hidden when the space for the label drops below this size (in points)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura mínima para os rótulos das abas.\nO ícone de atividade/campainha ficará oculto quando o espaço para o rótulo ficar abaixo deste tamanho (em pontos)"
          }
        }
      }
    },
    "AdvancedSetting.minimumWeightDifferenceForBoldFont" : {
      "comment" : "Advanced setting: minimumWeightDifferenceForBoldFont",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum weight difference between regular and bold font.\nThis affects selection of the bold version of a font. Font weights go from 0 to 9. If no font can be found that has a high enough weight then the regular font will be double-struck with a small offset."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferença mínima de peso entre a fonte normal e a fonte em negrito.\nIsto afeta a seleção da versão em negrito de uma fonte. Os pesos de fonte vão de 0 a 9. Se nenhuma fonte com peso suficientemente alto for encontrada, a fonte normal será desenhada duas vezes com um pequeno deslocamento."
          }
        }
      }
    },
    "AdvancedSetting.moveLeftAfterClosingTab" : {
      "comment" : "Advanced setting: moveLeftAfterClosingTab",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select the tab to the left when closing a tab?\nIf disabled, the tab to the right of the closing tab will be selected."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecionar a aba à esquerda ao fechar uma aba?\nSe desativado, a aba à direita da aba que está sendo fechada será selecionada."
          }
        }
      }
    },
    "AdvancedSetting.multiserver" : {
      "comment" : "Advanced setting: multiserver",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable multi-server daemon.\nA new implementation of session restoration that combines daemon processes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar o daemon de múltiplos servidores.\nUma nova implementação da restauração de sessão que combina processos daemon."
          }
        }
      }
    },
    "AdvancedSetting.nativeRenderingCSSDark" : {
      "comment" : "Advanced setting: nativeRenderingCSSDark",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Path to CSS file to customize native drawing (for dark background colors)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminho para o arquivo CSS para personalizar o desenho nativo (para cores de fundo escuras)."
          }
        }
      }
    },
    "AdvancedSetting.nativeRenderingCSSLight" : {
      "comment" : "Advanced setting: nativeRenderingCSSLight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Path to CSS file to customize native drawing (for light background colors)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminho para o arquivo CSS para personalizar o desenho nativo (para cores de fundo claras)."
          }
