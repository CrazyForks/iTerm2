    "PTYSession.SlowTmuxResponseBody" : {
      "comment" : "Warning that tmux is slow to respond and how to adjust the line terminator setting",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's taking a long time for tmux to respond. If this is a old or funky system it might expect newline rather than carriage return to end commands. You can adjust the line terminator used by tmux integration in Settings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tmux está demorando muito para responder. Se este for um sistema antigo ou peculiar, ele pode esperar um caractere de nova linha em vez de retorno de carro para encerrar comandos. Você pode ajustar o terminador de linha usado pela integração do tmux nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 响应时间过长。如果这是较旧或异常的系统，它可能期望用换行符而非回车符结束命令。你可以在设置中调整 tmux 集成使用的行终止符。"
          }
        }
      }
    },
