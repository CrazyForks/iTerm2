    "AdvancedSetting.pythonRuntimeBetaDownloadURL" : {
      "comment" : "Advanced setting: pythonRuntimeBetaDownloadURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL to check for new Beta versions of the Python scripting runtime."
          }
