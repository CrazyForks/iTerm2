    "ChatAgent.AutoProvideBody" : {
      "comment" : "Body text of the dialog asking whether to automatically share terminal contents with AI chats",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can include this session’s visible screen and terminal state with every message you send in AI chats where you’ve allowed it, so the assistant sees what you see. You can turn this off any time from a chat’s permission settings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode incluir a tela visível e o estado do terminal desta sessão em cada mensagem que você envia nos chats de IA onde você permitiu, para que o assistente veja o que você vê. Você pode desativar isso a qualquer momento nos ajustes de permissão de um chat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以在你允许的 AI 聊天中，将每条消息附带该会话的可见屏幕和终端状态，以便助手看到你所看到的内容。你可以随时在聊天的权限设置中关闭此功能。"
          }
        }
      }
    },
