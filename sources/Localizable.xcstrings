      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open Quickly (⇧⌘O) is now a command palette! Just type the name of a menu item to activate it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
