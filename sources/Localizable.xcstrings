    "ChatViewController.EnableOrchestration" : {
      "comment" : "Button to enable orchestration mode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable Orchestration"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar orquestração"
          }
