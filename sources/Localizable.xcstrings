      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn on “Edit > Selection Respects Soft Boundaries” to recognize split pane dividers in programs like vi, emacs, and tmux so you can select multiple lines of text."
          }
