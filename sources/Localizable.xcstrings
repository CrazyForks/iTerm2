    "AdvancedSetting.pythonRuntimeDownloadURL" : {
      "comment" : "Advanced setting: pythonRuntimeDownloadURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL to check for new versions of the Python scripting runtime."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL para verificar novas versões do runtime de scripts do Python."
          }
        }
      }
    },
    "AdvancedSetting.pythonRuntimeUsesUV" : {
      "comment" : "Advanced setting: pythonRuntimeUsesUV",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use uv to provision the Python runtime for API scripts?\nWhen enabled, iTerm2 uses uv to download Python and build per-script environments instead of the bundled Python runtime. Scripts already provisioned continue to run regardless of this setting; it only affects creating, importing, and migrating scripts."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o uv para provisionar o runtime do Python para scripts da API?\nQuando ativado, o iTerm2 usa o uv para baixar o Python e criar ambientes por script em vez do runtime do Python incorporado. Scripts já provisionados continuam a ser executados independentemente deste ajuste; ele afeta apenas a criação, importação e migração de scripts."
          }
        }
      }
    },
    "AdvancedSetting.quickPasteBytesPerCall" : {
      "comment" : "Advanced setting: quickPasteBytesPerCall",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Number of bytes to paste in each chunk when pasting normally."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de bytes a colar em cada bloco ao colar normalmente."
          }
        }
      }
    },
    "AdvancedSetting.quickPasteDelayBetweenCalls" : {
      "comment" : "Advanced setting: quickPasteDelayBetweenCalls",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay in seconds between chunks when pasting normally."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso em segundos entre blocos ao colar normalmente."
          }
        }
      }
    },
    "AdvancedSetting.remapModifiersWithoutEventTap" : {
      "comment" : "Advanced setting: remapModifiersWithoutEventTap",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable remapping modifiers for system shortcuts.\nThis prevents asking for accessibility permission. It breaks remapping system shortcuts like cmd-tab."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar o remapeamento de modificadores para atalhos do sistema.\nIsto evita solicitar permissão de acessibilidade. Isto quebra o remapeamento de atalhos do sistema como cmd-tab."
          }
        }
      }
    },
    "AdvancedSetting.rememberTmuxWindowSizes" : {
      "comment" : "Advanced setting: rememberTmuxWindowSizes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remember window sizes in tmux integration?\nRequires tmux 2.9 or later. The “variable window size” advanced setting must be enabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembrar os tamanhos das janelas na integração do tmux?\nRequer tmux 2.9 ou posterior. O ajuste avançado “tamanho de janela variável” deve estar ativado."
          }
        }
      }
    },
    "AdvancedSetting.removeAddTabButton" : {
      "comment" : "Advanced setting: removeAddTabButton",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove the “new tab” button from horizontal tab bars?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover o botão “nova aba” das barras de abas horizontais?"
          }
        }
      }
    },
    "AdvancedSetting.reportOnFirstMouse" : {
      "comment" : "Advanced setting: reportOnFirstMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Send mouse reports when you click in a window that isn't already frontmouse?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar relatos de mouse ao clicar em uma janela que ainda não está sob o foco do mouse?"
          }
        }
      }
    },
    "AdvancedSetting.requireCmdForDraggingText" : {
      "comment" : "Advanced setting: requireCmdForDraggingText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To drag images or selected text, you must hold ⌘. This prevents accidental drags."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para arrastar imagens ou texto selecionado, você precisa manter ⌘ pressionado. Isto evita arrastos acidentais."
          }
        }
      }
    },
    "AdvancedSetting.requireOptionToDragSplitPaneTitleBar" : {
      "comment" : "Advanced setting: requireOptionToDragSplitPaneTitleBar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Require Option to be pressed to drag a split pane by its title bar?\nThis helps prevent accidental drags."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigir que Option esteja pressionado para arrastar um painel dividido pela sua barra de título?\nIsto ajuda a evitar arrastos acidentais."
          }
        }
      }
    },
    "AdvancedSetting.requireSlashInURLGuess" : {
      "comment" : "Advanced setting: requireSlashInURLGuess",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only consider a two+ part domain-name to be a URL if it also contains a slash.\nThis setting is used when guessing if a string is a URL for semantic history. When enabled, `example.com` would not be considered a URL but `example.com/` would be."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considerar um nome de domínio com duas ou mais partes como URL apenas se também contiver uma barra.\nEste ajuste é usado ao adivinhar se uma string é uma URL para o Semantic History. Quando ativado, `example.com` não seria considerado uma URL, mas `example.com/` seria."
          }
        }
      }
    },
    "AdvancedSetting.resetSGROnPrompt" : {
      "comment" : "Advanced setting: resetSGROnPrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reset colors at shell prompt?\nUses shell integration to detect a shell prompt and, if enabled, resets colors to their defaults."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefinir as cores no prompt do shell?\nUsa o Shell Integration para detectar um prompt do shell e, se ativado, redefine as cores para os padrões."
          }
        }
      }
    },
    "AdvancedSetting.restoreKeyModeAutomaticallyOnHostChange" : {
      "comment" : "Advanced setting: restoreKeyModeAutomaticallyOnHostChange",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatically restore keyboard mode when an ssh session ends?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar automaticamente o modo de teclado quando uma sessão ssh termina?"
          }
        }
      }
    },
    "AdvancedSetting.restoreWindowContents" : {
      "comment" : "Advanced setting: restoreWindowContents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Restore window contents at startup.\nThis requires “System Settings > Desktop & Dock > Close windows when quitting an app” to be off."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar o conteúdo das janelas na inicialização.\nIsto requer que “Ajustes do Sistema > Mesa e Dock > Fechar janelas ao encerrar um app” esteja desativado."
          }
        }
      }
    },
    "AdvancedSetting.restoreWindowsWithinScreens" : {
      "comment" : "Advanced setting: restoreWindowsWithinScreens",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When restoring a window arrangement, ensure windows are entirely within the bounds of the current displays."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao restaurar um arranjo de janelas, garantir que as janelas fiquem inteiramente dentro dos limites das telas atuais."
          }
        }
      }
    },
    "AdvancedSetting.restrictSemanticHistoryPrefixAndSuffixToLogicalWindow" : {
      "comment" : "Advanced setting: restrictSemanticHistoryPrefixAndSuffixToLogicalWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Respect soft boundaries for computing the prefix and suffix text passed to semantic history commands?\nDue to a long-standing bug this did not used to be respected. Soft boundaries were always respected for deciding what text was clicked on, but the prefix and suffix did not. If you have a semantic history command that depends on the bug, you can switch this off to get the pre-3.1.2 behavior."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respeitar limites flexíveis ao calcular o texto de prefixo e sufixo passado aos comandos do Semantic History?\nDevido a um bug antigo, isto não costumava ser respeitado. Os limites flexíveis eram sempre respeitados para decidir em qual texto foi clicado, mas o prefixo e o sufixo não. Se você tem um comando do Semantic History que depende do bug, pode desativar isto para obter o comportamento anterior à 3.1.2."
          }
        }
      }
    },
    "AdvancedSetting.retinaInlineImages" : {
      "comment" : "Advanced setting: retinaInlineImages",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show inline images at Retina resolution."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar imagens embutidas na resolução Retina."
          }
        }
      }
    },
    "AdvancedSetting.revealExportedSettingsAndData" : {
      "comment" : "Advanced setting: revealExportedSettingsAndData",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reveal file created by “Export All Settings and Data” in finder upon completion"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revelar no Finder o arquivo criado por “Exportar todos os ajustes e dados” ao concluir"
          }
        }
      }
    },
    "AdvancedSetting.rightJustifyRTLLines" : {
      "comment" : "Advanced setting: rightJustifyRTLLines",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Right-justify lines in paragraphs with base writing direction of right-to-left?\nRequires BOTH “right-to-left text support” and “auto-detect paragraph writing detection” to be enabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justificar à direita as linhas em parágrafos com direção de escrita base da direita para a esquerda?\nRequer que TANTO “suporte a texto da direita para a esquerda” QUANTO “detecção automática de direção de escrita de parágrafo” estejam ativados."
          }
        }
      }
    },
    "AdvancedSetting.runJobsInServers" : {
      "comment" : "Advanced setting: runJobsInServers",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable session restoration.\nSession restoration runs jobs in separate processes. They will survive crashes, force quits, and upgrades.\nYou must restart iTerm2 for this change to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar a restauração de sessão.\nA restauração de sessão executa tarefas em processos separados. Eles sobreviverão a falhas, encerramentos forçados e atualizações.\nVocê precisa reiniciar o iTerm2 para que esta alteração tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.saveProfilesToRecentDocuments" : {
      "comment" : "Advanced setting: saveProfilesToRecentDocuments",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add items to Recents (in the dock icon's menu) to reopen recently used profiles as tabs?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar itens aos Recentes (no menu do ícone do dock) para reabrir perfis usados recentemente como abas?"
          }
        }
      }
    },
    "AdvancedSetting.saveScrollBufferWhenClearing" : {
      "comment" : "Advanced setting: saveScrollBufferWhenClearing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save scroll buffer when clearing screen.\nWhen enabled, saves the current screen into scroll back buffer instead of clearing it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar o buffer de rolagem ao limpar a tela.\nQuando ativado, salva a tela atual no buffer de histórico de rolagem em vez de limpá-la."
          }
        }
      }
    },
    "AdvancedSetting.saveScrollbackWhenCursorMovesAbovePrompt" : {
      "comment" : "Advanced setting: saveScrollbackWhenCursorMovesAbovePrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the screen to scrollback when an app moves the cursor above the prompt.\nSome full-screen programs that don’t use the alternate screen buffer repaint by moving the cursor to the top of the screen and overwriting whatever was already there, destroying content you can still see. When enabled, iTerm2 first scrolls the visible screen into history so that content isn’t lost. Requires shell integration."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar a tela no histórico de rolagem quando um app move o cursor acima do prompt.\nAlguns programas de tela cheia que não usam o buffer de tela alternativo redesenham movendo o cursor para o topo da tela e sobrescrevendo o que já estava lá, destruindo conteúdo que você ainda pode ver. Quando ativado, o iTerm2 primeiro rola a tela visível para o histórico para que o conteúdo não seja perdido. Requer o Shell Integration."
          }
        }
      }
    },
    "AdvancedSetting.saveToPasteHistoryWhenSecureInputEnabled" : {
      "comment" : "Advanced setting: saveToPasteHistoryWhenSecureInputEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save to paste history when secure keyboard input is enabled?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar no histórico de colagem quando a entrada segura de teclado está ativada?"
          }
        }
      }
    },
    "AdvancedSetting.screenshotMaxPixelHeight" : {
      "comment" : "Advanced setting: screenshotMaxPixelHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum pixel height for a single screenshot file.\nScreenshots taller than this will be split into multiple files. Also affects the maximum total pixels (this value squared / 5)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima em pixels para um único arquivo de captura de tela.\nCapturas de tela mais altas que isto serão divididas em múltiplos arquivos. Também afeta o total máximo de pixels (este valor ao quadrado / 5)."
          }
        }
      }
    },
    "AdvancedSetting.screenshotSaveLocation" : {
      "comment" : "Advanced setting: screenshotSaveLocation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Folder where the “Save” button in the screenshot window writes files.\nLeave empty to save to the Desktop. The “Save As…” button ignores this and always prompts for a location."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta onde o botão “Salvar” na janela de captura de tela grava os arquivos.\nDeixe vazio para salvar na Mesa. O botão “Salvar como…” ignora isto e sempre solicita um local."
          }
        }
      }
    },
    "AdvancedSetting.scrollWheelAcceleration" : {
      "comment" : "Advanced setting: scrollWheelAcceleration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Speed up scroll gestures by this factor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acelerar os gestos de rolagem por este fator."
          }
        }
      }
    },
    "AdvancedSetting.scrollableTabWidth" : {
      "comment" : "Advanced setting: scrollableTabWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tab width when the tab bar is scrollable.\nUsed as the fixed width when tabs are equally sized, and as the minimum width when uneven tab widths are allowed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura da aba quando a barra de abas é rolável.\nUsada como a largura fixa quando as abas têm o mesmo tamanho, e como a largura mínima quando larguras de abas desiguais são permitidas."
          }
        }
      }
    },
    "AdvancedSetting.searchCommand" : {
      "comment" : "Advanced setting: searchCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Template for URL of search engine.\niTerm2 replaces the string “%@” with the text to search for. Query parameter percent escaping is used."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo para a URL do mecanismo de busca.\nO iTerm2 substitui a string “%@” pelo texto a buscar. É usado o escape de porcentagem para parâmetros de consulta."
          }
        }
      }
    },
    "AdvancedSetting.searchSuggestURL" : {
      "comment" : "Advanced setting: searchSuggestURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Template of URL for typeahead search suggestions.\niTerm replaces the string “%@” with the text to search for. Query parameter percent escaping is used."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo de URL para sugestões de busca antecipada.\nO iTerm substitui a string “%@” pelo texto a buscar. É usado o escape de porcentagem para parâmetros de consulta."
          }
        }
      }
    },
    "AdvancedSetting.selectsTabsOnMouseDown" : {
      "comment" : "Advanced setting: selectsTabsOnMouseDown",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select tabs on mouse-down?\nChanging this setting will not affect existing windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecionar abas ao pressionar o mouse?\nAlterar este ajuste não afetará as janelas existentes."
          }
        }
      }
    },
    "AdvancedSetting.sensitiveScrollWheel" : {
      "comment" : "Advanced setting: sensitiveScrollWheel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll on any scroll wheel movement, no matter how small?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolar a qualquer movimento da roda de rolagem, por menor que seja?"
          }
        }
      }
    },
    "AdvancedSetting.serializeOpeningMultipleFullScreenWindows" : {
      "comment" : "Advanced setting: serializeOpeningMultipleFullScreenWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When opening multiple fullscreen windows, enter fullscreen one window at a time."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao abrir múltiplas janelas em tela cheia, entrar em tela cheia uma janela de cada vez."
          }
        }
      }
    },
    "AdvancedSetting.sessionEndMessageDividerCharacter" : {
      "comment" : "Advanced setting: sessionEndMessageDividerCharacter",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Character to use for divider lines in session end messages. Leave empty to use secure default (BrokenPipeDivider image). Examples: ━ ─ ═ ╌ ┄"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractere a usar nas linhas divisórias das mensagens de fim de sessão. Deixe vazio para usar o padrão seguro (imagem BrokenPipeDivider). Exemplos: ━ ─ ═ ╌ ┄"
          }
        }
      }
    },
    "AdvancedSetting.sessionEndMessageText" : {
      "comment" : "Advanced setting: sessionEndMessageText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text displayed when a session ends. Leave empty to use default."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto exibido quando uma sessão termina. Deixe vazio para usar o padrão."
          }
        }
      }
    },
    "AdvancedSetting.sessionFinishedMessageText" : {
      "comment" : "Advanced setting: sessionFinishedMessageText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text displayed when a short-lived session finishes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto exibido quando uma sessão de curta duração termina."
          }
        }
      }
    },
    "AdvancedSetting.sessionRestartedMessageText" : {
      "comment" : "Advanced setting: sessionRestartedMessageText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text displayed when a session is restarted."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto exibido quando uma sessão é reiniciada."
          }
        }
      }
    },
    "AdvancedSetting.setCookie" : {
      "comment" : "Advanced setting: setCookie",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set ITERM2_COOKIE environment variable, allowing Python scripts to be launched without confirmation?\nThis will only affect sessions created after changing this setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definir a variável de ambiente ITERM2_COOKIE, permitindo que scripts do Python sejam iniciados sem confirmação?\nIsto afetará apenas as sessões criadas após alterar este ajuste."
          }
        }
      }
    },
    "AdvancedSetting.setIT2AppPath" : {
      "comment" : "Advanced setting: setIT2AppPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set IT2_APP_PATH environment variable on new sessions, pointing at this iTerm2 build’s app bundle?\nThis disambiguates the AppleScript target when multiple iTerm2 builds with the same bundle identifier are running, so that the “it2” CLI requests its cookie from this iTerm2 instance. Intended for iTerm2 developers. Only affects sessions created after changing this setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definir a variável de ambiente IT2_APP_PATH em novas sessões, apontando para o app bundle deste build do iTerm2?\nIsto desambigua o alvo do AppleScript quando múltiplos builds do iTerm2 com o mesmo identificador de bundle estão em execução, para que a CLI “it2” solicite seu cookie a esta instância do iTerm2. Destinado a desenvolvedores do iTerm2. Afeta apenas as sessões criadas após alterar este ajuste."
          }
        }
      }
    },
    "AdvancedSetting.shortLivedSessionDuration" : {
      "comment" : "Advanced setting: shortLivedSessionDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warn about short-lived sessions that live less than this many seconds."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar sobre sessões de curta duração que duram menos que este número de segundos."
          }
        }
      }
    },
    "AdvancedSetting.shouldSetLCTerminal" : {
      "comment" : "Advanced setting: shouldSetLCTerminal",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set LC_TERMINAL=iTerm2.\nopenssh and mosh pass this to hosts you connect to. It communicates the current terminal emulator. This is useful for enabling terminal emulator-specific features."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definir LC_TERMINAL=iTerm2.\nO openssh e o mosh passam isto para os hosts aos quais você se conecta. Comunica o emulador de terminal atual. Isto é útil para ativar recursos específicos do emulador de terminal."
          }
        }
      }
    },
    "AdvancedSetting.shouldSetTerminfoDirs" : {
      "comment" : "Advanced setting: shouldSetTerminfoDirs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set $TERMINFO_DIRS to add modern terminal features to xterm-like $TERMs?\niTerm2 ships with extended terminfo capabilities for common TERMs (xterm, xterm-new, and xterm-256color). For example, it enables undercurl. New sessions get created with a TERMINFO_DIRS that make the customized TERMINFOs take precedence over the system defaults."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definir $TERMINFO_DIRS para adicionar recursos modernos de terminal a $TERMs semelhantes ao xterm?\nO iTerm2 vem com recursos de terminfo estendidos para TERMs comuns (xterm, xterm-new e xterm-256color). Por exemplo, ele ativa o undercurl. Novas sessões são criadas com um TERMINFO_DIRS que faz os TERMINFOs personalizados terem precedência sobre os padrões do sistema."
          }
        }
      }
    },
    "AdvancedSetting.showAutomaticProfileSwitchingBanner" : {
      "comment" : "Advanced setting: showAutomaticProfileSwitchingBanner",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show a “Switched to profile” message when Automatic Profile Switching activates."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar uma mensagem “Alternou para o perfil” quando a troca automática de perfil for ativada."
          }
        }
      }
    },
    "AdvancedSetting.showBlockBoundaries" : {
      "comment" : "Advanced setting: showBlockBoundaries",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show line buffer block boundaries (issue 6207)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar limites de bloco do buffer de linha (issue 6207)"
          }
        }
      }
    },
    "AdvancedSetting.showButtonsForSelectedCommand" : {
      "comment" : "Advanced setting: showButtonsForSelectedCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show buttons at the top of a selected command?\nWhen you select a command by single clicking the command line or its output, buttons are shown on the top right with options like Copy and Share. Note that this setting only applies when marks are not “line style” such as when using Auto Composer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar botões no topo de um comando selecionado?\nQuando você seleciona um comando com um único clique na linha de comando ou na sua saída, botões são exibidos no canto superior direito com opções como Copiar e Compartilhar. Observe que este ajuste só se aplica quando as marcas não são de “estilo de linha”, como ao usar o Auto Compositor."
          }
        }
      }
    },
    "AdvancedSetting.showDirtyRectsInLegacyRenderer" : {
      "comment" : "Advanced setting: showDirtyRectsInLegacyRenderer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Outline dirty rects in the legacy renderer with random colors.\nUseful for visually verifying which regions of the text view are being repainted each frame. This affects only the legacy (non-GPU) renderer and does nothing when the GPU (Metal) renderer is active, so it is not a way to tell whether the GPU renderer is engaged. To use it, first turn off the GPU renderer in Settings → General → Magic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contornar retângulos sujos no renderizador legado com cores aleatórias.\nÚtil para verificar visualmente quais regiões da área de texto estão sendo redesenhadas a cada quadro. Isso afeta apenas o renderizador legado (não GPU) e não faz nada quando o renderizador de GPU (Metal) está ativo, portanto não é uma forma de saber se o renderizador de GPU está em uso. Para usá-lo, primeiro desative o renderizador de GPU em Ajustes → Geral → Magic."
          }
        }
      }
    },
    "AdvancedSetting.showHintsInSplitPaneMenuItems" : {
      "comment" : "Advanced setting: showHintsInSplitPaneMenuItems",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show hints in split pane menu items to indicate horizontal vs vertical semantics.\nYou must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar dicas nos itens de menu de divisão de painel para indicar a semântica horizontal vs. vertical.\nVocê deve reiniciar o iTerm2 após alterar este ajuste para que ele tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.showLocationsInScrollbar" : {
      "comment" : "Advanced setting: showLocationsInScrollbar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show search result and prompt locations in scroll bar.\nChanging this setting will not affect existing sessions until you restart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar localizações de resultados de busca e prompts na barra de rolagem.\nAlterar este ajuste não afetará as sessões existentes até você reiniciar."
          }
        }
      }
    },
    "AdvancedSetting.showMarksInScrollbar" : {
      "comment" : "Advanced setting: showMarksInScrollbar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show prompt locations in scroll bar?\nChanging this setting will not affect existing sessions until you restart. You must also enable “Show search result and prompt locations in scroll bar” for this to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar localizações de prompts na barra de rolagem?\nAlterar este ajuste não afetará as sessões existentes até você reiniciar. Você também deve ativar “Mostrar localizações de resultados de busca e prompts na barra de rolagem” para que isso tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.showMetalFPSmeter" : {
      "comment" : "Advanced setting: showMetalFPSmeter",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show FPS meter\nRequires Metal renderer"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar medidor de FPS\nRequer o renderizador Metal"
          }
        }
      }
    },
    "AdvancedSetting.showPinnedIndicator" : {
      "comment" : "Advanced setting: showPinnedIndicator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show indicator for pinned hotkey windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar indicador para janelas de hotkey fixadas."
          }
        }
      }
    },
    "AdvancedSetting.showSecureKeyboardEntryIndicator" : {
      "comment" : "Advanced setting: showSecureKeyboardEntryIndicator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show secure keyboard entry indicator?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar indicador de entrada de teclado segura?"
          }
        }
      }
    },
    "AdvancedSetting.showSessionRestoredBanner" : {
      "comment" : "Advanced setting: showSessionRestoredBanner",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When restoring a session without restoring a running job, draw a banner saying “Session Contents Restored” below the restored contents."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao restaurar uma sessão sem restaurar um processo em execução, desenhar um banner dizendo “Conteúdo da sessão restaurado” abaixo do conteúdo restaurado."
          }
        }
      }
    },
    "AdvancedSetting.showSuiteNameInDockIcon" : {
      "comment" : "Advanced setting: showSuiteNameInDockIcon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Overlay the suite name on the dock icon when launched with -suite.\nWhen you run an isolated instance with the -suite argument, its name is drawn across the lower third of the dock icon so you can tell instances apart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrepor o nome do suite no ícone do dock ao iniciar com -suite.\nQuando você executa uma instância isolada com o argumento -suite, o nome dela é desenhado no terço inferior do ícone do dock para que você possa distinguir as instâncias."
          }
        }
      }
    },
    "AdvancedSetting.showURLPreviewForSemanticHistory" : {
      "comment" : "Advanced setting: showURLPreviewForSemanticHistory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show URL preview on cmd-hover for semantic history matches."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar pré-visualização de URL ao passar o cursor com cmd para correspondências do Semantic History."
          }
        }
      }
    },
    "AdvancedSetting.showWindowNameBesideTabs" : {
      "comment" : "Advanced setting: showWindowNameBesideTabs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the window name beside the tabs in the Compact and Minimal themes?\nThose themes have no title bar, so the window name is otherwise only visible when the tab bar is hidden. “When a custom name is set” (the default) shows it only after you name the window with Window > Edit Window Title, leaving windows you have not named unchanged. “Always” also shows the automatic title. This has no effect in themes that have a title bar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o nome da janela ao lado das abas nos temas Compact e Minimal?\nEsses temas não têm barra de título, então o nome da janela só fica visível quando a barra de abas está oculta. “Quando um nome personalizado é definido” (o padrão) o mostra apenas depois que você nomeia a janela em Janela > Editar título da janela, deixando inalteradas as janelas que você não nomeou. “Sempre” também mostra o título automático. Isto não tem efeito em temas que têm barra de título."
          }
        }
      }
    },
    "AdvancedSetting.showWindowNameBesideTabs.Always" : {
      "comment" : "Window-name-beside-tabs option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Always"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre"
          }
        }
      }
    },
    "AdvancedSetting.showWindowNameBesideTabs.Never" : {
      "comment" : "Window-name-beside-tabs option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Never"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca"
          }
        }
      }
    },
    "AdvancedSetting.showWindowNameBesideTabs.WhenCustom" : {
      "comment" : "Window-name-beside-tabs option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When a custom name is set"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um nome personalizado é definido"
          }
        }
      }
    },
    "AdvancedSetting.showWindowTitleWhenTabBarInvisible" : {
      "comment" : "Advanced setting: showWindowTitleWhenTabBarInvisible",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show window title when the tab bar is not visible?\nWhen disabled, the tab's title will be shown where the window title would normally go."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o título da janela quando a barra de abas não estiver visível?\nQuando desativado, o título da aba será mostrado onde o título da janela normalmente ficaria."
          }
        }
      }
    },
    "AdvancedSetting.showYellowMarkForJobStoppedBySignal" : {
      "comment" : "Advanced setting: showYellowMarkForJobStoppedBySignal",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use a yellow for a Shell Integration prompt mark when the job is stopped by a signal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar amarelo para a marca de prompt do Shell Integration quando o processo for parado por um sinal."
          }
        }
      }
    },
    "AdvancedSetting.silentUserNotifications" : {
      "comment" : "Advanced setting: silentUserNotifications",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "System notifications should be silent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações do sistema devem ser silenciosas."
          }
        }
      }
    },
    "AdvancedSetting.simpleNotifications" : {
      "comment" : "Advanced setting: simpleNotifications",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Omit session identifier from notifications.\nWhen enabled, notifications will only show the message without the session name and tab number prefix."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omitir o identificador da sessão nas notificações.\nQuando ativado, as notificações mostrarão apenas a mensagem, sem o prefixo com o nome da sessão e o número da aba."
          }
        }
      }
    },
    "AdvancedSetting.slowFrameRate" : {
      "comment" : "Advanced setting: slowFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When adaptive framerate is enabled, refresh at this rate during high throughput conditions (FPS).\n Does not apply to Metal renderer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a taxa de quadros adaptável estiver ativada, atualizar nesta taxa durante condições de alta vazão (FPS).\n Não se aplica ao renderizador Metal."
          }
        }
      }
    },
    "AdvancedSetting.slowPasteBytesPerCall" : {
      "comment" : "Advanced setting: slowPasteBytesPerCall",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Number of bytes to paste in each chunk when pasting slowly."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de bytes a colar em cada bloco ao colar lentamente."
          }
        }
      }
    },
    "AdvancedSetting.slowPasteDelayBetweenCalls" : {
      "comment" : "Advanced setting: slowPasteDelayBetweenCalls",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay in seconds between chunks when pasting slowly"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso em segundos entre blocos ao colar lentamente"
          }
        }
      }
    },
    "AdvancedSetting.smartCursorColorBgThreshold" : {
      "comment" : "Advanced setting: smartCursorColorBgThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Threshold for Smart Cursor Color for background color (0 to 1).\n0 means the cursor’s background color will always be the cell’s text color, while 1 means it will always be black or white."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite da cor inteligente do cursor para a cor de plano de fundo (0 a 1).\n0 significa que a cor de plano de fundo do cursor será sempre a cor do texto da célula, enquanto 1 significa que será sempre preto ou branco."
          }
        }
      }
    },
    "AdvancedSetting.smartCursorColorFgThreshold" : {
      "comment" : "Advanced setting: smartCursorColorFgThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Threshold for Smart Cursor Color for text color (0 to 1).\n0 means the cursor’s text color will always be the cell’s background color, while 1 means it will always be black or white."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite da cor inteligente do cursor para a cor do texto (0 a 1).\n0 significa que a cor do texto do cursor será sempre a cor de plano de fundo da célula, enquanto 1 significa que será sempre preto ou branco."
          }
        }
      }
    },
    "AdvancedSetting.smartLoggingWithAutoComposer" : {
      "comment" : "Advanced setting: smartLoggingWithAutoComposer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable more compact logging when using auto composer?\nThis will avoid logging raw data in your prompt and your interactions with it. Instead, the prompt is logged once in plain text and the command is logged when sent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar registro mais compacto ao usar o auto composer?\nIsso evitará registrar dados brutos no seu prompt e suas interações com ele. Em vez disso, o prompt é registrado uma vez em texto simples e o comando é registrado quando enviado."
          }
        }
      }
    },
    "AdvancedSetting.smartSelectionRadius" : {
      "comment" : "Advanced setting: smartSelectionRadius",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of lines before and after the click location to include in smart selection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de linhas antes e depois do local do clique a incluir na seleção inteligente."
          }
        }
      }
    },
    "AdvancedSetting.solidUnderlines" : {
      "comment" : "Advanced setting: solidUnderlines",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use solid underlines?\nWhen disabled, underlines break near text that would intersect them."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar sublinhados contínuos?\nQuando desativado, os sublinhados são interrompidos perto de texto que os cruzaria."
          }
        }
      }
    },
    "AdvancedSetting.splitPaneColor" : {
      "comment" : "Advanced setting: splitPaneColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom color for split pane dividers. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor personalizada para os divisores de painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        }
      }
    },
    "AdvancedSetting.splitPaneDividerWidth" : {
      "comment" : "Advanced setting: splitPaneDividerWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom width for split pane dividers in points (1-5). Set to 0 to use default width."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura personalizada para os divisores de painéis em pontos (1-5). Defina como 0 para usar a largura padrão."
          }
        }
      }
    },
    "AdvancedSetting.splitPaneSourceBorderColor" : {
      "comment" : "Advanced setting: splitPaneSourceBorderColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Color of source pane outer border when moving/swapping a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da borda externa do painel de origem ao mover/trocar um painel dividido.\nDeve ser uma cor no estilo web, #rrggbb. Você também pode usar p3#rrggbb para o espaço de cores p3."
          }
        }
      }
    },
    "AdvancedSetting.splitPaneSourceFillColor" : {
      "comment" : "Advanced setting: splitPaneSourceFillColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Color of source pane fill when moving/swapping a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor do preenchimento do painel de origem ao mover/trocar um painel dividido.\nDeve ser uma cor no estilo web, #rrggbb. Você também pode usar p3#rrggbb para o espaço de cores p3."
          }
        }
      }
    },
    "AdvancedSetting.splitPaneSourceInnerBorderColor" : {
      "comment" : "Advanced setting: splitPaneSourceInnerBorderColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Color of source pane inner border when moving/swapping a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da borda interna do painel de origem ao mover/trocar um painel dividido.\nDeve ser uma cor no estilo web, #rrggbb. Você também pode usar p3#rrggbb para o espaço de cores p3."
          }
        }
      }
    },
    "AdvancedSetting.splitPaneTargetDropBorderColor" : {
      "comment" : "Advanced setting: splitPaneTargetDropBorderColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Color of drop target outer border when dragging a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da borda externa do alvo de soltura ao arrastar um painel dividido.\nDeve ser uma cor no estilo web, #rrggbb. Você também pode usar p3#rrggbb para o espaço de cores p3."
          }
        }
      }
    },
    "AdvancedSetting.splitPaneTargetDropFillColor" : {
      "comment" : "Advanced setting: splitPaneTargetDropFillColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Color of drop target fill when dragging a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor do preenchimento do alvo de soltura ao arrastar um painel dividido.\nDeve ser uma cor no estilo web, #rrggbb. Você também pode usar p3#rrggbb para o espaço de cores p3."
          }
        }
      }
    },
    "AdvancedSetting.splitPaneTargetDropInnerBorderColor" : {
      "comment" : "Advanced setting: splitPaneTargetDropInnerBorderColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Color of drop target inner border when dragging a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da borda interna do alvo de soltura ao arrastar um painel dividido.\nDeve ser uma cor no estilo web, #rrggbb. Você também pode usar p3#rrggbb para o espaço de cores p3."
          }
        }
      }
    },
    "AdvancedSetting.squareWindowCorners" : {
      "comment" : "Advanced setting: squareWindowCorners",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows have square corners.\nThis is only for users who have already hacked macOS to remove rounded corners. You must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas têm cantos quadrados.\nIsto é apenas para usuários que já modificaram o macOS para remover os cantos arredondados. Você deve reiniciar o iTerm2 após alterar este ajuste para que ele tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.sshSchemePath" : {
      "comment" : "Advanced setting: sshSchemePath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command to run when handling an ssh:// URL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando a executar ao processar uma URL ssh://."
          }
        }
      }
    },
    "AdvancedSetting.sshURLsSupportPath" : {
      "comment" : "Advanced setting: sshURLsSupportPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SSH URLs respect the path.\nThey run the command: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLs SSH respeitam o caminho.\nElas executam o comando: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        }
      }
    },
    "AdvancedSetting.startDebugLoggingAutomatically" : {
      "comment" : "Advanced setting: startDebugLoggingAutomatically",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start debug logging automatically when iTerm2 is launched."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar o registro de depuração automaticamente quando o iTerm2 for iniciado."
          }
        }
      }
    },
    "AdvancedSetting.statusBarHeight" : {
      "comment" : "Advanced setting: statusBarHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Height of the status bar in points.\nThis will also affect the height of per-pane title bars becuase the status bar may be embedded in it. You must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura da barra de status em pontos.\nIsso também afetará a altura das barras de título por painel porque a barra de status pode estar embutida nela. Você deve reiniciar o iTerm2 após alterar este ajuste para que ele tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.statusBarIcon" : {
      "comment" : "Advanced setting: statusBarIcon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add status bar icon when excluded from dock?\nWhen you turn on “Exclude from Dock and ⌘-Tab Application Switcher” a status bar icon is added to the menu bar so you can switch the setting back off. Disable this to remove the status bar icon. Doing so makes it very hard to get to Settings. You must restart iTerm2 after changing this setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar ícone na barra de menus quando excluído do Dock?\nQuando você ativa “Excluir do Dock e do alternador de aplicativos ⌘-Tab”, um ícone é adicionado à barra de menus para que você possa desativar o ajuste novamente. Desative isto para remover o ícone. Fazer isso torna muito difícil chegar aos Ajustes. Você deve reiniciar o iTerm2 após alterar este ajuste."
          }
        }
      }
    },
    "AdvancedSetting.stealKeyFocus" : {
      "comment" : "Advanced setting: stealKeyFocus",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Focus Follows Mouse is enabled, steal key focus even when inactive."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “O foco segue o mouse” estiver ativado, roubar o foco do teclado mesmo quando inativo."
          }
        }
      }
    },
    "AdvancedSetting.storeStateInSqlite" : {
      "comment" : "Advanced setting: storeStateInSqlite",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Store window restoration state in SQLite"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenar o estado de restauração de janelas no SQLite"
          }
        }
      }
    },
    "AdvancedSetting.stripZeroWidthFormatCharactersOnPaste" : {
      "comment" : "Advanced setting: stripZeroWidthFormatCharactersOnPaste",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Strip zero-width bidi/format characters when pasting?\nCharacters like the Zero-Width Non-Joiner (U+200C, the Persian half-space), ZWJ, LRM, and RLM are invisible but macOS classifies them as control characters, so line editors like zsh render them as a visible <200c> at the prompt. Turn this on to remove them from pasted text so the command line stays clean. Off by default because these characters are meaningful; enabling this changes the pasted text."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover caracteres bidi/de formatação de largura zero ao colar?\nCaracteres como o Zero-Width Non-Joiner (U+200C, o meio-espaço persa), ZWJ, LRM e RLM são invisíveis, mas o macOS os classifica como caracteres de controle, então editores de linha como o zsh os exibem como um <200c> visível no prompt. Ative isto para removê-los do texto colado para que a linha de comando permaneça limpa. Desativado por padrão porque esses caracteres são significativos; ativar isto altera o texto colado."
          }
        }
      }
    },
    "AdvancedSetting.successSound" : {
      "comment" : "Advanced setting: successSound",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Alert on Next Mark is configured to play a sound, use a file with this name for successful completion of the previous command.\nYou can name a system sound or a file in ~/Library/Sounds."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o Alerta na próxima marca estiver configurado para tocar um som, usar um arquivo com este nome para a conclusão bem-sucedida do comando anterior.\nVocê pode nomear um som do sistema ou um arquivo em ~/Library/Sounds."
          }
        }
      }
    },
    "AdvancedSetting.supportDecsetMetaSendsEscape" : {
      "comment" : "Advanced setting: supportDecsetMetaSendsEscape",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support DECSET 1036?\nThis allows apps in the terminal to control whether the option key sends esc+ or acts like a regular option key."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar DECSET 1036?\nIsso permite que os apps no terminal controlem se a tecla option envia esc+ ou age como uma tecla option normal."
          }
        }
      }
    },
    "AdvancedSetting.supportPowerlineExtendedSymbols" : {
      "comment" : "Advanced setting: supportPowerlineExtendedSymbols",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Include extended symbols when drawing Powerline natively."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluir símbolos estendidos ao desenhar o Powerline nativamente."
          }
        }
      }
    },
    "AdvancedSetting.supportREPCode" : {
      "comment" : "Advanced setting: supportREPCode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable support for REP (Repeat previous character) escape sequence?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar suporte para a sequência de escape REP (repetir caractere anterior)?"
          }
        }
      }
    },
    "AdvancedSetting.suppressMultilinePasteWarningWhenNotAtShellPrompt" : {
      "comment" : "Advanced setting: suppressMultilinePasteWarningWhenNotAtShellPrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning about multi-line paste when not at prompt.\nRequires Shell Integration to be installed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso sobre colagem de várias linhas quando não estiver no prompt.\nRequer que o Shell Integration esteja instalado."
          }
        }
      }
    },
    "AdvancedSetting.suppressMultilinePasteWarningWhenPastingOneLineWithTerminalNewline" : {
      "comment" : "Advanced setting: suppressMultilinePasteWarningWhenPastingOneLineWithTerminalNewline",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning about multi-line paste when pasting a single line ending with a newline.\nThis suppresses all multi-line paste warnings when a single line is being pasted."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso sobre colagem de várias linhas ao colar uma única linha terminada com uma quebra de linha.\nIsso suprime todos os avisos de colagem de várias linhas quando uma única linha está sendo colada."
          }
        }
      }
    },
    "AdvancedSetting.suppressRestartAnnouncement" : {
      "comment" : "Advanced setting: suppressRestartAnnouncement",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress the Restart Session offer.\nWhen a session terminates, it will offer to restart itself. Turn this on to suppress the offer permanently."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir a oferta de Reiniciar sessão.\nQuando uma sessão termina, ela oferecerá reiniciar a si mesma. Ative isto para suprimir a oferta permanentemente."
          }
        }
      }
    },
    "AdvancedSetting.swapFindNextPrevious" : {
      "comment" : "Advanced setting: swapFindNextPrevious",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swap Find Next and Find Previous.\nIf enabled, Find Next will search up and Find Previous will search down (iTerm2's traditional behavior, which is a departure from macOS's standard). When disabled, search behaves like a normal macOS app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar Buscar próximo e Buscar anterior.\nSe ativado, Buscar próximo buscará para cima e Buscar anterior buscará para baixo (o comportamento tradicional do iTerm2, que se afasta do padrão do macOS). Quando desativado, a busca se comporta como em um app normal do macOS."
          }
        }
      }
    },
    "AdvancedSetting.synchronizeQueryWithFindPasteboard" : {
      "comment" : "Advanced setting: synchronizeQueryWithFindPasteboard",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Synchronize search queries across windows and applications.\nNormally, when you enter a search query in a Find field all find fields in all applications get updated to hold the same value. This is utter nonsense, and can be disabled by setting this preference to No."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar consultas de busca entre janelas e aplicativos.\nNormalmente, quando você digita uma consulta de busca em um campo de busca, todos os campos de busca em todos os aplicativos são atualizados para conter o mesmo valor. Isso é um completo absurdo e pode ser desativado definindo esta preferência como Não."
          }
        }
      }
    },
    "AdvancedSetting.synergyModifierRemappingEnabled" : {
      "comment" : "Advanced setting: synergyModifierRemappingEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support modifier remapping for keystrokes originated by Synergy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar remapeamento de modificadores para teclas originadas pelo Synergy."
          }
        }
      }
    },
    "AdvancedSetting.tabAutoShowHoldTime" : {
      "comment" : "Advanced setting: tabAutoShowHoldTime",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long in seconds to show tabs in fullscreen.\nThe tab bar appears briefly in fullscreen when the number of tabs changes or you switch tabs. This setting gives the time in seconds for it to remain visible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por quanto tempo, em segundos, mostrar as abas em tela cheia.\nA barra de abas aparece brevemente em tela cheia quando o número de abas muda ou você troca de aba. Este ajuste define o tempo em segundos que ela permanece visível."
          }
        }
      }
    },
    "AdvancedSetting.tabCloseButtonsAlwaysVisible" : {
      "comment" : "Advanced setting: tabCloseButtonsAlwaysVisible",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should tab close buttons always remain visible?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões de fechar aba devem permanecer sempre visíveis?"
          }
        }
      }
    },
    "AdvancedSetting.tabColorMenuOptions" : {
      "comment" : "Advanced setting: tabColorMenuOptions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Colors for tab color menu item.\nSpace delimited strings like #rrggbb or #rgb in sRGB color space. If the P3 color space is available, you can use strings like: color(p3 1 0.5 0.25)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores para o item de menu de cor de aba.\nStrings separadas por espaço, como #rrggbb ou #rgb no espaço de cores sRGB. Se o espaço de cores P3 estiver disponível, você pode usar strings como: color(p3 1 0.5 0.25)"
          }
        }
      }
    },
    "AdvancedSetting.tabFlashAnimationDuration" : {
      "comment" : "Advanced setting: tabFlashAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Animation duration for fade in/out animation of tabs in full screen, in seconds."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração da animação de fade in/out das abas em tela cheia, em segundos."
          }
        }
      }
    },
    "AdvancedSetting.tabTitlesUseSmartTruncation" : {
      "comment" : "Advanced setting: tabTitlesUseSmartTruncation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use “smart truncation” for tab titles.\nIf a tab‘s title is too long to fit, ellipsize the start of the title if more tabs have unique suffixes than prefixes in a given window."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar “truncamento inteligente” para os títulos das abas.\nSe o título de uma aba for longo demais para caber, abreviar o início do título se, em uma dada janela, mais abas tiverem sufixos únicos do que prefixos."
          }
        }
      }
    },
    "AdvancedSetting.tabsWrapAround" : {
      "comment" : "Advanced setting: tabsWrapAround",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tabs wrap around to the next line.\nThis is useful for preserving tabs for later copying to the pasteboard. It breaks backward compatibility and may cause layout problems with programs that don’t expect this behavior."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tabulações passam para a próxima linha.\nIsso é útil para preservar tabulações para copiar posteriormente para a área de transferência. Isso quebra a compatibilidade retroativa e pode causar problemas de layout com programas que não esperam esse comportamento."
          }
        }
      }
    },
    "AdvancedSetting.throttleMetalConcurrentFrames" : {
      "comment" : "Advanced setting: throttleMetalConcurrentFrames",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reduce number of frames in flight when GPU can't produce drawables quickly."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir o número de quadros em processamento quando a GPU não conseguir produzir drawables rapidamente."
          }
        }
      }
    },
    "AdvancedSetting.timeBetweenBlinks" : {
      "comment" : "Advanced setting: timeBetweenBlinks",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cursor blink speed (seconds)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade de piscar do cursor (segundos)."
          }
        }
      }
    },
    "AdvancedSetting.timeBetweenTips" : {
      "comment" : "Advanced setting: timeBetweenTips",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Time between tips (in seconds)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo entre dicas (em segundos)"
          }
        }
      }
    },
    "AdvancedSetting.timeToWaitForEmojiPanel" : {
      "comment" : "Advanced setting: timeToWaitForEmojiPanel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long to wait for the emoji panel to open in seconds?\nFloating hotkey windows adjust their level when the emoji panel is open. If it’s really slow you might need to increase this value to prevent it from appearing beneath a floating hotkey window."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo esperar para o painel de emoji abrir, em segundos?\nJanelas de hotkey flutuantes ajustam seu nível quando o painel de emoji está aberto. Se estiver muito lento, talvez você precise aumentar este valor para evitar que ele apareça atrás de uma janela de hotkey flutuante."
          }
        }
      }
    },
    "AdvancedSetting.timeoutForDaemonAttachment" : {
      "comment" : "Advanced setting: timeoutForDaemonAttachment",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long to wait when trying to attach to an iTerm daemon at startup when restoring windows (in seconds)?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo esperar ao tentar se conectar a um daemon do iTerm na inicialização ao restaurar janelas (em segundos)?"
          }
        }
      }
    },
    "AdvancedSetting.timeoutForStringEvaluation" : {
      "comment" : "Advanced setting: timeoutForStringEvaluation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeout (seconds) for evaluating RPCs.\nThis applies to invoking functions registered by scripts when using the Swift syntax for inline expressions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo limite (segundos) para avaliar RPCs.\nIsso se aplica à invocação de funções registradas por scripts ao usar a sintaxe Swift para expressões inline."
          }
        }
      }
    },
    "AdvancedSetting.tmuxIncludeClientNameInWindowTitle" : {
      "comment" : "Advanced setting: tmuxIncludeClientNameInWindowTitle",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using tmux integration, should the tmux client name (typically the name of the attaching session or the host name) appear in brackets in the window title?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar a integração com tmux, o nome do cliente tmux (normalmente o nome da sessão que se conecta ou o nome do host) deve aparecer entre colchetes no título da janela?"
          }
        }
      }
    },
    "AdvancedSetting.tmuxTitlePrefix" : {
      "comment" : "Advanced setting: tmuxTitlePrefix",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insert this string at the start of tab and window titles to indicate tmux integration."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserir esta string no início dos títulos de abas e janelas para indicar a integração com tmux."
          }
        }
      }
    },
    "AdvancedSetting.tmuxVariableWindowSizesSupported" : {
      "comment" : "Advanced setting: tmuxVariableWindowSizesSupported",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow variable window sizes in tmux integration.\nRequres tmux version 2.9 or later."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir tamanhos de janela variáveis na integração com tmux.\nRequer o tmux versão 2.9 ou posterior."
          }
        }
      }
    },
    "AdvancedSetting.tmuxWindowsOpenInBackground" : {
      "comment" : "Advanced setting: tmuxWindowsOpenInBackground",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open tmux windows and tabs in the background?\nWhen enabled, attaching with tmux -CC (or when tmux creates a new window) will reveal the window or tab without moving keyboard focus to it. Focus stays on the attaching session."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir janelas e abas do tmux em segundo plano?\nQuando ativado, conectar-se com tmux -CC (ou quando o tmux cria uma nova janela) revelará a janela ou aba sem mover o foco do teclado para ela. O foco permanece na sessão que se conecta."
          }
        }
      }
    },
    "AdvancedSetting.tmuxWindowsShouldCloseAfterDetach" : {
      "comment" : "Advanced setting: tmuxWindowsShouldCloseAfterDetach",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Close tmux windows after detaching?\nThis only takes effect when “Settings > Profiles > Session > After a session ends” is set to “No Action”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar janelas do tmux após desconectar?\nIsso só tem efeito quando “Ajustes > Perfis > Sessão > Após uma sessão terminar” estiver definido como “Nenhuma ação”."
          }
        }
      }
    },
    "AdvancedSetting.tolerateUnrecognizedTmuxCommands" : {
      "comment" : "Advanced setting: tolerateUnrecognizedTmuxCommands",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tolerate unrecognized commands from server.\nIf disabled, an unknown command from tmux (such as output from ssh or wall) will end the session. Turning this off helps detect dead ssh sessions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolerar comandos não reconhecidos do servidor.\nSe desativado, um comando desconhecido do tmux (como a saída de ssh ou wall) encerrará a sessão. Desativar isto ajuda a detectar sessões ssh mortas."
          }
        }
      }
    },
    "AdvancedSetting.toolbeltFont" : {
      "comment" : "Advanced setting: toolbeltFont",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbelt font family name"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome da família de fontes da Caixa de ferramentas"
          }
        }
      }
    },
    "AdvancedSetting.toolbeltFontSize" : {
      "comment" : "Advanced setting: toolbeltFontSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbelt font size in points.\nSet to 0 to use the system default. Changing this setting does not affect existing windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho da fonte da Caixa de ferramentas em pontos.\nDefina como 0 para usar o padrão do sistema. Alterar este ajuste não afeta janelas existentes."
          }
        }
      }
    },
    "AdvancedSetting.trackingRunloopForLiveResize" : {
      "comment" : "Advanced setting: trackingRunloopForLiveResize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use a tracking runloop for live resizing.\nThis allows the terminal to redraw during a resizing drag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar um runloop de rastreamento para redimensionamento ao vivo.\nIsso permite que o terminal redesenhe durante um arraste de redimensionamento."
          }
        }
      }
    },
    "AdvancedSetting.traditionalVisualBell" : {
      "comment" : "Advanced setting: traditionalVisualBell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Visual bell flashes the whole screen, not just a bell icon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A campainha visual pisca a tela inteira, não apenas um ícone de campainha."
          }
        }
      }
    },
    "AdvancedSetting.trailingPunctuationMarks" : {
      "comment" : "Advanced setting: trailingPunctuationMarks",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Characters to ignore at the end of a URL"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres a ignorar no final de uma URL"
          }
        }
      }
    },
    "AdvancedSetting.translateScreenToXterm" : {
      "comment" : "Advanced setting: translateScreenToXterm",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support TERM=screen\nMost notably, this fixes italics replacing inverse text."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar TERM=screen\nMais notavelmente, isso corrige o itálico substituindo o texto invertido."
          }
        }
      }
    },
    "AdvancedSetting.triggerRadius" : {
      "comment" : "Advanced setting: triggerRadius",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Number of screen lines to match against trigger regular expressions.\nTrigger regular expressions are matched against the last logical line of text when a newline is received. A search is performed to find the start of the line. Since very long lines would cause performance problems, the search (and consequently the regular expression match, highlighting, and so on) is limited to this many screen lines."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de linhas de tela a comparar com as expressões regulares de gatilho.\nAs expressões regulares de gatilho são comparadas com a última linha lógica de texto quando uma quebra de linha é recebida. Uma busca é realizada para encontrar o início da linha. Como linhas muito longas causariam problemas de desempenho, a busca (e consequentemente a correspondência da expressão regular, o realce e assim por diante) é limitada a esta quantidade de linhas de tela."
          }
        }
      }
    },
    "AdvancedSetting.trimWhitespaceOnCopy" : {
      "comment" : "Advanced setting: trimWhitespaceOnCopy",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trim whitespace when copying to pasteboard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover espaços em branco ao copiar para a área de transferência."
          }
        }
      }
    },
    "AdvancedSetting.typingClearsSelection" : {
      "comment" : "Advanced setting: typingClearsSelection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pressing a key will remove the selection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressionar uma tecla removerá a seleção."
          }
        }
      }
    },
    "AdvancedSetting.unameCommand" : {
      "comment" : "Advanced setting: unameCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command used to set the `uname` variable.\nThe main use of this is to use in the AI prompt so the language model knows the operating system."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando usado para definir a variável `uname`.\nO principal uso disto é no prompt de IA para que o modelo de linguagem saiba o sistema operacional."
          }
        }
      }
    },
    "AdvancedSetting.underlineCursorHeight" : {
      "comment" : "Advanced setting: underlineCursorHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thickness of underline cursor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espessura do cursor de sublinhado."
          }
        }
      }
    },
    "AdvancedSetting.underlineCursorOffset" : {
      "comment" : "Advanced setting: underlineCursorOffset",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vertical offset for underline cursor.\nPositive values move it up, negative values move it down."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslocamento vertical do cursor de sublinhado.\nValores positivos o movem para cima, valores negativos o movem para baixo."
          }
        }
      }
    },
    "AdvancedSetting.underlineHyperlinks" : {
      "comment" : "Advanced setting: underlineHyperlinks",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Underline OSC 8 hyperlinks"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sublinhar hyperlinks OSC 8"
          }
        }
      }
    },
    "AdvancedSetting.updateScreenParamsDelay" : {
      "comment" : "Advanced setting: updateScreenParamsDelay",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay after changing number of screens/resolution until refresh (seconds).\nThis works around OS bugs where it takes some time after a screen change before it is safe to resize windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso após alterar o número de telas/resolução até a atualização (segundos).\nIsso contorna erros do sistema em que leva algum tempo após uma mudança de tela antes de ser seguro redimensionar janelas."
          }
        }
      }
    },
    "AdvancedSetting.urlHandlerCommand" : {
      "comment" : "Advanced setting: urlHandlerCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command to run when opening a clicked URL, instead of asking the OS to open it.\nWhen non-empty, this command runs as a silent background task via /bin/sh -c whenever you click a URL (including OSC 8 hyperlinks and auto-detected URLs) that iTerm2 would otherwise hand to the system. This is an interpolated string; use \\(url) for the URL and \\(background) for whether a background open was requested (1 if you held option while clicking, otherwise 0). The command is responsible for opening the URL however it likes (e.g., “open -g \\(url)” to open in the background). When empty, URLs open normally. iTerm2-internal schemes (iterm2:), URL schemes bound to a profile, and Semantic History file links are not affected."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando a executar ao abrir uma URL clicada, em vez de pedir ao sistema para abri-la.\nQuando não vazio, este comando é executado como uma tarefa silenciosa em segundo plano via /bin/sh -c sempre que você clica em uma URL (incluindo hyperlinks OSC 8 e URLs detectadas automaticamente) que o iTerm2 normalmente entregaria ao sistema. Esta é uma string interpolada; use \\(url) para a URL e \\(background) para indicar se uma abertura em segundo plano foi solicitada (1 se você segurou option ao clicar, caso contrário 0). O comando é responsável por abrir a URL como preferir (por exemplo, “open -g \\(url)” para abrir em segundo plano). Quando vazio, as URLs abrem normalmente. Esquemas internos do iTerm2 (iterm2:), esquemas de URL vinculados a um perfil e links de arquivos do Semantic History não são afetados."
          }
        }
      }
    },
    "AdvancedSetting.useAdaptiveFrameRate" : {
      "comment" : "Advanced setting: useAdaptiveFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use adaptive framerate.\nWhen throughput is low, the screen will update at 60 frames per second. When throughput is higher, it will drop to a configurable rate (15 fps by default)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar taxa de quadros adaptável.\nQuando a vazão é baixa, a tela será atualizada a 60 quadros por segundo. Quando a vazão é maior, ela cairá para uma taxa configurável (15 fps por padrão)."
          }
        }
      }
    },
    "AdvancedSetting.useBlackFillerColorForTmuxInFullScreen" : {
      "comment" : "Advanced setting: useBlackFillerColorForTmuxInFullScreen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use black for filler area in tmux windows in full screen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar preto para a área de preenchimento em janelas do tmux em tela cheia."
          }
        }
      }
    },
    "AdvancedSetting.useColorfgbgFallback" : {
      "comment" : "Advanced setting: useColorfgbgFallback",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use fallback for COLORFGBG if no exact match found?\nThe COLORFGBG variable indicates the ANSI colors that match the foreground and background colors. If no colors match and this setting is enabled, then the variable will be set to 15;0 to indicate a dark background or 0;15 to indicate a light background."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar um valor alternativo para COLORFGBG se nenhuma correspondência exata for encontrada?\nA variável COLORFGBG indica as cores ANSI que correspondem às cores de primeiro plano e de plano de fundo. Se nenhuma cor corresponder e este ajuste estiver ativado, a variável será definida como 15;0 para indicar um plano de fundo escuro ou 0;15 para indicar um plano de fundo claro."
          }
        }
      }
    },
    "AdvancedSetting.useCustomTabBarFontSize" : {
      "comment" : "Advanced setting: useCustomTabBarFontSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use custom font size for tab labels?\nSee also advanced setting “Custom tab label font size”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar tamanho de fonte personalizado para os rótulos das abas?\nVeja também o ajuste avançado “Tamanho de fonte personalizado do rótulo da aba”."
          }
        }
      }
    },
    "AdvancedSetting.useDivorcedProfileToSplit" : {
      "comment" : "Advanced setting: useDivorcedProfileToSplit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When splitting a pane, use the profile with local modifications, not the backing profile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao dividir um painel, usar o perfil com modificações locais, não o perfil de origem."
          }
        }
      }
    },
    "AdvancedSetting.useDoubleClickDelayForCommandSelection" : {
      "comment" : "Advanced setting: useDoubleClickDelayForCommandSelection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wait to be sure it's not a double click before selecting a command"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperar para ter certeza de que não é um clique duplo antes de selecionar um comando"
          }
        }
      }
    },
    "AdvancedSetting.useExperimentalFontMetrics" : {
      "comment" : "Advanced setting: useExperimentalFontMetrics",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use a more theoretically correct technique to measure line height.\nYou must restart iTerm2 or adjust a session's font size for this change to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar uma técnica teoricamente mais correta para medir a altura da linha.\nVocê deve reiniciar o iTerm2 ou ajustar o tamanho da fonte de uma sessão para que esta alteração tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.useGCDUpdateTimer" : {
      "comment" : "Advanced setting: useGCDUpdateTimer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use GCD-based update timer instead of NSTimer.\nThis should cause more regular screen updates. Restart iTerm2 after changing this setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar um timer de atualização baseado em GCD em vez de NSTimer.\nIsso deve resultar em atualizações de tela mais regulares. Reinicie o iTerm2 após alterar este ajuste."
          }
        }
      }
    },
    "AdvancedSetting.useLowPowerGPUWhenUnplugged" : {
      "comment" : "Advanced setting: useLowPowerGPUWhenUnplugged",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Metal renderer uses integrated GPU when not connected to power?\nFor this to be effective you must disable “Disable Metal renderer when not connected to power”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O renderizador Metal usa a GPU integrada quando não conectado à energia?\nPara que isso seja efetivo, você deve desativar “Desativar o renderizador Metal quando não conectado à energia”."
          }
        }
      }
    },
    "AdvancedSetting.useModernScrollWheelAccumulator" : {
      "comment" : "Advanced setting: useModernScrollWheelAccumulator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use modern scroll wheel accumulator.\nThis should support wheel mice better and feel more natural."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o acumulador moderno da roda de rolagem.\nIsso deve dar melhor suporte a mouses com roda e parecer mais natural."
          }
        }
      }
    },
    "AdvancedSetting.useMultiPassUnderlineRenderer" : {
      "comment" : "Advanced setting: useMultiPassUnderlineRenderer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use multi-pass underline renderer?\nFixes underline gaps with ligature fonts. Requires restart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o renderizador de sublinhado de múltiplas passagens?\nCorrige lacunas de sublinhado com fontes com ligaduras. Requer reinicialização."
          }
        }
      }
    },
    "AdvancedSetting.useNewContentFormat" : {
      "comment" : "Advanced setting: useNewContentFormat",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save unlimited amount of window contents.\nThis is going to be slow unless you enable SQLite-based window restoration too."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar uma quantidade ilimitada de conteúdo de janela.\nIsso será lento a menos que você também ative a restauração de janelas baseada em SQLite."
          }
        }
      }
    },
    "AdvancedSetting.useOldStyleDropDownViews" : {
      "comment" : "Advanced setting: useOldStyleDropDownViews",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use old-style find and paste progress indicator views.\nThis change will only affect new windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar as visualizações antigas de indicador de progresso de busca e colagem.\nEsta alteração só afetará janelas novas."
          }
        }
      }
    },
    "AdvancedSetting.useOpenDirectory" : {
      "comment" : "Advanced setting: useOpenDirectory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use Open Directory to determine the user shell"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o Open Directory para determinar o shell do usuário"
          }
        }
      }
    },
    "AdvancedSetting.useRestorableStateController" : {
      "comment" : "Advanced setting: useRestorableStateController",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable restorable state controller?\nThis makes window restoration more reliable."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar o controlador de estado restaurável?\nIsso torna a restauração de janelas mais confiável."
          }
        }
      }
    },
    "AdvancedSetting.useSequoiaStyleTabs" : {
      "comment" : "Advanced setting: useSequoiaStyleTabs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use Sequoia-style tabs in Tahoe and later?"
          }
