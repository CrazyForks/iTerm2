      }
    },
    "AdvancedSetting.useShortcutAccessoryViewController" : {
      "comment" : "Advanced setting: useShortcutAccessoryViewController",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show window number in titlebar accessory?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o número da janela no acessório da barra de título?"
          }
        }
      }
    },
    "AdvancedSetting.useSystemCursorWhenPossible" : {
      "comment" : "Advanced setting: useSystemCursorWhenPossible",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use system cursor icons when possible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar ícones de cursor do sistema quando possível."
          }
        }
      }
    },
    "AdvancedSetting.useUnevenTabs" : {
      "comment" : "Advanced setting: useUnevenTabs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uneven tab widths allowed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larguras de aba desiguais permitidas."
          }
        }
      }
    },
    "AdvancedSetting.useVirtualKeyCodesForDetectingDigits" : {
      "comment" : "Advanced setting: useVirtualKeyCodesForDetectingDigits",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Treat the top row of keys like number keys on an English keyboard for the purposes of switching panes, tabs, and windows with modifier+number.\nFor example, AZERTY requires you to hold down Shift to enter a number. To switch tabs with ⌘+Number on an AZERTY keyboard, you must enable this setting. Then, for example, ⌘-& switches to tab 1. When this setting is enabled, some user-defined shortcuts may become unavailable because the tab/window/pane switching behavior takes precedence."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratar a linha superior de teclas como teclas numéricas em um teclado inglês para fins de troca de painéis, abas e janelas com modificador+número.\nPor exemplo, o AZERTY exige que você segure Shift para digitar um número. Para trocar de aba com ⌘+número em um teclado AZERTY, você deve ativar este ajuste. Então, por exemplo, ⌘-& troca para a aba 1. Quando este ajuste está ativado, alguns atalhos definidos pelo usuário podem ficar indisponíveis porque o comportamento de troca de aba/janela/painel tem precedência."
          }
        }
      }
    },
    "AdvancedSetting.userNotificationTriggerRateLimit" : {
      "comment" : "Advanced setting: userNotificationTriggerRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rate limit for Notification triggers.\nIf the same trigger fires with less than this time interval (in seconds) between firings, it will be suppressed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de taxa para gatilhos de Notificação.\nSe o mesmo gatilho disparar com um intervalo menor que este (em segundos) entre disparos, ele será suprimido."
          }
        }
      }
    },
    "AdvancedSetting.uvManifestDownloadURL" : {
      "comment" : "Advanced setting: uvManifestDownloadURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL of the uv download manifest (used when the Python runtime is provisioned with uv)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL do manifesto de download do uv (usado quando o ambiente de execução Python é provisionado com uv)."
          }
        }
      }
    },
    "AdvancedSetting.validCharactersInSSHUserNames" : {
      "comment" : "Advanced setting: validCharactersInSSHUserNames",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Valid characters in SSH user names\nAlphanumerics are always valid. This specifies other valid characters."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres válidos em nomes de usuário SSH\nCaracteres alfanuméricos são sempre válidos. Isto especifica outros caracteres válidos."
          }
        }
      }
    },
    "AdvancedSetting.verticalBarCursorWidth" : {
      "comment" : "Advanced setting: verticalBarCursorWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Width of vertical bar cursor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura do cursor de barra vertical."
          }
        }
      }
    },
    "AdvancedSetting.viewManPageCommand" : {
      "comment" : "Advanced setting: viewManPageCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command to view man pages.\nUsed when you press the man page button on the touch bar. %@ is replaced with the command. End the command with & to avoid opening an iTerm2 window (e.g., if you're launching an external viewer)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando para visualizar páginas de manual.\nUsado quando você pressiona o botão de página de manual na touch bar. %@ é substituído pelo comando. Termine o comando com & para evitar abrir uma janela do iTerm2 (por exemplo, se você estiver iniciando um visualizador externo)."
          }
        }
      }
    },
    "AdvancedSetting.vs16Supported" : {
      "comment" : "Advanced setting: vs16Supported",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support variation selector 16 making emoji fullwidth in all modes?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar o seletor de variação 16 tornando os emoji de largura total em todos os modos?"
          }
        }
      }
    },
    "AdvancedSetting.vs16SupportedInPrimaryScreen" : {
      "comment" : "Advanced setting: vs16SupportedInPrimaryScreen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support variation selector 16 making emoji fullwidth outside of alternate screen mode?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar o seletor de variação 16 tornando os emoji de largura total fora do modo de tela alternativa?"
          }
        }
      }
    },
    "AdvancedSetting.warnAboutSecureKeyboardInputWithOpenCommand" : {
      "comment" : "Advanced setting: warnAboutSecureKeyboardInputWithOpenCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warn if the `open` command appears to fail when secure keyboard input is enabled?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar se o comando `open` parecer falhar quando a entrada de teclado segura estiver ativada?"
          }
        }
      }
    },
    "AdvancedSetting.webInstantReplayFrameRate" : {
      "comment" : "Advanced setting: webInstantReplayFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Instant replay frame rate for web browser sessions"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de quadros do Instant Replay para sessões de navegador web"
          }
        }
      }
    },
    "AdvancedSetting.webKitAdblockEnabled" : {
      "comment" : "Advanced setting: webKitAdblockEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable ad blocking in the web browser?\nWhen enabled, downloads and applies ad blocking rules from the configured URL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar bloqueio de anúncios no navegador web?\nQuando ativado, baixa e aplica regras de bloqueio de anúncios da URL configurada."
          }
        }
      }
    },
    "AdvancedSetting.webUserAgent" : {
      "comment" : "Advanced setting: webUserAgent",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "User agent for web views. Leave empty to use system default."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "User agent para visualizações web. Deixe vazio para usar o padrão do sistema."
          }
        }
      }
    },
    "AdvancedSetting.windowBorderColor" : {
      "comment" : "Advanced setting: windowBorderColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Border color for focused windows.\nShould be a web-style color, #rrggbb, or #rrggbbaa to also set opacity. You can also use p3#rrggbb or p3#rrggbbaa for p3 color space. Without an alpha component the border is drawn at 75% opacity. Requires “Show border around windows” with no title bar. Leave empty for the default color."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da borda para janelas em foco.\nDeve ser uma cor no estilo web, #rrggbb, ou #rrggbbaa para também definir a opacidade. Você também pode usar p3#rrggbb ou p3#rrggbbaa para o espaço de cores p3. Sem um componente alfa, a borda é desenhada a 75% de opacidade. Requer “Mostrar borda ao redor das janelas” sem barra de título. Deixe vazio para a cor padrão."
          }
        }
      }
    },
    "AdvancedSetting.windowBorderColorUnfocused" : {
      "comment" : "Advanced setting: windowBorderColorUnfocused",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Border color for unfocused windows.\nShould be a web-style color, #rrggbb, or #rrggbbaa to also set opacity. You can also use p3#rrggbb or p3#rrggbbaa for p3 color space. Without an alpha component the border is drawn at 75% opacity. Leave empty to match the focused color."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da borda para janelas fora de foco.\nDeve ser uma cor no estilo web, #rrggbb, ou #rrggbbaa para também definir a opacidade. Você também pode usar p3#rrggbb ou p3#rrggbbaa para o espaço de cores p3. Sem um componente alfa, a borda é desenhada a 75% de opacidade. Deixe vazio para corresponder à cor de foco."
          }
        }
      }
    },
    "AdvancedSetting.wordSelectionRegexRadius" : {
      "comment" : "Advanced setting: wordSelectionRegexRadius",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of characters before and after the click location to search when applying word selection regex patterns."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de caracteres antes e depois do local do clique a buscar ao aplicar padrões de regex de seleção de palavras."
          }
        }
      }
    },
    "AdvancedSetting.workAroundMultiDisplayOSBug" : {
      "comment" : "Advanced setting: workAroundMultiDisplayOSBug",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Work around a macOS bug where the OS moves windows to the first display for no good reason."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contornar um erro do macOS em que o sistema move janelas para a primeira tela sem um bom motivo."
          }
        }
      }
    },
    "AdvancedSetting.workAroundNumericKeypadBug" : {
      "comment" : "Advanced setting: workAroundNumericKeypadBug",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Treat the equals sign on the numeric keypad as a key on the numeric keypad.\nFor mysterious reasons, macOS does not treat this key as belonging to the numeric keypad. Enable this setting to work around the bug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratar o sinal de igual do teclado numérico como uma tecla do teclado numérico.\nPor razões misteriosas, o macOS não trata esta tecla como pertencente ao teclado numérico. Ative este ajuste para contornar o erro."
          }
        }
      }
    },
    "AdvancedSetting.workgroupAutoSendSubmitDelay" : {
      "comment" : "Advanced setting: workgroupAutoSendSubmitDelay",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay in seconds before the Return that submits an auto-sent code review.\nWhen the code-review workgroup toolbar auto-sends review results to the main session, it pastes the results and then sends a Return to submit them. This is how long it waits, after the pasted results finish, before sending that Return. A paste-debouncing TUI (such as Claude Code) processes a paste and a Return that arrive together as one batch, so the Return can be swallowed and the review never submits; the delay makes the Return land in a later read so it submits. The default matches Claude Code’s 500 ms paste-settling window. Set to 0 to send it immediately."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso em segundos antes do Return que envia uma revisão de código enviada automaticamente.\nQuando a barra de ferramentas do grupo de trabalho de revisão de código envia automaticamente os resultados da revisão para a sessão principal, ela cola os resultados e depois envia um Return para submetê-los. Este é o tempo que ela espera, após os resultados colados terminarem, antes de enviar esse Return. Uma TUI que faz debounce de colagem (como o Claude Code) processa uma colagem e um Return que chegam juntos como um único lote, então o Return pode ser engolido e a revisão nunca é submetida; o atraso faz o Return chegar em uma leitura posterior para que seja submetido. O padrão corresponde à janela de estabilização de colagem de 500 ms do Claude Code. Defina como 0 para enviá-lo imediatamente."
          }
        }
      }
    },
    "AdvancedSetting.wrapFocus" : {
      "comment" : "Advanced setting: wrapFocus",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should split pane navigation by direction wrap around?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A navegação de painéis divididos por direção deve dar a volta?"
          }
        }
      }
    },
    "AdvancedSetting.xtermVersion" : {
      "comment" : "Advanced setting: xtermVersion",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "xterm version for secondary device attributes (SDA).\nIncreasing this number enables more features in apps but may break things. Use 95 to recover pre-3.4.10 behavior."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versão do xterm para atributos secundários de dispositivo (SDA).\nAumentar este número ativa mais recursos nos apps, mas pode quebrar coisas. Use 95 para recuperar o comportamento anterior à 3.4.10."
          }
        }
      }
    },
    "AdvancedSetting.zeroWidthSpaceAdvancesCursor" : {
      "comment" : "Advanced setting: zeroWidthSpaceAdvancesCursor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zero-Width Space (U+200B) advances cursor?\nWhile a zero-width space should not advance the cursor per the Unicode spec, both Terminal.app and Konsole do this, and Weechat depends on it. You must restart iTerm2 after changing this setting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço de largura zero (U+200B) avança o cursor?\nEmbora um espaço de largura zero não deva avançar o cursor conforme a especificação Unicode, tanto o Terminal.app quanto o Konsole fazem isso, e o Weechat depende disso. Você deve reiniciar o iTerm2 após alterar este ajuste."
          }
        }
      }
    },
    "AdvancedSetting.zippyTextDrawing" : {
      "comment" : "Advanced setting: zippyTextDrawing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use zippy text drawing algorithm?\nThis draws non-ASCII text more quickly but with lower fidelity. This setting is ignored if ligatures are enabled in Settings > Profiles > Text."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o algoritmo de desenho de texto rápido?\nIsso desenha texto não ASCII mais rapidamente, mas com menor fidelidade. Este ajuste é ignorado se as ligaduras estiverem ativadas em Ajustes > Perfis > Texto."
          }
        }
      }
    },
    "AdvancedSettings.DisplayName" : {
      "comment" : "Display name of the Advanced Preferences section in settings search",
