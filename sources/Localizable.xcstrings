    "Tip.0035.Body" : {
      "comment" : "Tip of the day body, id 0035",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you put a slash in a profile’s tag, that implicitly defines a hierarchy. You can see it in the Profiles menu as nested submenus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você colocar uma barra na tag de um perfil, isso define implicitamente uma hierarquia. Você pode vê-la no menu Perfis como submenus aninhados."
          }
        }
      }
    },
    "Tip.0035.Title" : {
      "comment" : "Tip of the day title, id 0035",
      "extractionState" : "extracted_with_value",
      "localizations" : {
