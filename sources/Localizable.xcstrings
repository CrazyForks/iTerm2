    "ProfilesKeys.MetaWarning" : {
      "comment" : "Warning shown when the user configures an option key to act as Meta",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have chosen to have an option key act as Meta. This option is useful for backward compatibility with older systems. The \"Esc+\" option is recommended for most users."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você optou por fazer uma tecla Option atuar como Meta. Esta opção é útil para compatibilidade com sistemas mais antigos. A opção “Esc+” é recomendada para a maioria dos usuários."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已选择让 Option 键充当 Meta。此选项有助于与较旧系统向后兼容。建议大多数用户使用“Esc+”选项。"
          }
        }
      }
    },
    "ProfilesKeys.OptionAsMetaHelp" : {
      "comment" : "Help text explaining how the option key behaves as Meta or Alt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In most key reporting modes, when reporting special keys like arrows, the ⌥ key may act as either Meta or Alt. Prior to version 3.5.6, iTerm2 used Meta. The default changed to Alt because some programs like Emacs expect it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na maioria dos modos de reporte de teclas, ao reportar teclas especiais como as setas, a tecla ⌥ pode atuar como Meta ou Alt. Antes da versão 3.5.6, o iTerm2 usava Meta. O padrão mudou para Alt porque alguns programas, como o Emacs, esperam isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大多数按键报告模式中，报告方向键等特殊按键时，⌥ 键可能充当 Meta 或 Alt。在 3.5.6 版本之前，iTerm2 使用 Meta。默认值已改为 Alt，因为 Emacs 等某些程序期望如此。"
          }
        }
      }
    },
    "ProfilesKeys.OverrideWarning" : {
      "comment" : "Warning shown when a profile shortcut overrides a global shortcut",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The keyboard shortcut you have set for this profile will take precedence over an existing shortcut for the same key combination in a global shortcut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atalho de teclado que você definiu para este perfil terá precedência sobre um atalho existente para a mesma combinação de teclas em um atalho global."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你为此配置文件设置的键盘快捷键将优先于全局快捷键中的同一按键组合的现有快捷键。"
          }
        }
      }
    },
