      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Shell Integration feature lets you ask to be alerted (⌥⌘A) when a long-running command completes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
