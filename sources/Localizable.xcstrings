            "state" : "translated",
            "value" : "Transferências"
          }
        }
      }
    },
    "Tip.0037.Body" : {
      "comment" : "Tip of the day body, id 0037",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you install Shell Integration, ⇧⌘; helps you complete commands. It remembers the commands you’ve run on each host that has Shell Integration installed. It knows how often that command was run and how recently to help make the best suggestions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você instalar a Shell Integration, ⇧⌘; ajuda a completar comandos. Ela lembra os comandos que você executou em cada host que tem a Shell Integration instalada. Ela sabe com que frequência e há quanto tempo o comando foi executado para ajudar a fazer as melhores sugestões."
          }
        }
      }
    },
    "Tip.0037.Title" : {
      "comment" : "Tip of the day title, id 0037",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command Completion"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conclusão de comandos"
          }
        }
      }
    },
    "Tip.0038.Body" : {
      "comment" : "Tip of the day body, id 0038",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 remembers which directories you use the most on each host that has Shell Integration installed. There’s a Toolbelt tool to browse them, and ⌥⌘/ gives you a popup sorted by frequency and recency of use."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 lembra quais diretórios você mais usa em cada host que tem a Shell Integration instalada. Há uma ferramenta na Caixa de ferramentas para navegar por eles, e ⌥⌘/ abre um pop-up ordenado por frequência e recência de uso."
          }
        }
      }
    },
    "Tip.0038.Title" : {
      "comment" : "Tip of the day title, id 0038",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recent Directories"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diretórios recentes"
          }
        }
      }
    },
    "Tip.0039.Body" : {
      "comment" : "Tip of the day body, id 0039",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you have Shell Integration installed, you can “star” a directory to keep it always at the bottom of the Recent Directories tool in the Toolbelt. Right click and choose “Toggle Star.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você tem a Shell Integration instalada, pode marcar um diretório com uma estrela para mantê-lo sempre na parte inferior da ferramenta Diretórios recentes na Caixa de ferramentas. Clique com o botão direito e escolha “Alternar estrela”."
          }
        }
      }
    },
    "Tip.0039.Title" : {
      "comment" : "Tip of the day title, id 0039",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
