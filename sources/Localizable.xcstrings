    },
    "AdvancedSetting.activeUpdateCadence" : {
      "comment" : "Advanced setting: activeUpdateCadence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum frame rate (FPS) when adaptive framerate is disabled.\nNote: this is doubled on ARM Macs for displays that support at least 120hz. Modifications to this setting will not affect existing sessions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de quadros máxima (FPS) quando a taxa de quadros adaptativa está desativada.\nObservação: isso é dobrado em Macs ARM para telas compatíveis com pelo menos 120 Hz. As alterações a esta configuração não afetam as sessões existentes."
          }
        }
      }
    },
    "AdvancedSetting.adaptiveFrameRateThroughputThreshold" : {
      "comment" : "Advanced setting: adaptiveFrameRateThroughputThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Throughput threshold for adaptive frame rate.\nIf more than this many bytes per second are received, use the lower frame rate of 30 fps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de taxa de transferência para a taxa de quadros adaptativa.\nSe forem recebidos mais bytes por segundo do que este valor, use a taxa de quadros mais baixa de 30 fps."
          }
        }
      }
    },
    "AdvancedSetting.adblockListURL" : {
      "comment" : "Advanced setting: adblockListURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL for ad blocking filter list\nThis should be a JSON file in WebKit content blocker format. The list is downloaded automatically every 24 hours."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL da lista de filtros de bloqueio de anúncios\nDeve ser um arquivo JSON no formato de bloqueador de conteúdo do WebKit. A lista é transferida automaticamente a cada 24 horas."
          }
        }
      }
    },
    "AdvancedSetting.addDynamicTagToDynamicProfiles" : {
      "comment" : "Advanced setting: addDynamicTagToDynamicProfiles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add a 'Dynamic' tag to dynamic profiles.\nWhen enabled, dynamic profiles will have a 'Dynamic' tag added to them, which can be used to filter or identify them."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar uma tag “Dynamic” aos perfis dinâmicos.\nQuando ativado, os perfis dinâmicos terão uma tag “Dynamic” adicionada, que pode ser usada para filtrá-los ou identificá-los."
          }
        }
      }
    },
    "AdvancedSetting.addTabButtonUsesCurrentProfile" : {
      "comment" : "Advanced setting: addTabButtonUsesCurrentProfile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should the “new tab” button in the tab bar use the current session’s profile?\nWhen enabled, clicking the “+” button opens a new tab with the current session’s profile instead of the default profile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão de “nova aba” na barra de abas deve usar o perfil da sessão atual?\nQuando ativado, clicar no botão “+” abre uma nova aba com o perfil da sessão atual em vez do perfil padrão."
          }
        }
      }
    },
    "AdvancedSetting.addUtilitiesToPATH" : {
      "comment" : "Advanced setting: addUtilitiesToPATH",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add path to iTerm2 utilities to $PATH for new sessions?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar o caminho dos utilitários do iTerm2 ao $PATH para novas sessões?"
          }
        }
      }
    },
    "AdvancedSetting.advancedPasteWaitsForPromptByDefault" : {
      "comment" : "Advanced setting: advancedPasteWaitsForPromptByDefault",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should Advanced Paste automatically enable “Wait for shell prompt before pasting each line” by default when shell integration is detected?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Colagem avançada deve ativar automaticamente “Aguardar o prompt do shell antes de colar cada linha” por padrão quando a Shell Integration é detectada?"
          }
        }
      }
    },
    "AdvancedSetting.aggressiveBaseCharacterDetection" : {
      "comment" : "Advanced setting: aggressiveBaseCharacterDetection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Detect base unicode characters with lookup table.\nApple's algorithm for segmenting composed characters makes bad choices, such as for Tamil. Enable this to reduce text overlapping."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar caracteres unicode base com tabela de consulta.\nO algoritmo da Apple para segmentar caracteres compostos faz escolhas ruins, como no tâmil. Ative isto para reduzir a sobreposição de texto."
          }
        }
      }
    },
    "AdvancedSetting.aggressiveFocusFollowsMouse" : {
      "comment" : "Advanced setting: aggressiveFocusFollowsMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Focus Follows Mouse is enabled, activate the window under the cursor when iTerm2 becomes active?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Foco segue o mouse” está ativado, ativar a janela sob o cursor quando o iTerm2 se tornar ativo?"
          }
        }
      }
    },
    "AdvancedSetting.aiChatRawWireLogging" : {
      "comment" : "Advanced setting: aiChatRawWireLogging",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log raw AI API requests and responses to disk.\nWrites every byte sent to and received from the AI vendor (full request headers, body, streaming chunks, final response, errors, and timing) to ~/Library/Application Support/iTerm2/AIChatWire/. One log file per app launch; rotate or delete it yourself when done. WARNING: the log captures Authorization / API-key headers and full prompt + response content verbatim. Off by default; turn on only while reproducing an issue and delete the files when finished."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar em disco as requisições e respostas brutas da API de IA.\nGrava cada byte enviado e recebido do fornecedor de IA (cabeçalhos completos da requisição, corpo, blocos de streaming, resposta final, erros e tempos) em ~/Library/Application Support/iTerm2/AIChatWire/. Um arquivo de log por inicialização do app; alterne ou apague-o você mesmo quando terminar. AVISO: o log captura cabeçalhos de Authorization / chave de API e o conteúdo completo do prompt e da resposta na íntegra. Desativado por padrão; ative apenas ao reproduzir um problema e apague os arquivos ao terminar."
          }
        }
      }
    },
    "AdvancedSetting.aiChatVerboseConsoleLogging" : {
      "comment" : "Advanced setting: aiChatVerboseConsoleLogging",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log AI chat traffic to the system console.\nEmits per-turn user / agent / tool entries via NSFuckingLog so you can trace exactly what the agent received and produced. Useful for debugging tool dispatch and history translation. Off by default; turn on only while reproducing an issue."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar o tráfego do chat de IA no console do sistema.\nEmite entradas por turno de usuário / agente / ferramenta via NSFuckingLog para que você possa rastrear exatamente o que o agente recebeu e produziu. Útil para depurar o despacho de ferramentas e a tradução do histórico. Desativado por padrão; ative apenas ao reproduzir um problema."
          }
        }
      }
    },
    "AdvancedSetting.aiGeneratedTabTitles" : {
      "comment" : "Advanced setting: aiGeneratedTabTitles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Name tabs after the work on screen, using on-device AI?\nWhen enabled, the session variable “aiTitle” holds a short name for the task visible in the session, which you can show by adding the “AI-generated name” title component or using \\(session.aiTitle) in a custom title format. Requires Apple Intelligence; the screen contents never leave this Mac, and no API key is used."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomear as abas de acordo com o trabalho na tela, usando IA no dispositivo?\nQuando ativado, a variável de sessão “aiTitle” contém um nome curto para a tarefa visível na sessão, que você pode exibir adicionando o componente de título “Nome gerado por IA” ou usando \\(session.aiTitle) em um formato de título personalizado. Requer o Apple Intelligence; o conteúdo da tela nunca sai deste Mac e nenhuma chave de API é usada."
          }
        }
      }
    },
    "AdvancedSetting.aiModelCatalogURL" : {
      "comment" : "Advanced setting: aiModelCatalogURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL to check for updates to the AI model catalog.\nThe catalog defines the built-in AI models (context window, capabilities, and the recommended model per vendor). iTerm2 periodically downloads a signed newer copy so new models become available without an app update. This happens only when AI features are enabled and you have granted permission; a non-empty URL by itself does not enable checking. Clearing this URL disables checking entirely."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL para verificar atualizações do catálogo de modelos de IA.\nO catálogo define os modelos de IA integrados (janela de contexto, recursos e o modelo recomendado por fornecedor). O iTerm2 baixa periodicamente uma cópia mais recente assinada para que novos modelos fiquem disponíveis sem uma atualização do app. Isso acontece apenas quando os recursos de IA estão ativados e você concedeu permissão; uma URL não vazia por si só não ativa a verificação. Limpar esta URL desativa a verificação por completo."
          }
        }
      }
    },
    "AdvancedSetting.aiModernModelPrefixes" : {
      "comment" : "Advanced setting: aiModernModelPrefixes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI model name substrings that use the modern 'completions' API.\nSubstrings should be space-delimited. This handles OpenRouter-style names like 'openai/gpt-4o'. Note that o1 models use a different API and have hard-coded behavior."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substrings de nome de modelo de IA que usam a API “completions” moderna.\nAs substrings devem ser separadas por espaços. Isso lida com nomes no estilo do OpenRouter como “openai/gpt-4o”. Observe que os modelos o1 usam uma API diferente e têm comportamento fixo no código."
          }
        }
      }
    },
    "AdvancedSetting.aiProxy" : {
      "comment" : "Advanced setting: aiProxy",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Host and port for proxy for AI requests.\ni.e., example.com:8080"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host e porta do proxy para requisições de IA.\np. ex., example.com:8080"
          }
        }
      }
    },
    "AdvancedSetting.alertTriggerRateLimit" : {
      "comment" : "Advanced setting: alertTriggerRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rate limit for Alert triggers.\nIf the same trigger fires with less than this time interval (in seconds) between firings, it will be suppressed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de taxa para gatilhos de Alerta.\nSe o mesmo gatilho disparar com menos que este intervalo de tempo (em segundos) entre disparos, ele será suprimido."
          }
        }
      }
    },
    "AdvancedSetting.alertsIndicateShortcuts" : {
      "comment" : "Advanced setting: alertsIndicateShortcuts",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Buttons in modal alerts indicate keyboard shortcuts.\nDo you miss Windows 95? I do."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botões em alertas modais indicam atalhos de teclado.\nVocê sente falta do Windows 95? Eu sinto."
          }
        }
      }
    },
    "AdvancedSetting.allowDragOfTabIntoNewWindow" : {
      "comment" : "Advanced setting: allowDragOfTabIntoNewWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow a tab to be dragged and dropped outside any existing tab bar to create a new window."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que uma aba seja arrastada e solta fora de qualquer barra de abas existente para criar uma nova janela."
          }
        }
      }
    },
    "AdvancedSetting.allowDragOnAddTabButton" : {
      "comment" : "Advanced setting: allowDragOnAddTabButton",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow dragging window by the Add Tab button in the tab bar?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir arrastar a janela pelo botão Adicionar aba na barra de abas?"
          }
        }
      }
    },
    "AdvancedSetting.allowIdempotentTriggers" : {
      "comment" : "Advanced setting: allowIdempotentTriggers",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Evaluate idempotent triggers periodically in interactive apps, even when triggers in interactive apps are disabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaliar gatilhos idempotentes periodicamente em apps interativos, mesmo quando gatilhos em apps interativos estão desativados."
          }
        }
      }
    },
    "AdvancedSetting.allowInteractiveSwipeBetweenTabs" : {
      "comment" : "Advanced setting: allowInteractiveSwipeBetweenTabs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow two-finger interactive swipe between tabs?\nThe system preference Trackpad > More Gestures > Swipe between pages controls this globally. When “swipe with two fingers” is enabled, you can change this setting to “No” to prevent swiping between tabs in iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir deslize interativo com dois dedos entre abas?\nA preferência do sistema Trackpad > Mais gestos > Passar entre páginas controla isso globalmente. Quando “passar com dois dedos” está ativado, você pode alterar este ajuste para “Não” para impedir o deslize entre abas no iTerm2."
          }
        }
      }
    },
    "AdvancedSetting.allowLiveResize" : {
      "comment" : "Advanced setting: allowLiveResize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow window resizing by dragging edges and corners?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir redimensionar a janela arrastando bordas e cantos?"
          }
        }
      }
    },
    "AdvancedSetting.allowSendingFunctionKeysToCocoa" : {
      "comment" : "Advanced setting: allowSendingFunctionKeysToCocoa",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow function keys to be handled by macOS text input system.\nThis supports using function keys with modifiers as compose/dead keys in custom keyboard layouts."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que teclas de função sejam tratadas pelo sistema de entrada de texto do macOS.\nIsso possibilita usar teclas de função com modificadores como teclas de composição/mortas em layouts de teclado personalizados."
          }
        }
      }
    },
    "AdvancedSetting.allowTabbarInTitlebarAccessoryBigSur" : {
      "comment" : "Advanced setting: allowTabbarInTitlebarAccessoryBigSur",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Make the tab bar a titlebar accessory view in Big Sur?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornar a barra de abas uma visualização acessória da barra de título no Big Sur?"
          }
        }
      }
    },
    "AdvancedSetting.alphaForDeselectedCommandShade" : {
      "comment" : "Advanced setting: alphaForDeselectedCommandShade",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alpha value for shade that covers areas outside the currently selected command."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor alfa da sombra que cobre áreas fora do comando atualmente selecionado."
          }
        }
      }
    },
    "AdvancedSetting.alternateMouseScroll" : {
      "comment" : "Advanced setting: alternateMouseScroll",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll wheel sends arrow keys when in alternate screen mode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roda de rolagem envia teclas de seta no modo de tela alternada."
          }
        }
      }
    },
    "AdvancedSetting.alternateMouseScrollStringForDown" : {
      "comment" : "Advanced setting: alternateMouseScrollStringForDown",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll wheel down sends the specified text when in alternate screen mode.\nThe value should use Vim syntax, such as \\e for escape."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roda de rolagem para baixo envia o texto especificado no modo de tela alternada.\nO valor deve usar a sintaxe do Vim, como \\e para escape."
          }
        }
      }
    },
    "AdvancedSetting.alternateMouseScrollStringForUp" : {
      "comment" : "Advanced setting: alternateMouseScrollStringForUp",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll wheel up sends the specified text when in alternate screen mode.\nThe value should use Vim syntax, such as \\e for escape."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roda de rolagem para cima envia o texto especificado no modo de tela alternada.\nO valor deve usar a sintaxe do Vim, como \\e para escape."
          }
        }
      }
    },
    "AdvancedSetting.alternateSSHIntegrationScript" : {
      "comment" : "Advanced setting: alternateSSHIntegrationScript",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate SSH integration python script"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Script python alternativo de integração SSH"
          }
        }
      }
    },
    "AdvancedSetting.alwaysAcceptFirstMouse" : {
      "comment" : "Advanced setting: alwaysAcceptFirstMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Always accept first mouse event on terminal windows.\nThis means clicks will work the same when iTerm2 is active as when it’s inactive. Note that there is a separate setting for mouse reporting on first mouse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre aceitar o primeiro evento de mouse em janelas do terminal.\nIsso significa que os cliques funcionarão da mesma forma quando o iTerm2 estiver ativo e quando estiver inativo. Observe que há um ajuste separado para relatório de mouse no primeiro clique."
          }
        }
      }
    },
    "AdvancedSetting.alwaysUseLineStyleMarks" : {
      "comment" : "Advanced setting: alwaysUseLineStyleMarks",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Always use line-style marks?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre usar marcas em estilo de linha?"
          }
        }
      }
    },
    "AdvancedSetting.alwaysUseStatusBarComposer" : {
      "comment" : "Advanced setting: alwaysUseStatusBarComposer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Temporarily add a composer to the status bar instead of opening the large composer view when a status bar is present."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar temporariamente um compositor à barra de status em vez de abrir a visualização grande do compositor quando houver uma barra de status."
          }
        }
      }
    },
    "AdvancedSetting.alwaysWarnBeforePastingOverSize" : {
      "comment" : "Advanced setting: alwaysWarnBeforePastingOverSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When pasting more than this many characters, require confirmation.\nSet to -1 to disable warning.\nCharacters are counted in UTF-16."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao colar mais que esta quantidade de caracteres, exigir confirmação.\nDefina como -1 para desativar o aviso.\nOs caracteres são contados em UTF-16."
          }
        }
      }
    },
    "AdvancedSetting.animateGraphStatusBarComponents" : {
      "comment" : "Advanced setting: animateGraphStatusBarComponents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Animate graph-based status bar components?\nTurn this off to reduce CPU/GPU usage in WindowServer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animar componentes da barra de status baseados em gráfico?\nDesative isso para reduzir o uso de CPU/GPU no WindowServer."
          }
        }
      }
    },
    "AdvancedSetting.anonymousTmuxWindowsOpen.FocusedWindow" : {
      "comment" : "tmux window placement option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Focused window"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janela em foco"
          }
        }
      }
    },
    "AdvancedSetting.anonymousTmuxWindowsOpen.NewWindow" : {
      "comment" : "tmux window placement option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New window"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova janela"
          }
        }
      }
    },
    "AdvancedSetting.anonymousTmuxWindowsOpen.TopmostSessionWindow" : {
      "comment" : "tmux window placement option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Topmost session window"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janela de sessão mais ao topo"
          }
        }
      }
    },
    "AdvancedSetting.anonymousTmuxWindowsOpenInCurrentWindow" : {
      "comment" : "Advanced setting: anonymousTmuxWindowsOpenInCurrentWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Where should new tmux windows not created by iTerm2 open?\n“Focused window” (the default) attaches the window as a tab of whichever iTerm2 window currently has keyboard focus. “Topmost session window” attaches it to the frontmost iTerm2 window that already shows a tab from this tmux session, regardless of focus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde novas janelas do tmux não criadas pelo iTerm2 devem abrir?\n“Janela em foco” (o padrão) anexa a janela como uma aba da janela do iTerm2 que tiver o foco do teclado no momento. “Janela de sessão mais ao topo” anexa-a à janela do iTerm2 mais à frente que já exibe uma aba desta sessão do tmux, independentemente do foco."
          }
        }
      }
    },
    "AdvancedSetting.appendToExistingDebugLog" : {
      "comment" : "Advanced setting: appendToExistingDebugLog",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Append to existing debug log rather than replacing it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar ao log de depuração existente em vez de substituí-lo."
          }
        }
      }
    },
    "AdvancedSetting.aquaSKKBugfixEnabled" : {
      "comment" : "Advanced setting: aquaSKKBugfixEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable AquaSKK bugfix?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar correção de bug do AquaSKK?"
          }
        }
      }
    },
    "AdvancedSetting.asyncPreconvertMaxOutstandingBytes" : {
      "comment" : "Advanced setting: asyncPreconvertMaxOutstandingBytes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum bytes of outstanding async pre-conversions.\nWhen this limit is reached, new strings are converted synchronously on the mutation thread."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo de bytes de pré-conversões assíncronas pendentes.\nQuando este limite é atingido, novas strings são convertidas de forma síncrona na thread de mutação."
          }
        }
      }
    },
    "AdvancedSetting.asyncPreconvertMinStringLength" : {
      "comment" : "Advanced setting: asyncPreconvertMinStringLength",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum string length (in UTF-16 code units) to dispatch for async pre-conversion."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimento mínimo de string (em unidades de código UTF-16) para despachar para pré-conversão assíncrona."
          }
        }
      }
    },
    "AdvancedSetting.asyncPreconvertStrings" : {
      "comment" : "Advanced setting: asyncPreconvertStrings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pre-convert long non-ASCII strings on a background queue.\nThis decouples preconversion from the parser thread for better throughput."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-converter strings longas não-ASCII em uma fila em segundo plano.\nIsso desacopla a pré-conversão da thread do analisador para melhor taxa de transferência."
          }
        }
      }
    },
    "AdvancedSetting.autoLockSessionNameOnEdit" : {
      "comment" : "Advanced setting: autoLockSessionNameOnEdit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-lock session name after editing it."
