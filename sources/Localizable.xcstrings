    "SCPFile.HostIdentificationChanged" : {
      "comment" : "Warning shown when a host's key fingerprint has changed; first %@ is the key hash type, second %@ is the host, third %@ is the fingerprint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "REMOTE HOST IDENTIFICATION HAS CHANGED!\n\nThe %1$@ key fingerprint of host '%2$@' has changed. It is %3$@.\n\nSomeone could be eavesdropping on you right now (man-in-the-middle attack)!\nIt is also possible that a host key has just been changed.\nConnect anyway?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IDENTIFICAÇÃO DO HOST REMOTO MUDOU!\n\nA impressão digital da chave %1$@ do host “%2$@” mudou. Ela é %3$@.\n\nAlguém pode estar interceptando você neste momento (ataque man-in-the-middle)!\nTambém é possível que uma chave de host tenha acabado de ser alterada.\nConectar mesmo assim?"
          }
        }
      }
    },
