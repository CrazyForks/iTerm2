    "AIModelEditor.InvalidHeaderName" : {
      "comment" : "Validation error for an invalid custom HTTP header name; %@ is the name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom header name “%@” is not valid. Use only RFC 7230 token characters (letters, digits, and any of !#$%%&'*+-.^_`|~)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
