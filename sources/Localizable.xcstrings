        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus cabeçalhos HTTP personalizados de IA costumavam ser um único ajuste global. Eles ainda se aplicam ao seu modelo atual, mas adicionar ou editar modelos aqui não os transfere. Adicione novamente os cabeçalhos de que precisa na seção “Custom headers” de cada modelo."
          }
        }
      }
    },
