    "Tip.0116.Body" : {
      "comment" : "Tip of the day body, id 0116",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reposition the Tip of the Day window conveniently on your screen, as it is now draggable."
          }
