    "Tip.0064.Title" : {
      "comment" : "Tip of the day title, id 0064",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ASCII/Non-Ascii Fonts"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fontes ASCII/não ASCII"
          }
        }
      }
    },
    "Tip.0065.Body" : {
      "comment" : "Tip of the day body, id 0065",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A coprocess is a job, such as a shell script, that has a special relationship with a particular iTerm2 session. All output in a terminal window (that is, what you see on the screen) is also input to the coprocess. All output from the coprocess acts like text that the user is typing at the keyboard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um coprocesso é uma tarefa, como um shell script, que tem uma relação especial com uma sessão específica do iTerm2. Toda a saída em uma janela de terminal (ou seja, o que você vê na tela) também é entrada para o coprocesso. Toda a saída do coprocesso age como texto que o usuário está digitando no teclado."
          }
        }
      }
    },
    "Tip.0065.Title" : {
      "comment" : "Tip of the day title, id 0065",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Coprocesses"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coprocessos"
          }
        }
      }
    },
    "Tip.0066.Body" : {
      "comment" : "Tip of the day body, id 0066",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can customize the touch bar by selecting “View > Customize Touch Bar.” You can add a tab bar for full-screen mode, a user-customizable status button, and you can even define your own touch bar buttons in Settings > Keys. There’s also a new shell integration tool to customize touch bar function key labels."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode personalizar a Touch Bar selecionando “Visualizar > Personalizar Touch Bar”. Você pode adicionar uma barra de abas para o modo de tela cheia, um botão de status personalizável pelo usuário e até definir seus próprios botões da Touch Bar em Ajustes > Teclas. Há também uma nova ferramenta de Shell Integration para personalizar os rótulos das teclas de função da Touch Bar."
          }
        }
      }
    },
    "Tip.0066.Title" : {
      "comment" : "Tip of the day title, id 0066",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Touch Bar Customization"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalização da Touch Bar"
          }
        }
      }
    },
    "Tip.0067.Body" : {
      "comment" : "Tip of the day body, id 0067",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you use a font that supports ligatures, you can enable ligature support in Settings > Profiles > Text."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você usa uma fonte que suporta ligaduras, pode ativar o suporte a ligaduras em Ajustes > Perfis > Texto."
          }
        }
      }
    },
    "Tip.0067.Title" : {
      "comment" : "Tip of the day title, id 0067",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ligatures"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligaduras"
          }
        }
      }
    },
    "Tip.0068.Body" : {
      "comment" : "Tip of the day body, id 0068",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New in 3.1: You can configure your hotkey window to appear over other apps’ full screen windows. Turn on “Floating Window” in “Settings > Profiles > Keys > Customize Hotkey Window.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade na 3.1: você pode configurar sua janela de atalho para aparecer sobre as janelas de tela cheia de outros apps. Ative “Janela flutuante” em “Ajustes > Perfis > Teclas > Personalizar janela de atalho”."
          }
        }
      }
    },
    "Tip.0068.Title" : {
      "comment" : "Tip of the day title, id 0068",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating Hotkey Window"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janela de atalho flutuante"
          }
        }
      }
    },
    "Tip.0069.Body" : {
      "comment" : "Tip of the day body, id 0069",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New in 3.1: You can have multiple hotkey windows. Each profile can have one or more hotkeys."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade na 3.1: você pode ter várias janelas de atalho. Cada perfil pode ter uma ou mais teclas de atalho."
          }
        }
      }
    },
    "Tip.0069.Title" : {
      "comment" : "Tip of the day title, id 0069",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Multiple Hotkey Windows"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Várias janelas de atalho"
          }
        }
      }
    },
    "Tip.0070.Body" : {
      "comment" : "Tip of the day body, id 0070",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New in 3.1: You can configure a hotkey window to open on double-tap of a modifier in “Settings > Profiles > Keys > Customize Hotkey Window.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade na 3.1: você pode configurar uma janela de atalho para abrir ao tocar duas vezes em um modificador em “Ajustes > Perfis > Teclas > Personalizar janela de atalho”."
          }
        }
      }
    },
    "Tip.0070.Title" : {
      "comment" : "Tip of the day title, id 0070",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Double-Tap Hotkey"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atalho de toque duplo"
          }
        }
      }
    },
    "Tip.0071.Body" : {
      "comment" : "Tip of the day body, id 0071",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can “bury” a session with “Session > Bury Session.” It remains hidden until you restore it by selecting it from “Session > Buried Sessions > Your session.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode “enterrar” uma sessão com “Sessão > Enterrar sessão”. Ela permanece oculta até você restaurá-la selecionando-a em “Sessão > Sessões enterradas > Sua sessão”."
          }
        }
      }
    },
    "Tip.0071.Title" : {
      "comment" : "Tip of the day title, id 0071",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Buried Sessions"
