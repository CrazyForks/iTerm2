      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Variables to report via control sequence\nThis is a comma-delimited list of variables that can be reported with the OSC 1337 ReportVariable=name control sequence. Each variable name must be prefixed with “allow:” or “deny:”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variáveis a relatar via sequência de controle\nEsta é uma lista de variáveis delimitada por vírgulas que podem ser relatadas com a sequência de controle OSC 1337 ReportVariable=name. Cada nome de variável deve ter o prefixo “allow:” ou “deny:”."
          }
        }
      }
    },
    "AdvancedSetting.numberOfLinesForAccessibility" : {
      "comment" : "Advanced setting: numberOfLinesForAccessibility",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of lines of history to expose to Accessibility.\nAccessibility APIs can make iTerm2 slow. In order to limit the effect, you can restrict the number of lines in each session that are visible to accessibility. The last lines of each session will be made accessible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de linhas de histórico a expor à Acessibilidade.\nAs APIs de acessibilidade podem deixar o iTerm2 lento. Para limitar o efeito, você pode restringir o número de linhas em cada sessão que ficam visíveis para a acessibilidade. As últimas linhas de cada sessão serão tornadas acessíveis."
          }
        }
      }
    },
    "AdvancedSetting.onePasswordAccount" : {
      "comment" : "Advanced setting: onePasswordAccount",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1Password account name.\nThis is used if you’ve enabled the 1Password integration in the password manager. Use `op account list` to get the list of accounts. This can be an account shorthand, sign-in address, account ID, or user ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome da conta do 1Password.\nIsto é usado se você ativou a integração do 1Password no cofre de senhas. Use `op account list` para obter a lista de contas. Pode ser uma abreviação de conta, endereço de login, ID da conta ou ID do usuário."
          }
        }
      }
    },
    "AdvancedSetting.openFileInNewWindows" : {
      "comment" : "Advanced setting: openFileInNewWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DEPRECATED: Use “How should new instances be opened” instead.\nOpen files in new windows, not new tabs or split panes.\nThis affects shell scripts opened from Finder, for example. See also “Open files in split panes”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: Use “Como as novas instâncias devem ser abertas” em vez disso.\nAbrir arquivos em novas janelas, não em novas abas ou painéis divididos.\nIsto afeta scripts de shell abertos a partir do Finder, por exemplo. Consulte também “Abrir arquivos em painéis divididos”."
          }
        }
      }
    },
    "AdvancedSetting.openFileInSplitPanes" : {
      "comment" : "Advanced setting: openFileInSplitPanes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DEPRECATED: Use “How should new instances be opened” instead.\nOpen files in split panes.\nThis affects shell scripts opened from Finder, for example. You must set “Open files in new windows, not new tabs” to “No” for this to take effect. See also “When opening a file in a split pane, should it be a vertical split?”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: Use “Como as novas instâncias devem ser abertas” em vez disso.\nAbrir arquivos em painéis divididos.\nIsto afeta scripts de shell abertos a partir do Finder, por exemplo. Você precisa definir “Abrir arquivos em novas janelas, não em novas abas” como “Não” para que isto tenha efeito. Consulte também “Ao abrir um arquivo em um painel dividido, ele deve ser uma divisão vertical?”"
          }
        }
      }
    },
    "AdvancedSetting.openFileInVerticalSplitPane" : {
      "comment" : "Advanced setting: openFileInVerticalSplitPane",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DEPRECATED: Use “How should new instances be opened” instead.\nWhen opening a file in a split pane, should it be a vertical split?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: Use “Como as novas instâncias devem ser abertas” em vez disso.\nAo abrir um arquivo em um painel dividido, ele deve ser uma divisão vertical?"
          }
        }
      }
    },
    "AdvancedSetting.openFileOverridesSendText" : {
      "comment" : "Advanced setting: openFileOverridesSendText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should opening a script with iTerm2 disable the default profile's “Send Text at Start” setting?\nIf you use “open iTerm2 file.command” or drag a script onto iTerm2's icon and this setting is enabled then the script will be executed in lieu of the profile's “Send Text at Start” setting. If this setting is off then both will be executed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir um script com o iTerm2 deve desativar o ajuste “Enviar texto ao iniciar” do perfil padrão?\nSe você usar “open iTerm2 file.command” ou arrastar um script para o ícone do iTerm2 e este ajuste estiver ativado, o script será executado no lugar do ajuste “Enviar texto ao iniciar” do perfil. Se este ajuste estiver desativado, ambos serão executados."
          }
        }
      }
    },
    "AdvancedSetting.openNewWindowAtStartup" : {
      "comment" : "Advanced setting: openNewWindowAtStartup",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open a window at startup?\nThis is useful if you wish to use the system window restoration settings but not create a new window if none would be restored."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir uma janela na inicialização?\nIsto é útil se você deseja usar os ajustes de restauração de janelas do sistema, mas não criar uma nova janela se nenhuma for restaurada."
          }
        }
      }
    },
    "AdvancedSetting.openProfilesInNewWindow" : {
      "comment" : "Advanced setting: openProfilesInNewWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choosing a profile from the “Profiles” menu opens a new window.\nYou must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolher um perfil no menu “Perfis” abre uma nova janela.\nVocê precisa reiniciar o iTerm2 após alterar este ajuste para que ele tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.openQuicklyAnimationDuration" : {
      "comment" : "Advanced setting: openQuicklyAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Duration in seconds of the Open Quickly window height animation.\nSet to 0 to disable the animation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração em segundos da animação de altura da janela Abrir rapidamente.\nDefina como 0 para desativar a animação."
          }
        }
      }
    },
    "AdvancedSetting.openUntitledFile" : {
      "comment" : "Advanced setting: openUntitledFile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open a new window when you click the dock icon and no windows are already open, and also on app launch when no other windows are open?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir uma nova janela quando você clica no ícone do dock e nenhuma janela está aberta, e também ao iniciar o app quando nenhuma outra janela está aberta?"
          }
        }
      }
    },
    "AdvancedSetting.optimumTabWidth" : {
      "comment" : "Advanced setting: optimumTabWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Preferred tab width when tabs are equally sized."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura preferida da aba quando as abas têm o mesmo tamanho."
          }
        }
      }
    },
    "AdvancedSetting.oscColorReport16Bits" : {
      "comment" : "Advanced setting: oscColorReport16Bits",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Report 16-bit color values to OSC 4 and 10 through 19.\nWorks around a bug in older vim where they could not properly parse 8-bit values."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar valores de cor de 16 bits para OSC 4 e 10 a 19.\nContorna um bug em versões antigas do vim onde não conseguiam analisar corretamente valores de 8 bits."
          }
        }
      }
    },
    "AdvancedSetting.p3" : {
      "comment" : "Advanced setting: p3",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use P3 as default color space? If No, sRGB will be used."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar P3 como espaço de cor padrão? Se Não, será usado o sRGB."
          }
        }
      }
    },
    "AdvancedSetting.paneTitleBarBackgroundColor" : {
      "comment" : "Advanced setting: paneTitleBarBackgroundColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom background color for pane title bars. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor de fundo personalizada para as barras de título dos painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        }
      }
    },
    "AdvancedSetting.paneTitleBarTextColor" : {
      "comment" : "Advanced setting: paneTitleBarTextColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom text color for pane title bars. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor de texto personalizada para as barras de título dos painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        }
      }
    },
    "AdvancedSetting.pasteHistoryMaxOptions" : {
      "comment" : "Advanced setting: pasteHistoryMaxOptions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Number of entries to save in Paste History.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de entradas a salvar no Histórico de colagem.\n"
          }
        }
      }
    },
    "AdvancedSetting.pastingClearsSelection" : {
      "comment" : "Advanced setting: pastingClearsSelection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pasting text will remove the selection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colar texto removerá a seleção."
          }
        }
      }
    },
    "AdvancedSetting.pathToFTP" : {
      "comment" : "Advanced setting: pathToFTP",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Path to ftp for opening ftp: URLs.\nYou may want to set this to /usr/local/bin/ftp to use the Homebrew install."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminho para o ftp para abrir URLs ftp:.\nVocê pode querer definir isto como /usr/local/bin/ftp para usar a instalação do Homebrew."
          }
        }
      }
    },
    "AdvancedSetting.pathToTelnet" : {
      "comment" : "Advanced setting: pathToTelnet",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Path to telnet for opening telnet: URLs.\nYou may want to set this to /usr/local/bin/telnet to use the Homebrew install."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminho para o telnet para abrir URLs telnet:.\nVocê pode querer definir isto como /usr/local/bin/telnet para usar a instalação do Homebrew."
          }
        }
      }
    },
    "AdvancedSetting.pathsToIgnore" : {
      "comment" : "Advanced setting: pathsToIgnore",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paths to ignore for Semantic History.\nSeparate paths with a comma. Any file under one of these paths will not be openable with Semantic History. It is wise to add network file systems to this list, since they can be very slow."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhos a ignorar no Semantic History.\nSepare os caminhos com uma vírgula. Qualquer arquivo sob um destes caminhos não poderá ser aberto com o Semantic History. É recomendável adicionar sistemas de arquivos em rede a esta lista, pois eles podem ser muito lentos."
          }
        }
      }
    },
    "AdvancedSetting.performDictionaryLookupOnQuickLook" : {
      "comment" : "Advanced setting: performDictionaryLookupOnQuickLook",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Perform dictionary lookups on force press.\nIf this is NO, force press will still preview the Semantic History action; only dictionary lookups can be disabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realizar consultas de dicionário ao pressionar com força.\nSe for NÃO, o pressionar com força ainda mostrará a pré-visualização da ação do Semantic History; apenas as consultas de dicionário podem ser desativadas."
          }
        }
      }
    },
    "AdvancedSetting.performSQLiteIntegrityCheck" : {
      "comment" : "Advanced setting: performSQLiteIntegrityCheck",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Perform restorable state integrity checks?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realizar verificações de integridade do estado restaurável?"
          }
        }
      }
    },
    "AdvancedSetting.pinEditSession" : {
      "comment" : "Advanced setting: pinEditSession",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin Edit Session window to the session it originally edited.\nIf not set, it will affect the most recently active session."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixar a janela Editar sessão na sessão que ela editou originalmente.\nSe não estiver definido, afetará a sessão ativa mais recente."
          }
        }
      }
    },
    "AdvancedSetting.pinchToChangeFontSizeDisabled" : {
      "comment" : "Advanced setting: pinchToChangeFontSizeDisabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable changing font size in response to a pinch gesture."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar a alteração do tamanho da fonte em resposta a um gesto de pinça."
          }
        }
      }
    },
    "AdvancedSetting.pinnedTabWidth" : {
      "comment" : "Advanced setting: pinnedTabWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Width of pinned tabs in pixels."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura das abas fixadas em pixels."
          }
        }
      }
    },
    "AdvancedSetting.placeTabsInTitlebarAccessoryInFullScreen" : {
      "comment" : "Advanced setting: placeTabsInTitlebarAccessoryInFullScreen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Place the tabbar in the window's titlebar in full screen mode (macOS 13+ only)?\nThis can be disabled to work around a bug in macOS where tabs may not be visible in full screen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocar a barra de abas na barra de título da janela no modo de tela cheia (somente macOS 13+)?\nIsto pode ser desativado para contornar um bug no macOS onde as abas podem não ficar visíveis em tela cheia."
          }
        }
      }
    },
    "AdvancedSetting.pollForTmuxForegroundJob" : {
      "comment" : "Advanced setting: pollForTmuxForegroundJob",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Poll for foreground job name in tmux integration with tmux < 3.2?\nThis enables tab icons but can cause a lot of background traffic. This has no effect in tmux 3.2 and later, where polling is unnecessary."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultar periodicamente o nome do processo em primeiro plano na integração do tmux com tmux < 3.2?\nIsto ativa os ícones das abas, mas pode causar muito tráfego em segundo plano. Isto não tem efeito no tmux 3.2 e posterior, onde a consulta periódica é desnecessária."
          }
        }
      }
    },
    "AdvancedSetting.postFakeFlagsChangedEvents" : {
      "comment" : "Advanced setting: postFakeFlagsChangedEvents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Post fake flags-changed events when remapping modifiers with an event tap.\nThis is an attempt to work around incompatibilities with AltTab in issue 10220."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicar eventos falsos de alteração de flags ao remapear modificadores com um event tap.\nEsta é uma tentativa de contornar incompatibilidades com o AltTab no problema 10220."
          }
        }
      }
    },
    "AdvancedSetting.preconvertStringsOnParserThread" : {
      "comment" : "Advanced setting: preconvertStringsOnParserThread",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pre-convert non-ASCII strings to screen characters on the parser thread.\nThis exploits parallelism between parsing and screen mutation for better performance."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-converter strings não ASCII em caracteres de tela na thread do analisador.\nIsto aproveita o paralelismo entre a análise e a mutação da tela para melhor desempenho."
          }
        }
      }
    },
    "AdvancedSetting.preferSpeedToFullLigatureSupport" : {
      "comment" : "Advanced setting: preferSpeedToFullLigatureSupport",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Improves drawing performance at the expense of disallowing alphanumeric characters to belong to ligatures."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhora o desempenho de desenho ao custo de não permitir que caracteres alfanuméricos pertençam a ligaduras."
          }
        }
      }
    },
    "AdvancedSetting.preferredBaseDir" : {
      "comment" : "Advanced setting: preferredBaseDir",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Folder for config files. There must not be a space in the path.\nIf empty, then ~/.config/iterm2 will be the default location."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta para arquivos de configuração. Não deve haver espaço no caminho.\nSe vazio, ~/.config/iterm2 será o local padrão."
          }
        }
      }
    },
    "AdvancedSetting.preserveFontSizeOnAutomaticProfileSwitch" : {
      "comment" : "Advanced setting: preserveFontSizeOnAutomaticProfileSwitch",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Preserve font zoom level when Automatic Profile Switching changes profiles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preservar o nível de zoom da fonte quando a Troca automática de perfil muda de perfil."
          }
        }
      }
    },
    "AdvancedSetting.preventEscapeSequenceFromChangingProfile" : {
      "comment" : "Advanced setting: preventEscapeSequenceFromChangingProfile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevent control sequences from changing the current profile?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedir que sequências de controle alterem o perfil atual?"
          }
        }
      }
    },
    "AdvancedSetting.preventEscapeSequenceFromClearingHistory" : {
      "comment" : "Advanced setting: preventEscapeSequenceFromClearingHistory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevent CSI 3 J from clearing scrollback history?\nThis is also known as the terminfo E3 capability."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedir que CSI 3 J limpe o histórico de rolagem?\nIsto também é conhecido como a capacidade E3 do terminfo."
          }
        }
      }
    },
    "AdvancedSetting.preventSleepOnBatteryToo" : {
      "comment" : "Advanced setting: preventSleepOnBatteryToo",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevent system idle sleep on battery too, for profiles with “Prevent sleep” enabled?\nBy default the “Prevent sleep” profile setting only prevents idle sleep while connected to power. Enable this to also prevent idle sleep on battery."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedir o modo de repouso ocioso do sistema também na bateria, para perfis com “Impedir repouso” ativado?\nPor padrão, o ajuste de perfil “Impedir repouso” só impede o repouso ocioso enquanto conectado à energia. Ative isto para impedir o repouso ocioso também na bateria."
          }
        }
      }
    },
    "AdvancedSetting.prioritizeSmartSelectionActions" : {
      "comment" : "Advanced setting: prioritizeSmartSelectionActions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check smart selection actions before existing files on cmd-click?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificar as ações de seleção inteligente antes dos arquivos existentes ao clicar com cmd?"
          }
        }
      }
    },
    "AdvancedSetting.profilesWindowJoinsActiveSpace" : {
      "comment" : "Advanced setting: profilesWindowJoinsActiveSpace",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If the Profiles window is open, it always moves to join the active Space.\nYou must restart iTerm2 for a change in this setting to take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a janela Perfis estiver aberta, ela sempre se move para o Space ativo.\nVocê precisa reiniciar o iTerm2 para que uma alteração neste ajuste tenha efeito."
          }
        }
      }
    },
    "AdvancedSetting.promptForPasteWhenNotAtPrompt" : {
      "comment" : "Advanced setting: promptForPasteWhenNotAtPrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
