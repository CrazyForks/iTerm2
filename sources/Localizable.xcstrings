    "Tip.0074.Body" : {
      "comment" : "Tip of the day body, id 0074",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try the “Minimal” and “Compact” themes to reduce visual clutter. You can set it in “Settings > Appearance > General.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente os temas “Minimalista” e “Compacto” para reduzir a poluição visual. Você pode defini-los em “Ajustes > Aparência > Geral”."
          }
        }
      }
    },
    "Tip.0074.Title" : {
      "comment" : "Tip of the day title, id 0074",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
