      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install the Claude Code workgroup, which groups your main Claude session with two peer sessions: a diff viewer and a code-review session. You can switch between them with one click.\n\nYou can customize this layout later in Settings > Shortcuts > Workgroups."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o workgroup do Claude Code, que agrupa sua sessão principal do Claude com duas sessões pares: um visualizador de diferenças e uma sessão de revisão de código. Você pode alternar entre elas com um clique.\n\nVocê pode personalizar este layout mais tarde em Ajustes > Atalhos > Workgroups."
          }
