    "ClaudeCodeOnboarding.InstallTriggersBody" : {
      "comment" : "Body of the alert asking which profiles to add auto-enter triggers to",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pick the profiles you’ll run claude in. We’ll add Enter/Exit Workgroup triggers to each one so the Claude Code workgroup is entered automatically."
          }
