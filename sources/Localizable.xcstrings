            "value" : "Títulos de sessão"
          }
        }
      }
    },
    "Tip.0077.Body" : {
      "comment" : "Tip of the day body, id 0077",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tabs can show an icon indicating the current application. Configure it in “Settings > Profiles > General > Icon.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As abas podem exibir um ícone indicando o aplicativo atual. Configure isso em “Ajustes > Perfis > Geral > Ícone”."
          }
        }
      }
    },
    "Tip.0077.Title" : {
      "comment" : "Tip of the day title, id 0077",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tab Icons"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ícones de aba"
          }
        }
      }
    },
    "Tip.0078.Body" : {
      "comment" : "Tip of the day body, id 0078",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⌥ while dragging a tab to move the window. This is useful in the Compact and Minimal themes, which have a very small area for dragging the window."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⌥ pressionado ao arrastar uma aba para mover a janela. Isso é útil nos temas Compacto e Minimalista, que têm uma área muito pequena para arrastar a janela."
          }
        }
      }
    },
    "Tip.0078.Title" : {
      "comment" : "Tip of the day title, id 0078",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag Window by Tab"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastar janela pela aba"
          }
        }
      }
    },
    "Tip.0079.Body" : {
      "comment" : "Tip of the day body, id 0079",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press ⇧⌘. to open the Composer. It gives you a scratchpad to edit a command before sending it to the shell."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⇧⌘. para abrir o Compositor. Ele oferece um rascunho para editar um comando antes de enviá-lo ao shell."
          }
        }
      }
    },
    "Tip.0079.Title" : {
      "comment" : "Tip of the day title, id 0079",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Composer"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compositor"
          }
        }
      }
    },
    "Tip.0080.Body" : {
      "comment" : "Tip of the day body, id 0080",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you install Shell Integration on a machine you ssh to, you can drag-drop from Finder into the remote host by holding ⌥ while dragging. The destination directory is determined by where you drop the file in the terminal window: run cd foo, then drop the file below the cd command, and the file will go into the foo directory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você instalar o Shell Integration em uma máquina à qual se conecta via ssh, poderá arrastar e soltar do Finder para o host remoto mantendo ⌥ pressionado ao arrastar. O diretório de destino é determinado por onde você solta o arquivo na janela do terminal: execute cd foo, solte o arquivo abaixo do comando cd, e o arquivo irá para o diretório foo."
          }
        }
      }
    },
    "Tip.0080.Title" : {
      "comment" : "Tip of the day title, id 0080",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shell Integration: Uploads"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell Integration: envios"
          }
        }
      }
    },
    "Tip.0081.Body" : {
      "comment" : "Tip of the day body, id 0081",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The composer supports multiple cursors. It also has the ability to send just one command out of a list, making it easy to walk through a list of commands one-by-one. Click the help button in the composer for details."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Compositor suporta múltiplos cursores. Ele também é capaz de enviar apenas um comando de uma lista, facilitando percorrer uma lista de comandos um a um. Clique no botão de ajuda no Compositor para mais detalhes."
          }
        }
      }
    },
    "Tip.0081.Title" : {
      "comment" : "Tip of the day title, id 0081",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Composer Power Features"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recursos avançados do Compositor"
          }
        }
      }
    },
    "Tip.0082.Body" : {
      "comment" : "Tip of the day body, id 0082",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Transform selected text into a prettified, syntax-highlighted view with the “Render Selection” command, ideal for JSON, Markdown, or source code. This feature includes horizontal scrolling for easy log navigation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme o texto selecionado em uma visualização formatada e com destaque de sintaxe usando o comando “Renderizar seleção”, ideal para JSON, Markdown ou código-fonte. Esse recurso inclui rolagem horizontal para facilitar a navegação em logs."
          }
        }
      }
    },
    "Tip.0082.Title" : {
      "comment" : "Tip of the day title, id 0082",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Render Selection"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderizar seleção"
          }
        }
      }
    },
    "Tip.0083.Body" : {
      "comment" : "Tip of the day body, id 0083",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Export environment variables and copy files to remote hosts seamlessly with SSH integration. Either configure a profile to use ssh or use it2ssh in place of ssh."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte variáveis de ambiente e copie arquivos para hosts remotos de forma integrada com o SSH Integration. Configure um perfil para usar ssh ou use it2ssh no lugar de ssh."
          }
        }
      }
    },
    "Tip.0083.Title" : {
      "comment" : "Tip of the day title, id 0083",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SSH Integration"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH Integration"
          }
        }
      }
    },
    "Tip.0084.Body" : {
      "comment" : "Tip of the day body, id 0084",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Improve your command line with the “auto composer”, which replaces the command line with a native control for ease of use. Requires shell integration."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprimore sua linha de comando com o “auto compositor”, que substitui a linha de comando por um controle nativo para facilitar o uso. Requer o Shell Integration."
          }
        }
      }
    },
    "Tip.0084.Title" : {
      "comment" : "Tip of the day title, id 0084",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto Composer"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Compositor"
          }
        }
      }
    },
    "Tip.0085.Body" : {
      "comment" : "Tip of the day body, id 0085",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Generate commands using AI by entering a prompt in the composer and selecting “Edit > Engage Artificial Intelligence”. An OpenAI API key is required for this functionality."
          }
        },
        "pt-BR" : {
